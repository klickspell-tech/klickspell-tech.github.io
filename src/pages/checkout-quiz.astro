---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';

const canonical = "https://klickspell.com/checkout-quiz";

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Shopify Checkout Recommender — GoKwik vs Razorpay vs Cashfree",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "description": "A 5-question quiz that recommends GoKwik Kwik Checkout, Razorpay Magic Checkout, or Cashfree Checkout 360 for an Indian Shopify store based on COD mix, AOV, order volume, and priorities.",
  "url": canonical,
  "provider": {
    "@type": "Organization",
    "name": "Klickspell",
    "url": "https://klickspell.com/"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://klickspell.com/checkout-quiz" },
    { "@type": "ListItem", "position": 3, "name": "Checkout Recommender", "item": canonical }
  ]
};

const schemas = [webAppSchema, breadcrumbSchema];
---

<BaseLayout
  title="GoKwik vs Razorpay vs Cashfree — Which Checkout Fits Your Store? | Klickspell"
  description="Answer 5 quick questions about your COD mix, AOV, and order volume — get an instant recommendation between GoKwik Kwik Checkout, Razorpay Magic Checkout, and Cashfree Checkout 360."
  canonical={canonical}
  ogImage="https://klickspell.com/assets/og-card.png"
  schema={schemas}
>
  <Nav />

  <main id="main-content">
    <header class="service-page-hero" style="padding-bottom: 1.5rem;">
      <p class="cs-breadcrumb reveal"><a href="/">Home</a> / Tools / Checkout Recommender</p>

      <div class="service-badge reveal">
        <span class="service-badge-dot"></span>
        2-Minute Quiz · Instant Recommendation
      </div>

      <h1 class="service-hero-title reveal reveal-delay-1">
        Which checkout should<br>
        <em>your store actually use?</em>
      </h1>

      <p class="service-hero-sub reveal reveal-delay-2" style="max-width: 680px;">
        GoKwik, Razorpay Magic Checkout, and Cashfree Checkout 360 all claim similar numbers. The right one depends on your COD mix, order value, and what you actually need — answer 5 quick questions and we'll tell you which, with reasons, not just a vendor logo.
      </p>
    </header>

    <div class="section" style="padding-top: 1rem; padding-bottom: 5rem;">
      <div class="quote-layout reveal">

        <!-- LEFT: QUESTIONS -->
        <div class="quote-main-col">
          <form id="quizForm" novalidate>

            <div class="quote-card">
              <div class="quote-card-header">
                <div class="quote-card-eyebrow">
                  <span class="step-tag">Q1</span>
                  <span>Order Mix</span>
                </div>
                <h2 class="quote-card-title">What share of your orders are COD?</h2>
              </div>
              <div class="quote-pill-options" role="radiogroup" aria-label="COD share">
                <label class="quote-pill-label">
                  <input type="radio" name="cod_share" value="high" />
                  <span class="quote-pill-ui">🟠 Mostly COD (70%+)</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="cod_share" value="mixed" checked />
                  <span class="quote-pill-ui">🔵 Mixed (30–70%)</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="cod_share" value="low" />
                  <span class="quote-pill-ui">🟢 Mostly Prepaid (&lt;30% COD)</span>
                </label>
              </div>
            </div>

            <div class="quote-card">
              <div class="quote-card-header">
                <div class="quote-card-eyebrow">
                  <span class="step-tag">Q2</span>
                  <span>Average Order Value</span>
                </div>
                <h2 class="quote-card-title">What's your typical AOV?</h2>
              </div>
              <div class="quote-pill-options" role="radiogroup" aria-label="Average order value">
                <label class="quote-pill-label">
                  <input type="radio" name="aov" value="low" />
                  <span class="quote-pill-ui">Under ₹1,500</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="aov" value="mid" checked />
                  <span class="quote-pill-ui">₹1,500 – ₹3,000</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="aov" value="high" />
                  <span class="quote-pill-ui">Above ₹3,000</span>
                </label>
              </div>
            </div>

            <div class="quote-card">
              <div class="quote-card-header">
                <div class="quote-card-eyebrow">
                  <span class="step-tag">Q3</span>
                  <span>Order Volume</span>
                </div>
                <h2 class="quote-card-title">Roughly how many orders a month?</h2>
              </div>
              <div class="quote-pill-options" role="radiogroup" aria-label="Monthly order volume">
                <label class="quote-pill-label">
                  <input type="radio" name="volume" value="low" />
                  <span class="quote-pill-ui">Under 500</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="volume" value="mid" checked />
                  <span class="quote-pill-ui">500 – 5,000</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="volume" value="high" />
                  <span class="quote-pill-ui">5,000+</span>
                </label>
              </div>
            </div>

            <div class="quote-card">
              <div class="quote-card-header">
                <div class="quote-card-eyebrow">
                  <span class="step-tag">Q4</span>
                  <span>Priority</span>
                </div>
                <h2 class="quote-card-title">What matters most right now?</h2>
              </div>
              <div class="quote-pill-options" role="radiogroup" aria-label="Top priority">
                <label class="quote-pill-label">
                  <input type="radio" name="priority" value="cost" />
                  <span class="quote-pill-ui">💰 Lowest, transparent pricing</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="priority" value="rto" checked />
                  <span class="quote-pill-ui">🛡️ Deepest RTO prevention</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="priority" value="engagement" />
                  <span class="quote-pill-ui">💬 Bundled WhatsApp/AI support</span>
                </label>
              </div>
            </div>

            <div class="quote-card">
              <div class="quote-card-header">
                <div class="quote-card-eyebrow">
                  <span class="step-tag">Q5</span>
                  <span>Current Setup (optional)</span>
                </div>
                <h2 class="quote-card-title">Which payment gateway do you use today?</h2>
                <p class="quote-card-sub">Doesn't affect your score below — we treat switching gateways as a solved problem, not a reason to pick a worse fit. This just helps us prep for your call if you book one.</p>
              </div>
              <div class="quote-pill-options" role="radiogroup" aria-label="Existing payment gateway">
                <label class="quote-pill-label">
                  <input type="radio" name="existing_gateway" value="razorpay" />
                  <span class="quote-pill-ui">Razorpay</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="existing_gateway" value="cashfree" />
                  <span class="quote-pill-ui">Cashfree</span>
                </label>
                <label class="quote-pill-label">
                  <input type="radio" name="existing_gateway" value="other" checked />
                  <span class="quote-pill-ui">Another / Not sure yet</span>
                </label>
              </div>
            </div>

          </form>
        </div>

        <!-- RIGHT: STICKY LIVE RESULT -->
        <div class="quote-sidebar-col">
          <div class="estimator-results-card">
            <span class="estimator-results-badge">Live Recommendation</span>
            <h2 class="estimator-results-title" id="quizResultTitle">Calculating…</h2>
            <p class="estimator-results-sub" id="quizResultSub">Answer the questions on the left to see your recommendation update live.</p>

            <div class="estimator-meters">
              <div class="estimator-meter-item" id="rowGokwik">
                <span class="estimator-meter-label" id="labelGokwik">GoKwik Kwik Checkout:</span>
                <span class="estimator-meter-val" id="scoreGokwik">0%</span>
              </div>
              <div class="estimator-meter-item" id="rowRazorpay">
                <span class="estimator-meter-label" id="labelRazorpay">Razorpay Magic Checkout:</span>
                <span class="estimator-meter-val" id="scoreRazorpay">0%</span>
              </div>
              <div class="estimator-meter-item" id="rowCashfree">
                <span class="estimator-meter-label" id="labelCashfree">Cashfree Checkout 360:</span>
                <span class="estimator-meter-val" id="scoreCashfree">0%</span>
              </div>
            </div>

            <div class="estimator-penalty-box" id="quizReasonsBox">
              💡 Your reasons will appear here as you answer.
            </div>

            <a id="quizReadMoreLink" href="/blog/gokwik-vs-razorpay-magic-checkout-shopify-india" class="btn-ghost" style="margin-bottom: .75rem;">
              Read the full comparison →
            </a>

            <a href="/gokwik-product-quiz" class="btn-ghost" style="margin-bottom: .75rem;">
              Already on GoKwik? See which of their 10 products fit →
            </a>

            <a
              href="https://cal.com/atul-bhatt-klickspell/30min"
              data-cal-link="atul-bhatt-klickspell/30min"
              data-cal-namespace="30min"
              data-cal-config='{"layout":"month_view"}'
              class="btn-primary"
              style="cursor:pointer"
            >
              Book Free 20-Min Call →
            </a>
            <a
              href="https://wa.me/919259598769"
              target="_blank"
              rel="noopener"
              class="btn-ghost"
              style="display:inline-flex; align-items:center; justify-content:center; gap:8px;"
            >
              <WhatsAppIcon size={17} fill="#25D366" />
              <span>Discuss on WhatsApp</span>
            </a>

            <p style="font-size:11.5px; color:rgba(255,255,255,0.5); text-align:center; margin-top:1.25rem; line-height:1.5;">
              A recommendation, not a verdict — we'll validate against your real order data on a call before you commit to anything.
            </p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />

  <script is:inline>
    (function() {
      // Points each answer contributes per platform. Only positive/negative
      // signal worth showing is listed here - omitted = 0 contribution.
      const SCORES = {
        cod_share: {
          high:  { gokwik: 3, cashfree: 1 },
          mixed: { gokwik: 1, razorpay: 1, cashfree: 1 },
          // GoKwik's core differentiator (RTO/COD network data) genuinely
          // matters less below 30% COD - that part is defensible. Giving
          // Razorpay a bigger bonus than Cashfree here isn't: we have no
          // verified evidence either processes prepaid payments better
          // than the other, so both get the same small nudge.
          low:   { razorpay: 1, cashfree: 1 }
        },
        aov: {
          low:  { gokwik: 2 },
          mid:  { gokwik: 1, razorpay: 1, cashfree: 1 },
          high: { razorpay: 2 }
        },
        volume: {
          // GoKwik's published Emerging Plan rate (₹3,000/mo + 3.5% COD fee)
          // specifically covers 0-2,000 orders/month - a standing published
          // rate for the checkout product itself. Cashfree's Checkout 360
          // appears bundled into its flat 1.95% standing gateway rate, no
          // order-count cap. Razorpay's base gateway rate (2%, or a current
          // time-limited 0%-for-90-days promo under Rs5L/mo) is published
          // too, but Magic Checkout's own incremental fee stays unpublished
          // regardless of volume or promo - so no penalty (it's not worse
          // than before), but no credit either, since the actual checkout
          // product being compared here is still opaque either way.
          low:  { cashfree: 1, gokwik: 1 },
          mid:  { gokwik: 1, razorpay: 1, cashfree: 1 },
          high: { gokwik: 1, razorpay: 1 }
        },
        priority: {
          // Cashfree's flat 1.95% standard rate has no order-count ceiling,
          // which still makes it the simplest of the three to compare at any
          // volume. GoKwik now also publishes a real entry-tier rate (capped
          // at 2,000 orders/month), so it gets real but smaller credit here -
          // it's no longer accurate to say Cashfree is the only one with
          // public pricing. Razorpay's base gateway rate is published (plus
          // a time-limited promo), but Magic Checkout's own incremental fee
          // - the actual product being compared - still isn't, regardless.
          cost:       { cashfree: 3, gokwik: 1 },
          rto:        { gokwik: 3 },
          engagement: { gokwik: 3 }
        }
        // existing_gateway is intentionally NOT scored - which platform you
        // already use isn't a capability difference, it's inertia. We treat
        // switching as a solved problem (that's literally our job), so
        // weighting "already on X" would recommend familiarity over fit.
      };

      // One explanation per (question, answer), describing the FULL effect on
      // scoring - every platform it helps, hurts, or leaves neutral, with why.
      // Shown for every answered question regardless of which platform ends up
      // winning overall, so the sidebar explains how the whole score was built,
      // not just a cherry-picked bullet naming the winner.
      const REASONS = {
        cod_share: {
          high:  "Mostly-COD (70%+): GoKwik's RTO-prevention network is built specifically for this, and Cashfree's AI RTO prediction also gets stronger signal from COD volume — GoKwik gets the bigger credit since COD/RTO is its core specialty, Cashfree a smaller one.",
          mixed: "Mixed COD/prepaid (30–70%): no platform has a clear edge at this mix, so all three get an equal small nudge.",
          low:   "Mostly-prepaid (&lt;30% COD): GoKwik's COD-specific RTO tooling has less to work with here. We found no verified evidence either Razorpay or Cashfree handles prepaid orders better than the other, so both get the same small nudge instead of favoring one."
        },
        aov: {
          low:  "AOV under ₹1,500: this is GoKwik's own published best-fit segment (lower-AOV, COD-heavy brands), so it gets credit here.",
          mid:  "AOV ₹1,500–3,000: no platform has a clear edge at this AOV, so all three get an equal small nudge.",
          high: "AOV above ₹3,000: Razorpay gets credit here for its RTO Protection reimbursement backstop — the rupee value at risk per failed delivery is higher, so a reimbursement product matters more."
        },
        volume: {
          low:  "Under 500 orders/month: GoKwik's Emerging Plan is a standing published rate built for 0–2,000 orders/month, and Cashfree's flat 1.95% standing rate applies with no order-count cap — both get credit. Razorpay's base gateway rate is published too (plus a current time-limited 0%-for-90-days promo under ₹5L/month), but Magic Checkout's own incremental fee — the actual product being compared here — stays unpublished regardless of volume, so it gets neither a penalty nor credit.",
          mid:  "500–5,000 orders/month: no platform has a clear edge at this volume, so all three get an equal small nudge.",
          high: "5,000+ orders/month: GoKwik and Razorpay both get a small nudge here; we don't have an independently-verified reason to favor Cashfree specifically at this scale."
        },
        priority: {
          cost:       "You prioritized pricing transparency: Cashfree's flat 1.95% standard rate has no order-count ceiling, the simplest of the three to compare, so it gets the most credit. GoKwik now also publishes a real entry-tier rate (capped at 2,000 orders/month), so it gets some credit too. Razorpay's base gateway rate is published (plus a time-limited new-merchant promo), but Magic Checkout's own incremental fee — the actual checkout product — still isn't, so it gets none here.",
          rto:        "You prioritized RTO prevention: GoKwik's network has the deepest RTO-specific data of the three against what we could independently verify, so it gets the strongest credit here.",
          engagement: "You prioritized bundled engagement/support: only GoKwik bundles this natively (Kwik Engage) — Razorpay and Cashfree are payments-first, not marketing platforms, so GoKwik gets full credit and the other two get none."
        }
      };

      const PLATFORM_META = {
        gokwik:   { name: "GoKwik Kwik Checkout", short: "GoKwik" },
        razorpay: { name: "Razorpay Magic Checkout", short: "Razorpay" },
        cashfree: { name: "Cashfree Checkout 360", short: "Cashfree" }
      };

      // Which comparison post to point to, keyed by the two closest platforms
      // (order-independent) so a Razorpay/Cashfree near-tie links the actual
      // Razorpay-vs-Cashfree post instead of defaulting to a GoKwik pairing.
      const PAIR_LINKS = {
        'gokwik,razorpay': { href: '/blog/gokwik-vs-razorpay-magic-checkout-shopify-india', label: 'GoKwik vs Razorpay' },
        'cashfree,gokwik': { href: '/blog/gokwik-vs-cashfree-checkout-360-shopify-india', label: 'GoKwik vs Cashfree' },
        'cashfree,razorpay': { href: '/blog/razorpay-magic-checkout-vs-cashfree-checkout-360', label: 'Razorpay vs Cashfree' }
      };
      const PILLAR_LINK = { href: '/blog/gokwik-vs-razorpay-vs-cashfree-checkout-comparison', label: 'the full 3-way comparison' };

      const form = document.getElementById('quizForm');
      const titleEl = document.getElementById('quizResultTitle');
      const subEl = document.getElementById('quizResultSub');
      const reasonsBox = document.getElementById('quizReasonsBox');
      const readMoreLink = document.getElementById('quizReadMoreLink');
      const meterEls = { gokwik: document.getElementById('scoreGokwik'), razorpay: document.getElementById('scoreRazorpay'), cashfree: document.getElementById('scoreCashfree') };
      const rowEls = { gokwik: document.getElementById('rowGokwik'), razorpay: document.getElementById('rowRazorpay'), cashfree: document.getElementById('rowCashfree') };
      const labelEls = { gokwik: document.getElementById('labelGokwik'), razorpay: document.getElementById('labelRazorpay'), cashfree: document.getElementById('labelCashfree') };

      function getAnswers() {
        const answers = {};
        ['cod_share', 'aov', 'volume', 'priority', 'existing_gateway'].forEach((name) => {
          const checked = form.querySelector(`input[name="${name}"]:checked`);
          answers[name] = checked ? checked.value : null;
        });
        return answers;
      }

      function compute() {
        const answers = getAnswers();
        const totals = { gokwik: 0, razorpay: 0, cashfree: 0 };

        Object.keys(SCORES).forEach((question) => {
          const answer = answers[question];
          if (!answer || !SCORES[question][answer]) return;
          const contrib = SCORES[question][answer];
          Object.keys(contrib).forEach((platform) => {
            totals[platform] += contrib[platform];
          });
        });

        // Floor at 0 for display purposes (volume penalties can go negative).
        const display = {
          gokwik: Math.max(0, totals.gokwik),
          razorpay: Math.max(0, totals.razorpay),
          cashfree: Math.max(0, totals.cashfree)
        };
        const sum = display.gokwik + display.razorpay + display.cashfree || 1;

        Object.keys(display).forEach((platform) => {
          const pct = Math.round((display[platform] / sum) * 100);
          meterEls[platform].textContent = pct + '%';
        });

        // Rank by raw totals (not the floored display values) so a tie is
        // detected correctly even if someone's totals went negative.
        const ranked = Object.keys(totals).sort((a, b) => totals[b] - totals[a]);
        const winner = ranked[0];
        const runnerUp = ranked[1];
        const gap = totals[winner] - totals[runnerUp];
        // Scores here are small integers (roughly 0-10) built from 4
        // questions worth 1-3 points each, so a gap of 1 or less is a
        // genuine near-tie, not just "slightly ahead."
        const isClose = gap <= 1;

        // Highlight the winning row (or both top rows, if it's a near-tie -
        // highlighting only one would misrepresent a coin-flip as a clear
        // pick) so the winner is visually obvious, not just a bigger number
        // in an otherwise-identical list.
        const highlighted = isClose ? [winner, runnerUp] : [winner];
        Object.keys(rowEls).forEach((platform) => {
          const isHighlighted = highlighted.includes(platform);
          rowEls[platform].style.background = isHighlighted ? 'rgba(74,222,128,0.1)' : 'transparent';
          rowEls[platform].style.borderRadius = isHighlighted ? '8px' : '0';
          rowEls[platform].style.padding = isHighlighted ? '0.4rem 0.6rem' : '0';
          rowEls[platform].style.margin = isHighlighted ? '0 -0.6rem' : '0';
          labelEls[platform].style.color = isHighlighted ? '#fff' : 'rgba(255,255,255,0.75)';
          labelEls[platform].style.fontWeight = isHighlighted ? '600' : '500';
          meterEls[platform].style.color = isHighlighted ? '#4ADE80' : '#fff';
        });

        // Show the full reasoning for every answered question, not just the
        // bullets that happen to name the winner - this is what explains HOW
        // a close score (or an exact tie) actually got built. But not every
        // question is equally informative: some answers nudge all three
        // platforms by the same amount (a wash), while others are what
        // actually separated the winner from the rest. Classify each so the
        // real deciding factor doesn't get lost next to three "no edge"
        // bullets with identical visual weight.
        const keyReasons = [];
        const neutralReasons = [];
        Object.keys(SCORES).forEach((question) => {
          const answer = answers[question];
          const reasonText = REASONS[question] && REASONS[question][answer];
          if (!reasonText) return;
          const contrib = SCORES[question][answer] || {};
          const vals = { gokwik: contrib.gokwik || 0, razorpay: contrib.razorpay || 0, cashfree: contrib.cashfree || 0 };
          const allEqual = vals.gokwik === vals.razorpay && vals.razorpay === vals.cashfree;
          const maxVal = Math.max(vals.gokwik, vals.razorpay, vals.cashfree);
          const favoredWinner = !allEqual && vals[winner] === maxVal;
          if (favoredWinner) keyReasons.push(reasonText);
          else neutralReasons.push(reasonText);
        });

        const meta = PLATFORM_META[winner];
        const runnerMeta = PLATFORM_META[runnerUp];

        if (isClose) {
          titleEl.textContent = `${meta.short} or ${runnerMeta.short} — too close to call`;
          subEl.textContent = `Your answers score these two almost identically (${gap === 0 ? 'an exact tie' : 'within a point'}) — worth reading both comparisons rather than treating either as a clear winner.`;
          const pairKey = [winner, runnerUp].sort().join(',');
          const link = PAIR_LINKS[pairKey] || PILLAR_LINK;
          readMoreLink.href = link.href;
          readMoreLink.textContent = `Read ${link.label} →`;
        } else {
          titleEl.textContent = meta.name;
          subEl.textContent = "Based on your answers, this is the strongest fit for your store right now.";
          const pairKey = [winner, runnerUp].sort().join(',');
          const link = PAIR_LINKS[pairKey] || PILLAR_LINK;
          readMoreLink.href = link.href;
          readMoreLink.textContent = `Read ${link.label} →`;
        }

        const LIST_STYLE = 'margin:0.6rem 0 0; padding-left:1.1rem; display:flex; flex-direction:column; gap:0.55rem; line-height:1.55;';

        if (keyReasons.length > 0 || neutralReasons.length > 0) {
          let html = '';
          if (keyReasons.length > 0) {
            html += '💡 <strong style="color:#8FA8FF;">What actually decided this:</strong>'
              + `<ul style="${LIST_STYLE}">` + keyReasons.map((r) => `<li>${r}</li>`).join('') + '</ul>';
          } else {
            html += `💡 Nothing you answered strongly favored one platform — it's a reasonable, balanced default rather than a decisive fit.`;
          }
          if (neutralReasons.length > 0) {
            html += '<div style="margin-top:0.85rem; padding-top:0.7rem; border-top:1px solid rgba(255,255,255,0.12); font-size:11.5px; opacity:0.7;">'
              + '<strong style="color:rgba(255,255,255,0.85);">Also considered (no clear edge either way):</strong>'
              + `<ul style="${LIST_STYLE}">` + neutralReasons.map((r) => `<li>${r}</li>`).join('') + '</ul>'
              + '</div>';
          }
          reasonsBox.innerHTML = html;
        } else {
          reasonsBox.innerHTML = `💡 ${meta.name} is a reasonable, balanced default for your answers so far.`;
        }
      }

      form.addEventListener('change', compute);
      compute();
    })();
  </script>
</BaseLayout>
