---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const careerStartDate = new Date('2020-06-01');
const now = new Date();
let yearsExperience = now.getFullYear() - careerStartDate.getFullYear();
const monthDiff = now.getMonth() - careerStartDate.getMonth();
if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < careerStartDate.getDate())) {
  yearsExperience--;
}

const expertise = [
  "Shopify Development",
  "Headless Commerce",
  "Webflow",
  "Frappe / ERPNext",
  "Web Performance",
  "DevOps",
  "Tech Stack Advisory"
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": "Atul Bhatt — Founder, Klickspell",
    "url": "https://klickspell.com/atul-bhatt",
    "mainEntity": {
      "@type": "Person",
      "name": "Atul Bhatt",
      "jobTitle": "Founder & Lead Engineer",
      "email": "mailto:atul.bhatt@klickspell.com",
      "image": "https://klickspell.com/assets/atul-bhatt-portrait.webp",
      "address": { "@type": "PostalAddress", "addressLocality": "Rudrapur", "addressRegion": "Uttarakhand", "addressCountry": "IN" },
      "worksFor": { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
      "knowsAbout": expertise,
      "sameAs": ["https://in.linkedin.com/in/mratulbhatt", "https://github.com/atulbhatt-system32"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
      { "@type": "ListItem", "position": 2, "name": "Team", "item": "https://klickspell.com/team" },
      { "@type": "ListItem", "position": 3, "name": "Atul Bhatt", "item": "https://klickspell.com/atul-bhatt" }
    ]
  }
];
---

<BaseLayout
  title="Atul Bhatt — Founder, Klickspell"
  description="Atul Bhatt is the founder of Klickspell, a web engineering studio in Uttarakhand building custom Shopify stores, headless commerce, Webflow sites and ERP workflows."
  canonical="https://klickspell.com/atul-bhatt"
  ogType="profile"
  ogImage="/assets/og-atul-bhatt.png"
  schema={schema}
>
  <Nav isHome={false} />

  <main id="main-content">
    <section class="profile">
      <div class="profile-main">
        <p class="cs-breadcrumb"><a href="/">Home</a> / <a href="/team">Team</a> / Atul Bhatt</p>
        <h1 class="profile-name">Atul Bhatt</h1>
        <p class="profile-role">Founder &amp; Lead Engineer, Klickspell</p>

        <div class="profile-block">
          <h2 class="profile-label">Contact</h2>
          <dl class="profile-contact">
            <dt>Email</dt><dd><a href="mailto:atul.bhatt@klickspell.com">atul.bhatt@klickspell.com</a></dd>
            <dt>Location</dt><dd>Rudrapur, Uttarakhand, India</dd>
            <dt>LinkedIn</dt><dd><a href="https://in.linkedin.com/in/mratulbhatt" target="_blank" rel="noopener">in/mratulbhatt ↗</a></dd>
          </dl>
        </div>

        <div class="profile-block">
          <h2 class="profile-heading">Focus at Klickspell</h2>
          <p class="profile-prose">If it runs on the web, Klickspell can build it. That might be a single landing page, a full website, a web app, a client portal or an internal management system. Shopify e-commerce is the studio's speciality.</p>
          <p class="profile-prose">Atul runs these projects together with his <a href="/team">five-person team</a>. He's on the first call, writes code alongside the team, and stays involved after launch. As he puts it, &ldquo;Built for your independence, not our dependency.&rdquo; Once a project is live, your team should be able to run it day to day without calling a developer.</p>

          <h2 class="profile-heading">Background</h2>
          <p class="profile-prose">Atul has been writing software for {yearsExperience}+ years. He has built sites for brands in India, the US, the UK and Israel, including <a href="https://jaxonlane.com/" target="_blank" rel="noopener">Jaxon Lane</a>, <a href="https://about.dealshare.in/" target="_blank" rel="noopener">DealShare</a>, <a href="https://skillbridge.net/" target="_blank" rel="noopener">Skillbridge</a>, <a href="https://www.callsara.ai/" target="_blank" rel="noopener">CallSara AI</a>, <a href="https://www.bambrew.in/" target="_blank" rel="noopener">Bambrew</a>, <a href="https://easyrugs.in/" target="_blank" rel="noopener">Easy Rugs</a>, <a href="https://noukaitokyo.com/" target="_blank" rel="noopener">Noukai Tokyo</a> and <a href="https://bouncebackdrinks.com/" target="_blank" rel="noopener">Bounce Back Drinks</a>.</p>
          <p class="profile-prose">Most of his work is <a href="/services/custom-shopify-development">custom Shopify stores</a>. He also builds <a href="/services/headless-commerce">headless stores</a> on <a href="/work/pragya-vijh.html">Medusa.js</a> and <a href="/work/noukai-tokyo.html">Shopify Hydrogen</a>, <a href="/work/callsara-ai.html">Webflow sites</a>, and ERP setups on <a href="/blog/frappe-production-install-custom-apps-docker">Frappe/ERPNext</a>. He's fussy about <a href="/services/shopify-speed-optimization">speed</a> and will happily remove an app or two to make a store load faster. He also writes <a href="/blog">free tutorials</a> on Shopify and Frappe.</p>

          <h2 class="profile-heading">Beyond Work</h2>
          <p class="profile-prose">When he's not working, Atul is usually exploring somewhere new in India. His first trip abroad is next on the list. He also writes poetry, watches anime and is learning Japanese.</p>

          <h2 class="profile-heading">Expertise</h2>
          <div class="profile-tags">
            {expertise.map(tag => <span class="team-pill">{tag}</span>)}
          </div>
        </div>
      </div>

      <aside class="profile-photo">
        <img src="/assets/atul-bhatt-portrait.webp" alt="Portrait of Atul Bhatt" width="800" height="1002" decoding="async" fetchpriority="high" />
      </aside>
    </section>
  </main>

  <Footer isHome={false} />
</BaseLayout>

<style>
  .profile { max-width:1200px; margin:0 auto; padding:9rem 2rem 5rem; display:grid; grid-template-columns:minmax(0,1fr) 360px; gap:4rem; align-items:start; }
  .profile-name { font-family:'Instrument Serif',serif; font-size:clamp(44px,6vw,72px); font-weight:400; line-height:1.05; letter-spacing:-0.02em; color:var(--text); }
  .profile-role { font-size:18px; color:var(--text-mid); margin-top:.5rem; }
  .profile-block { border-top:.5px solid var(--border); margin-top:2.5rem; padding-top:2.5rem; }
  .profile-label { font-size:16px; font-weight:700; color:var(--text); margin-bottom:1rem; }
  .profile-contact { display:grid; grid-template-columns:96px 1fr; gap:.85rem 1rem; align-items:baseline; font-size:16px; color:var(--text-mid); }
  .profile-contact dt { font-family:var(--font-mono); font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--text-light); }
  .profile-contact a, .profile-prose a { color:var(--accent); text-decoration:none; }
  .profile-contact a:hover, .profile-prose a:hover { color:var(--accent-hover); text-decoration:underline; }
  .profile-heading { font-family:'Instrument Serif',serif; font-size:clamp(26px,3vw,32px); font-weight:400; color:var(--text); margin:2.5rem 0 .75rem; }
  .profile-heading:first-child { margin-top:0; }
  .profile-prose { font-size:16px; line-height:1.8; color:var(--text-mid); max-width:68ch; }
  .profile-tags { display:flex; flex-wrap:wrap; gap:.5rem; }
  .profile-tags .team-pill { text-transform:uppercase; font-size:10.5px; padding:.4rem .8rem; color:var(--accent); }
  .profile-photo { position:sticky; top:7rem; }
  .profile-photo img { width:100%; aspect-ratio:4/5; object-fit:cover; border-radius:var(--radius); background:var(--bg-card); display:block; }

  @media (max-width:900px) {
    .profile { grid-template-columns:1fr; gap:2.5rem; padding:7rem 1rem 4rem; }
    .profile-photo { position:static; order:-1; max-width:320px; }
  }
</style>
