---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const workstreams = [
  {
    title: "Custom Shopify themes",
    desc: "We turn OpenRipples' designs into a custom theme, built section by section so it matches the design instead of bending a stock theme to fit."
  },
  {
    title: "Editable sections",
    desc: "Every block the client might want to change is a theme section they can edit in the Shopify editor, without coming back to a developer."
  },
  {
    title: "Apps & integrations",
    desc: "Setting up and connecting the apps the store needs, like reviews, subscriptions, search and checkout tools, so they fit the design rather than fight it."
  },
  {
    title: "Speed & accessibility",
    desc: "A fast store that works for everyone, so the conversion work in the design actually pays off."
  }
];

const steps = [
  "OpenRipples designs the store.",
  "We review the designs early and flag anything that will be hard to build on Shopify or slow to load.",
  "We build the store, and OpenRipples checks the build against their designs.",
  "The client gets a store their team can edit and run without depending on either of us."
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Klickspell × OpenRipples — Partnership",
    "url": "https://klickspell.com/partners/openripples",
    "about": [
      { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
      { "@type": "Organization", "name": "OpenRipples", "url": "https://www.openripples.com/", "founder": { "@type": "Person", "name": "Neelanjan Munshi", "jobTitle": "Founder & Lead Designer" } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
      { "@type": "ListItem", "position": 2, "name": "Partners", "item": "https://klickspell.com/partners" },
      { "@type": "ListItem", "position": 3, "name": "OpenRipples", "item": "https://klickspell.com/partners/openripples" }
    ]
  }
];
---

<BaseLayout
  title="Klickspell × OpenRipples — Partnership"
  description="Klickspell partners with OpenRipples, a conversion-led design studio. They handle the design; we handle the Shopify development."
  canonical="https://klickspell.com/partners/openripples"
  schema={schema}
>
  <Nav isHome={false} />
  <main id="main-content">
    <section class="team-hero">
      <p class="cs-breadcrumb"><a href="/">Home</a> / <a href="/partners">Partners</a> / OpenRipples</p>
      <p class="section-eyebrow">Partnership</p>
      <h1 class="team-title">Klickspell × <em>OpenRipples</em></h1>
      <p class="team-sub">OpenRipples designs brands and websites that are built to convert. They focus on the design. We take over the Shopify development.</p>
      <dl class="pb-meta">
        <div><dt>Partner</dt><dd><a href="https://www.openripples.com/" target="_blank" rel="noopener">OpenRipples ↗</a></dd></div>
        <div><dt>Their focus</dt><dd>Brand, UI/UX &amp; conversion</dd></div>
        <div><dt>Our role</dt><dd>Shopify development</dd></div>
        <div><dt>Leads</dt><dd>Neelanjan Munshi &amp; <a href="/atul-bhatt">Atul Bhatt</a></dd></div>
      </dl>
    </section>

    <section class="pb-body">
      <div class="pb-block">
        <h2 class="pb-heading">About OpenRipples</h2>
        <div>
          <p class="pb-prose">OpenRipples is a design studio founded by Neelanjan "Neil" Munshi, its lead designer. They work with AI, SaaS, e-commerce and consulting companies on brand identity, UI/UX and websites, and they put conversion first. They've designed 50+ websites, products and stores for clients in the US, Europe and India.</p>
          <figure class="pb-photo">
            <img src="/assets/partners/atul-neil-openripples.webp" alt="Neelanjan (Neil) Munshi of OpenRipples and Atul Bhatt of Klickspell smiling together in a selfie" width="1000" height="1333" loading="lazy" decoding="async" />
            <figcaption>Neil (left) and Atul, meeting in person.</figcaption>
          </figure>
        </div>
      </div>

      <div class="pb-block">
        <h2 class="pb-heading">Where Klickspell fits</h2>
        <p class="pb-prose">A store design only converts if the store behind it is fast, solid and easy for the client to run. OpenRipples does the design, and we take over the Shopify development: the theme, the sections, the apps and everything else that turns their design into a working store. Shopify is our speciality, so the split is clean.</p>
      </div>

      <div class="pb-block">
        <h2 class="pb-heading">What we take on</h2>
        <div class="pb-grid">
          {workstreams.map(w => (
            <article class="pb-card">
              <h3 class="pb-card-title">{w.title}</h3>
              <p class="pb-card-desc">{w.desc}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="pb-block">
        <h2 class="pb-heading">How a project runs</h2>
        <ol class="pb-steps">
          {steps.map((step, i) => (
            <li><span class="pb-step-num">0{i + 1}</span><p>{step}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cta-section">
      <div class="cta-inner">
        <h2 class="cta-title">Working with<br><em>OpenRipples?</em></h2>
        <p class="cta-sub">If your OpenRipples design needs building on Shopify, talk to Atul directly.</p>
        <a href="mailto:atul.bhatt@klickspell.com" class="btn-primary" style="font-size:16px;padding:1rem 2rem">Email Atul →</a>
        <p class="cta-stamp"><a href="/atul-bhatt" style="color:inherit">About Atul</a> · <a href="/partners" style="color:inherit">All partners</a></p>
      </div>
    </section>
  </main>

  <Footer isHome={false} />
</BaseLayout>

<style>
  .pb-meta { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:1.5rem; border-top:.5px solid var(--border); padding-top:1.75rem; max-width:900px; }
  .pb-meta dt { font-family:var(--font-mono); font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); margin-bottom:.4rem; }
  .pb-meta dd { font-size:15px; color:var(--text); }
  .pb-meta a, .pb-prose a { color:var(--accent); text-decoration:none; }
  .pb-meta a:hover { color:var(--accent-hover); text-decoration:underline; }

  .pb-body { max-width:1200px; margin:0 auto; padding:1rem 2rem 4rem; }
  .pb-block { border-top:.5px solid var(--border); padding:2.5rem 0; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,2fr); gap:1rem 3rem; }
  .pb-heading { font-family:'Instrument Serif',serif; font-size:clamp(28px,3.2vw,36px); font-weight:400; line-height:1.15; color:var(--text); }
  .pb-prose { font-size:17px; line-height:1.8; color:var(--text-mid); max-width:68ch; }

  .pb-lead { display:grid; grid-template-columns:72px 1fr; gap:1.25rem; align-items:start; text-decoration:none; background:var(--white); border:.5px solid var(--border); border-radius:var(--radius); padding:1.5rem; transition:border-color .3s, box-shadow .3s; }
  .pb-lead:hover { border-color:rgba(58,91,224,0.3); box-shadow:0 16px 40px rgba(0,0,0,0.07); }
  .pb-lead img { width:72px; height:72px; border-radius:50%; object-fit:cover; }
  .pb-lead-name { font-size:17px; font-weight:700; color:var(--text); }
  .pb-lead-name span { display:block; font-size:13px; font-weight:400; color:var(--text-light); margin-top:2px; }
  .pb-lead-quote { font-family:'Instrument Serif',serif; font-style:italic; font-size:21px; line-height:1.45; color:var(--text); margin-top:1rem; }
  .pb-lead-more { font-family:var(--font-mono); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--accent); margin-top:1rem; }

  .pb-list { list-style:none; display:flex; flex-direction:column; gap:.9rem; margin:1.5rem 0; max-width:68ch; }
  .pb-list li { font-size:16px; line-height:1.75; color:var(--text-mid); padding-left:1.25rem; position:relative; }
  .pb-list li::before { content:''; position:absolute; left:0; top:.75em; width:6px; height:6px; border-radius:50%; background:var(--accent); }
  .pb-list strong { color:var(--text); font-weight:700; }
  .pb-next { font-size:15px; color:var(--text-light); }

  .pb-grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:1.25rem; }
  .pb-card { background:var(--white); border:.5px solid var(--border); border-radius:var(--radius); padding:1.5rem 1.6rem; }
  .pb-card-title { font-size:17px; font-weight:700; color:var(--text); margin-bottom:.5rem; }
  .pb-card-desc { font-size:15px; line-height:1.7; color:var(--text-mid); }

  .pb-steps { list-style:none; display:flex; flex-direction:column; gap:1rem; }
  .pb-steps li { display:grid; grid-template-columns:44px 1fr; gap:1rem; align-items:baseline; font-size:17px; line-height:1.7; color:var(--text-mid); }
  .pb-step-num { font-family:var(--font-mono); font-size:11px; letter-spacing:.1em; color:var(--accent); }

  .pb-photo { margin:2rem 0 0; max-width:420px; }
  .pb-photo img { width:100%; height:auto; display:block; border-radius:var(--radius); border:.5px solid var(--border); }
  .pb-photo figcaption { font-family:var(--font-mono); font-size:11px; letter-spacing:.04em; color:var(--text-light); margin-top:.75rem; }

  @media (max-width:900px) {
    .pb-meta { grid-template-columns:repeat(2, minmax(0,1fr)); }
    .pb-block { grid-template-columns:1fr; }
  }
  @media (max-width:600px) {
    .pb-body { padding:0 1rem 3rem; }
    .pb-grid { grid-template-columns:1fr; }
  }
</style>
