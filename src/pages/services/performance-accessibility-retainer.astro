---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const canonical = "https://klickspell.com/services/performance-accessibility-retainer";

// Pricing model (USD). Every number the builder shows comes from here, so
// changing a range only needs an edit in this one object.
const CARE = {
  areas: [
    {
      id: 'perf',
      name: 'Performance',
      tagline: 'Core Web Vitals, page weight, app & tag bloat',
      points: ['Real-user and lab Core Web Vitals', 'Script & app change tracking', 'Speed checks on new pages'],
      essentials: { min: 300, max: 450, hours: 9 },
      growth: { min: 600, max: 900, hours: 18 },
      baseline: { min: 500, max: 700 },
      includes: {
        essentials: ['Monthly Core Web Vitals report (real-user + lab)', 'Log of scripts and apps added since last month', 'Speed check on up to 2 new pages a month'],
        growth: ['Monthly Core Web Vitals report (real-user + lab)', 'Tag & app governance, implemented by us', 'Speed review of every new page and template']
      }
    },
    {
      id: 'a11y',
      name: 'Accessibility',
      tagline: 'WCAG 2.2 AA, tested by people with screen readers',
      points: ['Manual keyboard & screen-reader testing', 'Automated WCAG scans', 'Accessibility statement & records'],
      essentials: { min: 350, max: 500, hours: 11 },
      growth: { min: 700, max: 1000, hours: 24 },
      baseline: { min: 800, max: 1100 },
      includes: {
        essentials: ['Monthly automated WCAG scan and triage', 'Manual screen-reader pass every quarter', 'Accessibility statement kept current'],
        growth: ['Monthly automated WCAG scan and triage', 'Manual screen-reader test of one shopping journey every month', 'Full manual pass every quarter', 'Accessibility statement and conformance report kept current']
      }
    },
    {
      id: 'privacy',
      name: 'Privacy & security',
      tagline: 'Consent order, third-party scripts, data exposure',
      points: ['Consent fires before tracking', 'Third-party script review', 'Data exposure checks'],
      essentials: { min: 100, max: 150, hours: 3 },
      growth: { min: 150, max: 250, hours: 7 },
      baseline: { min: 200, max: 300 },
      includes: {
        essentials: ['Quarterly check that consent loads before tracking', 'Quarterly third-party script review'],
        growth: ['Monthly check that consent loads before tracking', 'Third-party script and data-exposure review', 'Review of new apps before they are installed']
      }
    }
  ],
  levels: [
    {
      id: 'essentials',
      name: 'Essentials',
      badge: 'Watch & maintain',
      desc: 'For stores that change a few times a month. We keep watch, fix what drifts, and test by hand every quarter.',
      includes: ['Fix hours from your priority list', 'Response within 3 business days', 'Monthly written report']
    },
    {
      id: 'growth',
      name: 'Growth',
      badge: 'Most stores',
      desc: 'For stores shipping campaigns, pages or apps every week. Hands-on testing every month and reviews before anything launches.',
      includes: ['More fix hours from your priority list', 'Response within 1 business day', 'Monthly call and quarterly review']
    }
  ],
  terms: [
    { id: '3', label: '3 months', note: 'Baseline audit at full price', baselineFactor: 1 },
    { id: '6', label: '6 months', note: 'Baseline audit 50% off', baselineFactor: 0.5 },
    { id: '12', label: '12 months', note: 'Baseline audit included', baselineFactor: 0 }
  ],
  projects: [
    { id: 'wcag', name: 'WCAG 2.2 AA conformance program', desc: 'Full audit of every template, remediation of theme code, app configuration and vendor escalation, plus your accessibility statement and conformance report.', min: 3000, max: 5000, time: '8–10 weeks', badge: 'Pairs with Accessibility' },
    { id: 'speed', name: 'Speed sprint', desc: 'A focused push on Core Web Vitals: script scheduling, image delivery, render-blocking CSS and app clean-up, staged in a duplicate theme.', min: 1000, max: 2000, time: '7–14 days', badge: 'Pairs with Performance' },
    { id: 'content', name: 'Content accessibility pass', desc: 'Alt text for product and editorial images, video captions, heading structure and link text, plus a short guide for your team.', min: 500, max: 1000, time: '2–4 weeks', badge: 'Content' },
    { id: 'tags', name: 'Tag & app clean-up', desc: 'Inventory every tag and app script, remove duplicates and leftovers, and load the rest at the right moment.', min: 300, max: 600, time: '1 week', badge: 'Quick win' }
  ],
  presets: [
    { id: 'speed', label: 'Speed only', areas: ['perf'], level: 'essentials', term: '3', projects: ['speed'] },
    { id: 'ada', label: 'ADA readiness', areas: ['a11y', 'privacy'], level: 'growth', term: '6', projects: ['wcag', 'content'] },
    { id: 'complete', label: 'Complete care', areas: ['perf', 'a11y', 'privacy'], level: 'growth', term: '6', projects: ['wcag'], recommended: true }
  ],
  defaults: { areas: ['perf', 'a11y', 'privacy'], level: 'growth', term: '6', projects: ['wcag'] }
};

const money = (n: number) => '$' + n.toLocaleString('en-US');
// Headline price uses the core areas; privacy on its own is an add-on-sized plan.
const fromPrice = Math.min(...CARE.areas.filter((a) => a.id !== 'privacy').map((a) => a.essentials.min));

const faqs = [
  {
    q: 'Will this make my store "ADA compliant"?',
    a: 'There is no official ADA certification for websites, so nobody can honestly promise that. What we deliver is WCAG 2.2 AA conformance on the pages in scope, with the testing documented and kept current. WCAG 2.1/2.2 AA is the standard that demand letters and settlements measure against, and documented, maintained conformance is the most defensible position a store can have.'
  },
  {
    q: 'Do you use accessibility overlay widgets?',
    a: 'No. Overlays sit on top of the page and do not fix the code underneath. Stores using them still receive demand letters, and many screen-reader users actively avoid them. We fix the theme code itself.'
  },
  {
    q: 'What about apps we don’t control, like reviews or loyalty?',
    a: 'We configure them for accessibility and speed, work around issues where it is safe to, and raise tickets with the vendor where it is not, keeping the record as part of your documentation. If an app has a serious issue its vendor won’t fix, we tell you plainly so you can decide whether to keep it.'
  },
  {
    q: 'Why ranges instead of a fixed price?',
    a: 'The work depends on how many templates, apps and integrations your store has. After a free 30-minute review of your store we send a fixed monthly quote inside the range, with no surprises afterwards.'
  },
  {
    q: 'Can we switch plans later?',
    a: 'Yes. You can move between Essentials and Growth, or add and remove areas, at any month boundary. The term only sets how long the retainer runs and what the baseline audit costs.'
  },
  {
    q: 'What happens to fix hours we don’t use?',
    a: 'Unused fix hours roll over for one month, then expire. Your monthly report shows exactly how they were spent.'
  },
  {
    q: 'Do you work on our live theme?',
    a: 'Never. Every change is built and tested in a duplicate theme. Nothing reaches your customers until you have reviewed it and approved it.'
  },
  {
    q: 'Who does the manual testing?',
    a: 'Our engineers test by hand with a keyboard, NVDA with Chrome on Windows, and VoiceOver with Safari on macOS and iOS, alongside automated scans. JAWS testing is available on request.'
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Shopify Performance & Accessibility Retainer",
  "serviceType": "Website Performance and Accessibility Maintenance",
  "provider": { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
  "description": "A monthly retainer that keeps Shopify stores fast, WCAG 2.2 AA accessible and privacy-safe, with manual screen-reader testing, Core Web Vitals monitoring and fix hours.",
  "areaServed": "Worldwide",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Performance & Accessibility Retainer",
    "itemListElement": CARE.levels.map((level) => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": `${level.name} retainer` },
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "priceCurrency": "USD",
        "minPrice": Math.min(...CARE.areas.map((a) => a[level.id as 'essentials' | 'growth'].min)),
        "maxPrice": CARE.areas.reduce((sum, a) => sum + a[level.id as 'essentials' | 'growth'].max, 0),
        "unitText": "MONTH"
      }
    }))
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://klickspell.com/services" },
    { "@type": "ListItem", "position": 3, "name": "Performance & Accessibility Retainer", "item": canonical }
  ]
};

const calAttrs = {
  href: 'https://cal.com/atul-bhatt-klickspell/30min',
  'data-cal-link': 'atul-bhatt-klickspell/30min',
  'data-cal-namespace': '30min',
  'data-cal-config': '{"layout":"month_view"}'
};
---

<BaseLayout
  title="Shopify Performance & Accessibility Retainer — WCAG 2.2 AA & Core Web Vitals | Klickspell"
  description="A monthly retainer that keeps your Shopify store fast, accessible and privacy-safe. Manual screen-reader testing, Core Web Vitals monitoring and fix hours. Build your plan and see the price range."
  canonical={canonical}
  ogImage="https://klickspell.com/assets/og-card.png"
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <Nav />

  <main id="main-content" class="care-page">
    <!-- HERO -->
    <header class="service-page-hero">
      <p class="cs-breadcrumb reveal"><a href="/">Home</a> / <a href="/services">Services</a> / Performance &amp; Accessibility Retainer</p>

      <div class="service-badge reveal">
        <span class="service-badge-dot" aria-hidden="true"></span>
        Monthly retainer · Speed · WCAG 2.2 AA · Privacy
      </div>

      <h1 class="service-hero-title reveal reveal-delay-1">
        Fast, accessible stores don't<br>
        stay that way <em>on their own.</em>
      </h1>

      <p class="service-hero-sub reveal reveal-delay-2">
        Every app install, campaign page and new tag chips away at speed and accessibility. We audit your store, fix what's broken, and keep watch every month, with real manual testing rather than just automated scores.
      </p>

      <div class="service-hero-actions reveal reveal-delay-2">
        <a href="#build" class="btn-primary">Build your plan ↓</a>
        <a {...calAttrs} class="btn-ghost" style="cursor:pointer">Book a free 30-min review</a>
      </div>

      <div class="service-metrics-bar reveal reveal-delay-3">
        <div class="service-metric-item">
          <p class="metric-label">Plans from</p>
          <p class="metric-val">{money(fromPrice)}/mo</p>
          <p class="metric-note">Speed or accessibility, Essentials</p>
        </div>
        <div class="service-metric-item">
          <p class="metric-label">Standard</p>
          <p class="metric-val">WCAG 2.2 AA</p>
          <p class="metric-note">Manual and automated testing</p>
        </div>
        <div class="service-metric-item">
          <p class="metric-label">Screen readers</p>
          <p class="metric-val">NVDA · VoiceOver</p>
          <p class="metric-note">Tested by people, not only scanners</p>
        </div>
        <div class="service-metric-item">
          <p class="metric-label">Your live store</p>
          <p class="metric-val">Untouched</p>
          <p class="metric-note">Changes staged in a duplicate theme</p>
        </div>
      </div>
    </header>

    <div class="service-body-wrap">

      <!-- WHY A RETAINER -->
      <section class="reveal" aria-labelledby="drift-title">
        <div class="service-section-header">
          <p class="section-eyebrow">The drift problem</p>
          <h2 id="drift-title">Most stores weren't built slow.<br><em>They got slow.</em></h2>
          <p>Speed and accessibility rarely break in one bad release. They wear down a little with every change, which is why a one-off fix doesn't last and a monthly check does.</p>
        </div>

        <div class="service-grid-3">
          <div class="service-deliverable-card">
            <p class="service-card-num">01 · APPS</p>
            <h3 class="service-card-title">Every install adds weight</h3>
            <p class="service-card-text">Review widgets, loyalty programs, chat and upsell apps each bring their own scripts, and many load media before a shopper ever scrolls to them. Uninstalled apps often leave code behind.</p>
          </div>
          <div class="service-deliverable-card">
            <p class="service-card-num">02 · MARKETING</p>
            <h3 class="service-card-title">Tags multiply quietly</h3>
            <p class="service-card-text">A second analytics property here, a heatmap tool there. It's common to find several overlapping trackers on every page, sometimes firing before cookie consent is even set.</p>
          </div>
          <div class="service-deliverable-card">
            <p class="service-card-num">03 · CONTENT</p>
            <h3 class="service-card-title">New pages skip the checks</h3>
            <p class="service-card-text">Landing pages, guides and campaign sections ship fast, usually without anyone checking headings, alt text, contrast, keyboard access or load time.</p>
          </div>
        </div>
      </section>

      <!-- WHAT WE LOOK AFTER -->
      <section class="reveal" aria-labelledby="pillars-title">
        <div class="service-section-header">
          <p class="section-eyebrow">What we look after</p>
          <h2 id="pillars-title">Three areas. Pick one,<br><em>or let us handle all of them.</em></h2>
          <p>Each area has a clear monthly routine and its own share of fix hours. Combine them in the plan builder below.</p>
        </div>

        <div class="service-grid-3">
          {CARE.areas.map((area, i) => (
            <div class="service-deliverable-card">
              <p class="service-card-num">{String(i + 1).padStart(2, '0')} · {area.name.toUpperCase()}</p>
              <h3 class="service-card-title">{area.tagline}</h3>
              <ul class="care-list">
                {area.includes.growth.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- ADA HONESTY -->
      <section class="reveal care-honest" aria-labelledby="ada-title">
        <div class="service-section-header">
          <p class="section-eyebrow">ADA, honestly</p>
          <h2 id="ada-title">There's no ADA certificate.<br><em>Here's what actually protects you.</em></h2>
          <p>A lot of accessibility marketing sells certainty that doesn't exist. This is how we approach it instead.</p>
        </div>

        <div class="care-compare">
          <div class="care-compare-col care-compare-col--no">
            <h3 class="care-compare-title">What we won't tell you</h3>
            <ul>
              <li><strong>That your store is "ADA certified".</strong> No official certification exists for websites.</li>
              <li><strong>That an overlay widget makes you compliant.</strong> Overlays don't fix the code underneath, and stores using them still receive demand letters.</li>
              <li><strong>That you're lawsuit-proof.</strong> Anyone can file. What matters is how well you can show the work.</li>
            </ul>
          </div>
          <div class="care-compare-col care-compare-col--yes">
            <h3 class="care-compare-title">What we will do</h3>
            <ul>
              <li><strong>Bring in-scope pages to WCAG 2.2 AA,</strong> the standard demand letters and settlements measure against.</li>
              <li><strong>Test by hand</strong> with a keyboard and real screen readers, not just automated scanners.</li>
              <li><strong>Document everything:</strong> an accessibility statement, a conformance report and a dated log of every issue and fix.</li>
              <li><strong>Keep it current</strong> as your store, apps and content change.</li>
            </ul>
          </div>
        </div>
        <p class="care-footnote">We're engineers, not lawyers. Have your legal counsel review your accessibility statement before it's published.</p>
      </section>

      <!-- HOW IT WORKS -->
      <section class="reveal" aria-labelledby="process-title">
        <div class="service-section-header">
          <p class="section-eyebrow">How it works</p>
          <h2 id="process-title">Audit once.<br><em>Then keep it that way.</em></h2>
        </div>

        <ol class="care-steps">
          <li class="care-step">
            <p class="service-card-num">STEP 01 · WEEKS 1–3</p>
            <h3 class="service-card-title">Baseline audit</h3>
            <p class="service-card-text">Every template tested: automated scans, manual screen-reader passes on your key shopping journeys, real-user speed data and a full inventory of scripts and apps.</p>
          </li>
          <li class="care-step">
            <p class="service-card-num">STEP 02 · WEEKS 2–10</p>
            <h3 class="service-card-title">Fix the priorities</h3>
            <p class="service-card-text">A ranked fix list, worked through in a duplicate theme. Theme code, app settings and vendor tickets, each with before and after evidence.</p>
          </li>
          <li class="care-step">
            <p class="service-card-num">STEP 03 · MONTHLY</p>
            <h3 class="service-card-title">Watch every change</h3>
            <p class="service-card-text">New pages and apps get checked before launch. Scans run monthly, and manual testing follows the schedule in your plan.</p>
          </li>
          <li class="care-step">
            <p class="service-card-num">STEP 04 · QUARTERLY</p>
            <h3 class="service-card-title">Report & review</h3>
            <p class="service-card-text">Clear reports on what improved, what was fixed and what's next, measured against the numbers we agreed at the start.</p>
          </li>
        </ol>
      </section>

      <!-- HOW WE TEST -->
      <section class="service-proof-box reveal" aria-labelledby="testing-title">
        <div class="service-section-header" style="margin-bottom:2rem;">
          <p class="section-eyebrow">How we test</p>
          <h2 id="testing-title">The tools behind<br><em>every report.</em></h2>
        </div>
        <div class="care-testing">
          <div>
            <h3 class="care-testing-title">Accessibility</h3>
            <ul class="care-list">
              <li>Keyboard only: focus order, visible focus, no traps</li>
              <li>NVDA with Chrome on Windows</li>
              <li>VoiceOver with Safari on macOS and iOS</li>
              <li>200% and 400% zoom, text reflow at 320px</li>
              <li>Colour contrast, motion and reduced-motion settings</li>
              <li>Automated scans with axe, WAVE and Lighthouse</li>
            </ul>
          </div>
          <div>
            <h3 class="care-testing-title">Performance & privacy</h3>
            <ul class="care-list">
              <li>Google's real-user Core Web Vitals data (CrUX)</li>
              <li>Lighthouse lab runs on every template, mobile and desktop</li>
              <li>Page weight and request breakdown by third party</li>
              <li>Main-thread time per script and app</li>
              <li>Consent mode order: what fires before consent is set</li>
              <li>Data exposed in page source and public endpoints</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- PLAN BUILDER -->
      <section id="build" class="care-build" aria-labelledby="build-title">
        <div class="service-section-header">
          <p class="section-eyebrow">Plan builder</p>
          <h2 id="build-title">Build your plan.<br><em>See the price range as you go.</em></h2>
          <p>Start from a common plan or pick each part yourself. Prices are in USD. You get a fixed quote inside the range after a free 30-minute review of your store.</p>
        </div>

        <script type="application/json" id="careData" set:html={JSON.stringify(CARE)} />

        <div class="quote-layout">
          <div class="quote-main-col">
            <form id="careForm" novalidate>

              <!-- PRESETS -->
              <div class="quote-card">
                <div class="quote-card-header">
                  <p class="quote-card-eyebrow"><span class="step-tag">Start here</span><span>Common plans</span></p>
                  <h3 class="quote-card-title">Start from a common plan</h3>
                  <p class="quote-card-sub">Pick the one closest to what you need, then adjust any step below.</p>
                </div>
                <div class="care-presets">
                  {CARE.presets.map((p) => (
                    <button type="button" class="care-preset" data-preset={p.id} aria-pressed="false">
                      <span class="care-preset-label">{p.label}</span>
                      {p.recommended && <span class="care-preset-tag">Recommended</span>}
                    </button>
                  ))}
                </div>
              </div>

              <!-- STEP 1: AREAS -->
              <fieldset class="quote-card care-fieldset">
                <legend class="care-legend">
                  <span class="quote-card-eyebrow"><span class="step-tag">Step 01</span><span>Areas</span></span>
                  <span class="quote-card-title">What should we look after?</span>
                </legend>
                <p class="quote-card-sub care-fieldset-sub">Choose one or more. Each adds its own monthly routine.</p>
                <div class="theme-cards-grid care-grid-3">
                  {CARE.areas.map((area) => (
                    <label class="theme-card-label">
                      <input type="checkbox" name="area" value={area.id} checked={CARE.defaults.areas.includes(area.id)} />
                      <div class="theme-card-box">
                        <div>
                          <div class="theme-card-top">
                            <span class="theme-card-name">{area.name}</span>
                            <span class="care-check" aria-hidden="true"></span>
                          </div>
                          <p class="theme-card-desc">{area.tagline}</p>
                          <ul class="care-mini-list">
                            {area.points.map((pt) => <li>{pt}</li>)}
                          </ul>
                        </div>
                        <div class="theme-card-footer">
                          <span>{money(area.essentials.min)}–{money(area.growth.max)}/mo</span>
                        </div>
                      </div>
                    </label>
                  ))}
                </div>
                <p id="areaError" class="care-inline-note" hidden>Pick at least one area to see a monthly range.</p>
              </fieldset>

              <!-- STEP 2: LEVEL -->
              <fieldset class="quote-card care-fieldset">
                <legend class="care-legend">
                  <span class="quote-card-eyebrow"><span class="step-tag">Step 02</span><span>Coverage</span></span>
                  <span class="quote-card-title">How closely should we watch?</span>
                </legend>
                <p class="quote-card-sub care-fieldset-sub">Ranges update for the areas you've picked.</p>
                <div class="theme-cards-grid">
                  {CARE.levels.map((level) => (
                    <label class="theme-card-label">
                      <input type="radio" name="level" value={level.id} checked={CARE.defaults.level === level.id} />
                      <div class="theme-card-box">
                        <div>
                          <div class="theme-card-top">
                            <span class="theme-card-badge">{level.badge}</span>
                            <span class="theme-card-radio-circle" aria-hidden="true"></span>
                          </div>
                          <span class="theme-card-name">{level.name}</span>
                          <p class="theme-card-desc">{level.desc}</p>
                          <ul class="care-mini-list">
                            {level.includes.map((item) => <li>{item}</li>)}
                          </ul>
                        </div>
                        <div class="theme-card-footer">
                          <span data-level-range={level.id}>&nbsp;</span>
                          <span data-level-hours={level.id}>&nbsp;</span>
                        </div>
                      </div>
                    </label>
                  ))}
                </div>
              </fieldset>

              <!-- STEP 3: TERM -->
              <fieldset class="quote-card care-fieldset">
                <legend class="care-legend">
                  <span class="quote-card-eyebrow"><span class="step-tag">Step 03</span><span>Term</span></span>
                  <span class="quote-card-title">How long should we start with?</span>
                </legend>
                <p class="quote-card-sub care-fieldset-sub">Real-user speed data takes about 28 days to reflect a change, so we start at 3 months. Longer terms reduce the baseline audit fee.</p>
                <div class="quote-pill-options care-term-options">
                  {CARE.terms.map((term) => (
                    <label class="quote-pill-label">
                      <input type="radio" name="term" value={term.id} checked={CARE.defaults.term === term.id} />
                      <span class="quote-pill-ui care-term-ui">
                        <span class="care-term-label">{term.label}</span>
                        <span class="care-term-note">{term.note}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <!-- STEP 4: PROJECTS -->
              <fieldset class="quote-card care-fieldset">
                <legend class="care-legend">
                  <span class="quote-card-eyebrow"><span class="step-tag">Step 04</span><span>One-time projects</span></span>
                  <span class="quote-card-title">Want a head start? <span class="care-optional">(optional)</span></span>
                </legend>
                <p class="quote-card-sub care-fieldset-sub">One-time projects that get you to a strong baseline faster. The retainer then keeps you there.</p>
                <div class="theme-cards-grid">
                  {CARE.projects.map((project) => (
                    <label class="theme-card-label">
                      <input type="checkbox" name="project" value={project.id} checked={CARE.defaults.projects.includes(project.id)} />
                      <div class="theme-card-box">
                        <div>
                          <div class="theme-card-top">
