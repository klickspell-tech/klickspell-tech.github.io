---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const canonical = "https://klickspell.com/services/performance-accessibility-retainer";

// Pricing model (USD). Every price is estimated hours × the RATE band, so
// repricing the whole page only needs RATE (or an hours figure) changed.
const RATE = { min: 20, max: 30 };
const to25 = (n: number) => Math.round(n / 25) * 25;
const priced = (hours: number) => ({ min: to25(hours * RATE.min), max: to25(hours * RATE.max), hours });

const CARE = {
  rate: RATE,
  areas: [
    {
      id: 'perf',
      name: 'Performance',
      tagline: 'Speed & code governance: Core Web Vitals, apps, tags',
      points: ['Real-user and lab Core Web Vitals', 'Every new app and tag reviewed', 'Speed checks on new pages'],
      lite: priced(5),
      essentials: priced(9),
      growth: priced(18),
      baseline: priced(20),
      includes: {
        lite: ['Monthly Core Web Vitals report (real-user data)', 'Alert when a new app or tag slows the store'],
        essentials: ['Monthly Core Web Vitals report (real-user + lab)', 'Log of scripts and apps added since last month', 'Speed check on up to 2 new pages a month'],
        growth: ['Monthly Core Web Vitals report (real-user + lab)', 'Tag & app governance, implemented by us', 'Speed review of every new page and template']
      }
    },
    {
      id: 'a11y',
      name: 'Accessibility',
      tagline: 'WCAG 2.2 AA, tested by people with screen readers',
      points: ['Manual keyboard & screen-reader testing', 'Automated WCAG scans', 'Accessibility statement & records'],
      lite: priced(6),
      essentials: priced(12),
      growth: priced(25),
      baseline: priced(40),
      includes: {
        lite: ['Monthly automated WCAG scan with a prioritised fix list', 'Manual keyboard and screen-reader check twice a year'],
        essentials: ['Monthly automated WCAG scan and triage', 'Manual screen-reader pass every quarter', 'Accessibility statement kept current'],
        growth: ['Monthly automated WCAG scan and triage', 'Manual screen-reader test of one shopping journey every month', 'Full manual pass every quarter', 'Accessibility statement and conformance report kept current']
      }
    },
    {
      id: 'privacy',
      name: 'Privacy & security',
      tagline: 'Consent order, third-party scripts, data exposure',
      points: ['Consent fires before tracking', 'Third-party script review', 'Data exposure checks'],
      lite: priced(2),
      essentials: priced(3),
      growth: priced(7),
      baseline: priced(8),
      includes: {
        lite: ['Consent and tracking check twice a year'],
        essentials: ['Quarterly check that consent loads before tracking', 'Quarterly third-party script review'],
        growth: ['Monthly check that consent loads before tracking', 'Third-party script and data-exposure review', 'Review of new apps before they are installed']
      }
    }
  ],
  levels: [
    {
      id: 'lite',
      name: 'Lite',
      badge: 'Monitor & report',
      desc: 'For smaller stores that change rarely. We watch, report and fix small issues. Bigger fixes are quoted separately.',
      includes: ['A few fix hours for small issues', 'Response within 5 business days', 'Monthly written report']
    },
    {
      id: 'essentials',
      name: 'Essentials',
      badge: 'Most stores',
      desc: 'For stores that change a few times a month. We keep watch, fix what drifts, and test by hand every quarter.',
      includes: ['Fix hours from your priority list', 'Response within 3 business days', 'Monthly written report']
    },
    {
      id: 'growth',
      name: 'Growth',
      badge: 'Fast-moving stores',
      desc: 'For stores shipping campaigns, pages or apps every week. Hands-on testing every month and reviews before anything launches.',
      includes: ['More fix hours from your priority list', 'Response within 1 business day', 'Monthly call and quarterly review']
    }
  ],
  terms: [
    { id: '3', label: '3 months', note: 'Baseline audit at full price', baselineFactor: 1 },
    { id: '6', label: '6 months', note: 'Baseline audit 50% off', baselineFactor: 0.5 },
    { id: '12', label: '12 months', note: 'Baseline audit included', baselineFactor: 0 }
  ],
  projects: [
    { id: 'wcag', name: 'WCAG 2.2 AA conformance program', desc: 'Full audit of every template, remediation of theme code, app configuration and vendor escalation, plus your accessibility statement and conformance report.', ...priced(100), time: '8–10 weeks', badge: 'Pairs with Accessibility' },
    { id: 'speed', name: 'Speed sprint', desc: 'A focused push on Core Web Vitals: script scheduling, image delivery, render-blocking CSS and app clean-up, staged in a duplicate theme.', ...priced(50), time: '2–3 weeks', badge: 'Pairs with Performance' },
    { id: 'content', name: 'Content accessibility pass', desc: 'Alt text for product and editorial images, video captions, heading structure and link text, plus a short guide for your team.', ...priced(25), time: '2–4 weeks', badge: 'Content' },
    { id: 'tags', name: 'Tag & app clean-up', desc: 'Inventory every tag and app script, remove duplicates and leftovers, and load the rest at the right moment.', ...priced(12), time: '1 week', badge: 'Quick win' }
  ],
  presets: [
    { id: 'starter', label: 'Starter watch', areas: ['perf', 'a11y', 'privacy'], level: 'lite', term: '3', projects: [] },
    { id: 'speed', label: 'Speed sprint + watch', areas: ['perf'], level: 'lite', term: '3', projects: ['speed'] },
    { id: 'ada', label: 'ADA readiness', areas: ['a11y', 'privacy'], level: 'essentials', term: '6', projects: ['wcag', 'content'] },
    { id: 'complete', label: 'Complete care', areas: ['perf', 'a11y', 'privacy'], level: 'essentials', term: '6', projects: ['wcag'], recommended: true },
    { id: 'scale', label: 'Scale-up care', areas: ['perf', 'a11y', 'privacy'], level: 'growth', term: '6', projects: ['wcag'] }
  ],
  defaults: { areas: ['perf', 'a11y', 'privacy'], level: 'essentials', term: '6', projects: ['wcag'] }
};

const money = (n: number) => '$' + n.toLocaleString('en-US');
// Headline price uses the core areas on Lite; privacy on its own is an add-on-sized plan.
const fromPrice = Math.min(...CARE.areas.filter((a) => a.id !== 'privacy').map((a) => a.lite.min));

// Every figure quoted on the page links back to one of these.
const SOURCES = {
  usablenet: { label: 'UsableNet, 2025 lawsuit report', url: 'https://blog.usablenet.com/ada-web-lawsuit-trends-2026' },
  webaim: { label: 'WebAIM Million, 2026', url: 'https://webaim.org/projects/million/' },
  cdc: { label: 'CDC, 2024', url: 'https://www.cdc.gov/media/releases/2024/s0716-Adult-disability.html' },
  deloitte: { label: 'Deloitte & Google, Milliseconds Make Millions', url: 'https://web.dev/case-studies/milliseconds-make-millions' },
  vodafone: { label: 'web.dev, Vodafone case study', url: 'https://web.dev/case-studies/vodafone' },
  ftc: { label: 'FTC, April 2025', url: 'https://www.ftc.gov/news-events/news/press-releases/2025/04/ftc-approves-final-order-requiring-accessibe-pay-1-million' },
  eaa: { label: 'Directive (EU) 2019/882', url: 'https://eur-lex.europa.eu/eli/dir/2019/882/oj' },
  overlays: { label: 'Overlay Fact Sheet', url: 'https://overlayfactsheet.com/' }
};

const stats = [
  { val: '5,000+', text: 'digital accessibility lawsuits were filed in the US in 2025.', src: SOURCES.usablenet },
  { val: '~70%', text: 'of those lawsuits were against e-commerce sites.', src: SOURCES.usablenet },
  { val: '64%', text: 'of companies sued had under $25M in annual revenue. This isn’t only a big-brand problem.', src: SOURCES.usablenet },
  { val: '95.9%', text: 'of the top million home pages fail automated WCAG checks, averaging 56 errors each.', src: SOURCES.webaim },
  { val: '1 in 4', text: 'US adults, over 70 million people, live with a disability. They are customers.', src: SOURCES.cdc },
  { val: '+8.4%', text: 'retail conversions from a 0.1-second faster mobile site, across 37 brands.', src: SOURCES.deloitte }
];

// Options a store owner is usually weighing. Market ranges, not our prices.
const compare = {
  cols: ['Do nothing', 'Overlay widget', 'One-off audit', 'This retainer'],
  rows: [
    { label: 'Typical cost', cells: ['$0 until a demand letter arrives', '~$50–350/mo', '$1,000–7,500 once', `From ${money(fromPrice)}/mo + baseline audit`] },
    { label: 'Fixes the theme code', cells: ['No', 'No, it sits on top of the page', 'Lists issues; fixing is extra', 'Yes, fix hours every month'] },
    { label: 'Manual screen-reader testing', cells: ['No', 'No', 'Usually', 'Yes, on your plan’s schedule'] },
    { label: 'Stays current as the store changes', cells: ['No', 'No', 'No, it’s a snapshot', 'Yes, new pages and apps checked'] },
    { label: 'Records if a letter arrives', cells: ['None', 'A subscription receipt', 'A report dated the day of the audit', 'Dated log, statement and conformance report'] },
    { label: 'Speed', cells: ['Drifts with every app', 'Adds another script', 'Not covered', 'Monitored and fixed monthly'] }
  ]
};

// "?areas=…" links reload the page with a preset already applied in the builder.
const presetHref = (id: string) => {
  const p = CARE.presets.find((x) => x.id === id)!;
  const q = new URLSearchParams({ areas: p.areas.join(','), level: p.level, term: p.term, projects: p.projects.join(',') });
  return `?${q.toString()}#build`;
};
const presetLabel = (id: string) => CARE.presets.find((x) => x.id === id)!.label;

const scenarios = [
  {
    tag: 'Received a letter',
    title: 'We’ve had a demand letter or a complaint.',
    text: 'Talk to your lawyer first. Then we audit the issues the letter cites, fix them in a duplicate theme and give you a dated record of the work, followed by a full WCAG 2.2 AA program.',
    preset: 'ada'
  },
  {
    tag: 'Slow store',
    title: 'Our store feels slow, or ad costs keep rising.',
    text: 'Start with a speed sprint to get Core Web Vitals into the green, then light monthly monitoring so new apps and tags don’t undo it.',
    preset: 'speed'
  },
  {
    tag: 'Selling in the EU',
    title: 'We sell to customers in the EU.',
    text: 'The European Accessibility Act has applied to online stores selling to EU consumers since 28 June 2025, including stores based outside the EU. Accessibility coverage plus a WCAG program is the place to start.',
    preset: 'ada'
  },
  {
    tag: 'Shipping weekly',
    title: 'We launch pages, campaigns and apps every week.',
    text: 'This is where drift is fastest. Growth coverage checks every launch for speed, accessibility and consent before your customers see it.',
    preset: 'scale'
  }
];

const faqs = [
  {
    q: 'Will this make my store "ADA compliant"?',
    a: 'There is no official ADA certification for websites, so nobody can honestly promise that. What we deliver is WCAG 2.2 AA conformance on the pages in scope, with the testing documented and kept current. WCAG 2.1/2.2 AA is the standard that demand letters and settlements measure against, and documented, maintained conformance is the most defensible position a store can have.'
  },
  {
    q: 'Do you use accessibility overlay widgets?',
    a: 'No. Overlays sit on top of the page and do not fix the code underneath. Stores using them still receive demand letters, and many screen-reader users actively avoid them. We fix the theme code itself.'
  },
  {
    q: 'What about apps we don’t control, like reviews or loyalty?',
    a: 'We configure them for accessibility and speed, work around issues where it is safe to, and raise tickets with the vendor where it is not, keeping the record as part of your documentation. If an app has a serious issue its vendor won’t fix, we tell you plainly so you can decide whether to keep it.'
  },
  {
    q: 'Why do you cost less than a US or UK agency?',
    a: `We're an engineering studio based in India, so our costs are lower. Our standard isn't: the same WCAG 2.2 AA criteria, the same screen readers and the same speed tooling, with every change staged in a duplicate theme. Every plan works out to about ${money(RATE.min)}–${money(RATE.max)} an hour, where specialist accessibility consultants in the US and UK often bill $100 or more. Your monthly report shows how every hour was spent.`
  },
  {
    q: 'Why ranges instead of a fixed price?',
    a: 'The work depends on how many templates, apps and integrations your store has. After a free 30-minute review of your store we send a fixed monthly quote inside the range, with no surprises afterwards.'
  },
  {
    q: 'Can we switch plans later?',
    a: 'Yes. You can move between Lite, Essentials and Growth, or add and remove areas, at any month boundary. The term only sets how long the retainer runs and what the baseline audit costs.'
  },
  {
    q: 'What happens to fix hours we don’t use?',
    a: 'Unused fix hours roll over for one month, then expire. Your monthly report shows exactly how they were spent.'
  },
  {
    q: 'Do you work on our live theme?',
    a: 'Never. Every change is built and tested in a duplicate theme. Nothing reaches your customers until you have reviewed it and approved it.'
  },
  {
    q: 'Who does the manual testing?',
    a: 'Our engineers test by hand with a keyboard, NVDA with Chrome on Windows, and VoiceOver with Safari on macOS and iOS, alongside automated scans. JAWS testing is available on request. Together these cover the screen readers most people use: in WebAIM’s latest survey, NVDA and JAWS lead on desktop and VoiceOver on mobile.'
  },
  {
    q: 'We’ve received a demand letter. Can you help?',
    a: 'Yes, alongside your lawyer, not instead of one. We don’t give legal advice. What we can do quickly is audit the specific issues the letter cites, fix them in a duplicate theme, and give you a dated record of the testing and fixes, which your counsel can use. Then we move on to full WCAG 2.2 AA coverage so the same gaps don’t reappear.'
  },
  {
    q: 'Does the European Accessibility Act apply to us?',
    a: 'If you sell to consumers in the EU, probably yes, even if your business is based elsewhere. It has applied to e-commerce since 28 June 2025. Microenterprises (fewer than 10 staff and no more than €2 million in annual turnover or balance sheet) are exempt for services. Its technical standard, EN 301 549, is built on WCAG 2.1 AA, which our WCAG 2.2 AA testing covers. Confirm your position with legal counsel.'
  },
  {
    q: 'We already had an accessibility audit. Do we need the baseline again?',
    a: 'Not always. If it’s recent and tested against WCAG 2.1 or 2.2 AA, we review it, re-test the key journeys and reduce the baseline accordingly. We’ll tell you on the review call.'
  },
  {
    q: 'Why does the accessibility baseline cost more than the others?',
    a: 'Because it’s done by hand. Every template is tested with a keyboard and two screen readers across desktop and mobile, and every issue is written up with steps to reproduce and a fix. Automated scanners only catch part of WCAG; the rest needs a person.'
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Shopify Performance & Accessibility Retainer",
  "serviceType": "Website Performance and Accessibility Maintenance",
  "provider": { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
  "description": "A monthly retainer that keeps Shopify stores fast, WCAG 2.2 AA accessible and privacy-safe, with manual screen-reader testing, Core Web Vitals monitoring and fix hours.",
  "areaServed": "Worldwide",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Performance & Accessibility Retainer",
    "itemListElement": CARE.levels.map((level) => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": `${level.name} retainer` },
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "priceCurrency": "USD",
        "minPrice": Math.min(...CARE.areas.map((a) => a[level.id as 'lite' | 'essentials' | 'growth'].min)),
        "maxPrice": CARE.areas.reduce((sum, a) => sum + a[level.id as 'lite' | 'essentials' | 'growth'].max, 0),
        "unitText": "MONTH"
      }
    }))
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://klickspell.com/services" },
    { "@type": "ListItem", "position": 3, "name": "Performance & Accessibility Retainer", "item": canonical }
  ]
};

const calAttrs = {
  href: 'https://cal.com/atul-bhatt-klickspell/30min',
  'data-cal-link': 'atul-bhatt-klickspell/30min',
  'data-cal-namespace': '30min',
  'data-cal-config': '{"layout":"month_view"}'
};
---

<BaseLayout
  title="Shopify Performance & Accessibility Retainer — WCAG 2.2 AA & Core Web Vitals | Klickspell"
  description="A monthly retainer that keeps your Shopify store fast, accessible and privacy-safe. Manual screen-reader testing, Core Web Vitals monitoring and fix hours. Build your plan and see the price range."
  canonical={canonical}
  ogImage="https://klickspell.com/assets/og-card.png"
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <Nav />

  <main id="main-content" class="care-page">
    <!-- HERO -->
    <header class="service-page-hero">
      <p class="cs-breadcrumb reveal"><a href="/">Home</a> / <a href="/services">Services</a> / Performance &amp; Accessibility Retainer</p>

      <div class="service-badge reveal">
        <span class="service-badge-dot" aria-hidden="true"></span>
        Monthly retainer · Speed · WCAG 2.2 AA · Privacy
      </div>

      <h1 class="service-hero-title reveal reveal-delay-1">
        Fast, accessible stores don't<br>
        stay that way <em>on their own.</em>
      </h1>

      <p class="service-hero-sub reveal reveal-delay-2">
        Every app install, campaign page and new tag chips away at speed and accessibility. We audit your store, fix what's broken, and keep watch every month, with real manual testing rather than just automated scores.
      </p>

      <div class="service-hero-actions reveal reveal-delay-2">
        <a href="#build" class="btn-primary">Build your plan ↓</a>
        <a {...calAttrs} class="btn-ghost" style="cursor:pointer">Book a free 30-min review</a>
      </div>

      <div class="service-metrics-bar reveal reveal-delay-3">
        <div class="service-metric-item">
          <p class="metric-label">Plans from</p>
          <p class="metric-val">{money(fromPrice)}/mo</p>
          <p class="metric-note">Speed or accessibility, Essentials</p>
        </div>
        <div class="service-metric-item">
          <p class="metric-label">Effective rate</p>
          <p class="metric-val">{money(RATE.min)}–{money(RATE.max)}/hr</p>
          <p class="metric-note">Engineers in India, WCAG 2.2 AA standard</p>
        </div>
        <div class="service-metric-item">
          <p class="metric-label">Screen readers</p>
          <p class="metric-val">NVDA · VoiceOver</p>
          <p class="metric-note">Tested by people, not only scanners</p>
        </div>
        <div class="service-metric-item">
          <p class="metric-label">Your live store</p>
          <p class="metric-val">Untouched</p>
          <p class="metric-note">Changes staged in a duplicate theme</p>
        </div>
      </div>
    </header>

    <div class="service-body-wrap">

      <!-- WHY A RETAINER -->
      <section class="reveal" aria-labelledby="drift-title">
        <div class="service-section-header">
          <p class="section-eyebrow">The drift problem</p>
          <h2 id="drift-title">Most stores weren't built slow.<br><em>They got slow.</em></h2>
          <p>Speed and accessibility rarely break in one bad release. They wear down a little with every change, which is why a one-off fix doesn't last and a monthly check does.</p>
        </div>

        <div class="service-grid-3">
          <div class="service-deliverable-card">
            <p class="service-card-num">01 · APPS</p>
            <h3 class="service-card-title">Every install adds weight</h3>
            <p class="service-card-text">Review widgets, pop-ups, search and upsell apps each bring their own scripts and markup. They're among the most common sources of both slow pages and accessibility failures we find, and uninstalled apps often leave code behind.</p>
          </div>
          <div class="service-deliverable-card">
            <p class="service-card-num">02 · MARKETING</p>
            <h3 class="service-card-title">Tags multiply quietly</h3>
            <p class="service-card-text">A second analytics property here, a heatmap tool there. It's common to find several overlapping trackers on every page, sometimes firing before cookie consent is even set.</p>
          </div>
          <div class="service-deliverable-card">
            <p class="service-card-num">03 · CONTENT</p>
            <h3 class="service-card-title">New pages skip the checks</h3>
            <p class="service-card-text">Landing pages, guides and campaign sections ship fast, usually without anyone checking headings, alt text, contrast, keyboard access or load time.</p>
          </div>
        </div>
      </section>

      <!-- THE NUMBERS -->
      <section class="reveal care-numbers" aria-labelledby="numbers-title">
        <div class="service-section-header">
          <p class="section-eyebrow">Why it matters</p>
          <h2 id="numbers-title">The numbers behind<br><em>the decision.</em></h2>
          <p>Every figure here links to its source, so you can check it yourself.</p>
        </div>

        <ul class="care-stats">
          {stats.map((s) => (
            <li class="care-stat">
              <p class="care-stat-val">{s.val}</p>
              <p class="care-stat-text">{s.text}</p>
              <a class="care-source" href={s.src.url}>{s.src.label}</a>
            </li>
          ))}
        </ul>
        <p class="care-footnote">Speed pays off in sales, too: when Vodafone improved Largest Contentful Paint by 31% in an A/B test, sales rose 8% (<a class="care-source" href={SOURCES.vodafone.url}>{SOURCES.vodafone.label}</a>).</p>
      </section>

      <!-- WHAT WE LOOK AFTER -->
      <section class="reveal" aria-labelledby="pillars-title">
        <div class="service-section-header">
          <p class="section-eyebrow">What we look after</p>
          <h2 id="pillars-title">Three areas. Pick one,<br><em>or let us handle all of them.</em></h2>
          <p>Each area has a clear monthly routine and its own share of fix hours. Combine them in the plan builder below.</p>
        </div>

        <div class="service-grid-3">
          {CARE.areas.map((area, i) => (
            <div class="service-deliverable-card">
              <p class="service-card-num">{String(i + 1).padStart(2, '0')} · {area.name.toUpperCase()}</p>
              <h3 class="service-card-title">{area.tagline}</h3>
              <ul class="care-list">
                {area.includes.growth.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- ADA HONESTY -->
      <section class="reveal care-honest" aria-labelledby="ada-title">
        <div class="service-section-header">
          <p class="section-eyebrow">ADA, honestly</p>
          <h2 id="ada-title">There's no ADA certificate.<br><em>Here's what actually protects you.</em></h2>
          <p>A lot of accessibility marketing sells certainty that doesn't exist. This is how we approach it instead.</p>
        </div>

        <div class="care-compare">
          <div class="care-compare-col care-compare-col--no">
            <h3 class="care-compare-title">What we won't tell you</h3>
            <ul>
              <li><strong>That your store is "ADA certified".</strong> No official certification exists for websites.</li>
              <li><strong>That an overlay widget makes you compliant.</strong> Overlays don't fix the code underneath, and stores using them are still sued every month. In 2025 the FTC fined one overlay vendor $1 million for claiming its widget made sites compliant (<a class="care-source" href={SOURCES.ftc.url}>{SOURCES.ftc.label}</a>; see also the <a class="care-source" href={SOURCES.overlays.url}>{SOURCES.overlays.label}</a>).</li>
              <li><strong>That you're lawsuit-proof.</strong> Anyone can file. What matters is how well you can show the work.</li>
            </ul>
          </div>
          <div class="care-compare-col care-compare-col--yes">
            <h3 class="care-compare-title">What we will do</h3>
            <ul>
              <li><strong>Bring in-scope pages to WCAG 2.2 AA,</strong> the standard demand letters and settlements measure against.</li>
              <li><strong>Test by hand</strong> with a keyboard and real screen readers, not just automated scanners.</li>
              <li><strong>Document everything:</strong> an accessibility statement, a conformance report and a dated log of every issue and fix.</li>
              <li><strong>Keep it current</strong> as your store, apps and content change.</li>
            </ul>
          </div>
        </div>
        <p class="care-footnote">We're engineers, not lawyers. Have your legal counsel review your accessibility statement before it's published.</p>
      </section>

      <!-- COMPARE OPTIONS -->
      <section class="reveal care-options" aria-labelledby="options-title">
        <div class="service-section-header">
          <p class="section-eyebrow">Your options</p>
          <h2 id="options-title">Four ways stores handle this.<br><em>Compared honestly.</em></h2>
          <p>Costs for the first three are typical market ranges, not our prices.</p>
        </div>

        <div class="care-table-wrap" role="region" aria-labelledby="options-title" tabindex="0">
          <table class="care-table">
            <thead>
              <tr>
                <td></td>
