  <script>
    type Range = { min: number; max: number; hours?: number };
    type Area = { id: string; name: string; essentials: Range; growth: Range; baseline: Range; includes: Record<string, string[]> };
    type Level = { id: string; name: string; includes: string[] };
    type Term = { id: string; label: string; baselineFactor: number };
    type Project = { id: string; name: string; min: number; max: number; time: string };
    type Preset = { id: string; label: string; areas: string[]; level: string; term: string; projects: string[] };
    type Care = { areas: Area[]; levels: Level[]; terms: Term[]; projects: Project[]; presets: Preset[] };

    const DATA: Care = JSON.parse(document.getElementById('careData')!.textContent || '{}');
    const form = document.getElementById('careForm') as HTMLFormElement;
    const $ = (id: string) => document.getElementById(id)!;

    const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const range = (min: number, max: number) => (max <= 0 ? '$0' : `${money(min)}–${money(max)}`);
    const roundTo50 = (n: number) => Math.round(n / 50) * 50;

    function readState() {
      const checked = (name: string) =>
        Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((i) => i.value);
      return {
        areas: checked('area'),
        level: checked('level')[0] || 'growth',
        term: checked('term')[0] || '6',
        projects: checked('project')
      };
    }

    function applyState(state: { areas: string[]; level: string; term: string; projects: string[] }) {
      form.querySelectorAll<HTMLInputElement>('input[name="area"]').forEach((i) => (i.checked = state.areas.includes(i.value)));
      form.querySelectorAll<HTMLInputElement>('input[name="level"]').forEach((i) => (i.checked = i.value === state.level));
      form.querySelectorAll<HTMLInputElement>('input[name="term"]').forEach((i) => (i.checked = i.value === state.term));
      form.querySelectorAll<HTMLInputElement>('input[name="project"]').forEach((i) => (i.checked = state.projects.includes(i.value)));
    }

    function compute(state: ReturnType<typeof readState>) {
      const areas = DATA.areas.filter((a) => state.areas.includes(a.id));
      const level = state.level as 'essentials' | 'growth';
      const term = DATA.terms.find((t) => t.id === state.term) || DATA.terms[1];
      const projects = DATA.projects.filter((p) => state.projects.includes(p.id));
      const sum = (list: Range[], key: 'min' | 'max' | 'hours') => list.reduce((s, r) => s + (r[key] || 0), 0);

      const monthly = { min: sum(areas.map((a) => a[level]), 'min'), max: sum(areas.map((a) => a[level]), 'max') };
      const hours = sum(areas.map((a) => a[level]), 'hours');
      const baselineFull = { min: sum(areas.map((a) => a.baseline), 'min'), max: sum(areas.map((a) => a.baseline), 'max') };
      const baseline = { min: roundTo50(baselineFull.min * term.baselineFactor), max: roundTo50(baselineFull.max * term.baselineFactor) };
      const oneTime = { min: projects.reduce((s, p) => s + p.min, 0), max: projects.reduce((s, p) => s + p.max, 0) };

      const levelMeta = DATA.levels.find((l) => l.id === level)!;
      const includes = [...areas.flatMap((a) => a.includes[level]), ...levelMeta.includes];

      return { areas, level: levelMeta, term, projects, monthly, hours, baseline, baselineFull, oneTime, includes };
    }

    function planName(state: ReturnType<typeof readState>) {
      const preset = DATA.presets.find((p) => sameState(p, state));
      if (preset) return preset.label;
      const names = DATA.areas.filter((a) => state.areas.includes(a.id)).map((a) => a.name);
      return names.length ? names.join(' + ') : 'No areas yet';
    }

    function sameState(p: Preset, s: ReturnType<typeof readState>) {
      const eq = (a: string[], b: string[]) => a.length === b.length && a.every((x) => b.includes(x));
      return eq(p.areas, s.areas) && p.level === s.level && p.term === s.term && eq(p.projects, s.projects);
    }

    function setText(id: string, text: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    let announceTimer: ReturnType<typeof setTimeout> | undefined;
    let ready = false;

    function update() {
      const state = readState();
      const r = compute(state);
      const hasAreas = r.areas.length > 0;

      setText('careSummaryTitle', `${r.level.name} · ${planName(state)}`);
      setText('careMonthly', hasAreas ? range(r.monthly.min, r.monthly.max) : '—');
      setText('careMonthlyNote', hasAreas ? 'Fixed quote inside this range after a free review.' : 'Pick at least one area in step 1.');
      setText('careHours', hasAreas ? `~${r.hours} hrs incl. fixes` : '—');
      setText('careTerm', r.term.label);
      if (!hasAreas) setText('careBaseline', '—');
      else if (r.term.baselineFactor === 0) setText('careBaseline', `Included (was ${range(r.baselineFull.min, r.baselineFull.max)})`);
      else setText('careBaseline', range(r.baseline.min, r.baseline.max) + (r.term.baselineFactor < 1 ? ' (50% off)' : ''));
      setText('careProjects', r.projects.length ? range(r.oneTime.min, r.oneTime.max) : 'None');
      setText('careMobileVal', hasAreas ? `${range(r.monthly.min, r.monthly.max)}/mo` : 'Pick an area');
      $('areaError').hidden = hasAreas;

      const list = $('careIncludes');
      list.replaceChildren(...(hasAreas ? r.includes : ['Pick at least one area to see what’s included.']).map((text) => {
        const li = document.createElement('li');
        li.textContent = text;
        return li;
      }));

      // Per-level ranges on the coverage cards, for the areas picked so far.
      DATA.levels.forEach((level) => {
        const alt = compute({ ...state, level: level.id });
        document.querySelectorAll(`[data-level-range="${level.id}"]`).forEach((el) => {
          el.textContent = hasAreas ? `${range(alt.monthly.min, alt.monthly.max)}/mo` : 'Pick an area';
        });
        document.querySelectorAll(`[data-level-hours="${level.id}"]`).forEach((el) => {
          el.textContent = hasAreas ? `~${alt.hours} hrs/mo` : '';
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.care-preset').forEach((btn) => {
        const preset = DATA.presets.find((p) => p.id === btn.dataset.preset);
        btn.setAttribute('aria-pressed', String(!!preset && sameState(preset, state)));
      });

      updateLinks(state, r);
      syncUrl(state);

      if (ready) {
        clearTimeout(announceTimer);
        announceTimer = setTimeout(() => {
          setText('careLive', hasAreas
            ? `Estimate updated: ${range(r.monthly.min, r.monthly.max)} per month, about ${r.hours} hours.`
            : 'No areas selected. Pick at least one area to see an estimate.');
        }, 700);
      }
    }

    function planMessage(state: ReturnType<typeof readState>, r: ReturnType<typeof compute>) {
      const name = (($('careName') as HTMLInputElement).value || '').trim();
      const store = (($('careStore') as HTMLInputElement).value || '').trim();
      const notes = (($('careNotes') as HTMLTextAreaElement).value || '').trim();

      const lines = [
        name ? `Hi Atul, this is ${name}.` : 'Hi Atul,',
        `I built a performance & accessibility retainer plan${store ? ` for ${store}` : ''}:`,
        '',
        `• Plan: ${r.level.name} · ${r.areas.map((a) => a.name).join(' + ') || 'no areas yet'}`,
        `• Estimate: ${r.areas.length ? range(r.monthly.min, r.monthly.max) + '/month' : '—'} (~${r.hours} hrs)`,
        `• Term: ${r.term.label}`,
        `• Baseline audit: ${r.term.baselineFactor === 0 ? 'included' : range(r.baseline.min, r.baseline.max)}`,
      ];
      if (r.projects.length) lines.push(`• One-time: ${r.projects.map((p) => p.name).join(', ')} (${range(r.oneTime.min, r.oneTime.max)})`);
      if (notes) lines.push('', `Notes: ${notes}`);
      lines.push('', `Plan link: ${shareUrl(state)}`, '', 'Could we set up a review call?');
      return lines.join('\n');
    }

    function updateLinks(state: ReturnType<typeof readState>, r: ReturnType<typeof compute>) {
      const msg = planMessage(state, r);
      const store = (($('careStore') as HTMLInputElement).value || '').trim();
      ($('careWhatsApp') as HTMLAnchorElement).href = `https://wa.me/919259598769?text=${encodeURIComponent(msg)}`;
      const subject = `Retainer plan — ${r.level.name}${store ? ` — ${store}` : ''}`;
      ($('careEmail') as HTMLAnchorElement).href = `mailto:atul@klickspell.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(msg)}`;
    }

    function shareUrl(state: ReturnType<typeof readState>) {
      const url = new URL(window.location.href);
      url.search = '';
      url.hash = 'build';
      url.searchParams.set('areas', state.areas.join(','));
      url.searchParams.set('level', state.level);
      url.searchParams.set('term', state.term);
      url.searchParams.set('projects', state.projects.join(','));
      return url.toString();
    }

    function syncUrl(state: ReturnType<typeof readState>) {
      if (!ready) return;
      const url = new URL(shareUrl(state));
      url.hash = window.location.hash;
      history.replaceState(null, '', url);
    }

    function stateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      if (!params.has('level')) return null;
      const pick = (key: string, valid: string[]) =>
        (params.get(key) || '').split(',').filter((v) => valid.includes(v));
      const level = params.get('level') || '';
      const term = params.get('term') || '';
      return {
        areas: pick('areas', DATA.areas.map((a) => a.id)),
        level: DATA.levels.some((l) => l.id === level) ? level : 'growth',
        term: DATA.terms.some((t) => t.id === term) ? term : '6',
        projects: pick('projects', DATA.projects.map((p) => p.id))
      };
    }

    // Wire up
    const fromUrl = stateFromUrl();
    if (fromUrl) applyState(fromUrl);

    form.addEventListener('change', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    ['careName', 'careStore', 'careNotes'].forEach((id) =>
      $(id).addEventListener('input', () => updateLinks(readState(), compute(readState())))
    );

    document.querySelectorAll<HTMLButtonElement>('.care-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const preset = DATA.presets.find((p) => p.id === btn.dataset.preset);
        if (!preset) return;
        applyState(preset);
        update();
      });
    });

    $('careShare').addEventListener('click', async () => {
      const link = shareUrl(readState());
      try {
        await navigator.clipboard.writeText(link);
        setText('careShare', 'Link copied ✓');
        setText('careLive', 'Link to this plan copied to the clipboard.');
      } catch {
        window.prompt('Copy this link to your plan:', link);
      }
      setTimeout(() => setText('careShare', 'Copy a link to this plan'), 2500);
    });

    // Mobile bar: shown while choosing in the builder, hidden once the summary is on screen.
    const bar = $('careMobileBar');
    let builderVisible = false;
    let summaryVisible = false;
    const toggleBar = () => { bar.hidden = !(builderVisible && !summaryVisible); };
    new IntersectionObserver(([e]) => { builderVisible = e.isIntersecting; toggleBar(); }).observe(form);
    new IntersectionObserver(([e]) => { summaryVisible = e.isIntersecting; toggleBar(); }).observe($('careSummary'));

    update();
    ready = true;
  </script>
</BaseLayout>
