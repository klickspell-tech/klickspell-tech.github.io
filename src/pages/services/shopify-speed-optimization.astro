---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ServiceDetailHero from '../../components/ServiceDetailHero.astro';
import ServiceFeatures from '../../components/ServiceFeatures.astro';
import ServiceCaseStudy from '../../components/ServiceCaseStudy.astro';
import ServiceStats from '../../components/ServiceStats.astro';
import ServiceIntegrity from '../../components/ServiceIntegrity.astro';
import ServiceCtaBand from '../../components/ServiceCtaBand.astro';
import Faq from '../../components/Faq.astro';

const canonical = "https://klickspell.com/services/shopify-speed-optimization";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Shopify Speed Optimization & Core Web Vitals Engineering",
  "serviceType": "Web Performance Optimization",
  "provider": {
    "@type": "Organization",
    "name": "Klickspell",
    "url": "https://klickspell.com/"
  },
  "description": "A 90+ mobile PageSpeed target agreed after a free audit, passing Core Web Vitals, minimal layout shift and main-thread blocking for high-growth Shopify and DTC brands.",
  "areaServed": "Global",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Shopify Speed Optimization Sprint",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Full Shopify Core Web Vitals Audit & Remediation"
        }
      }
    ]
  }
};

const faqs = [
  {
    "q": "Do you guarantee a 90+ Mobile PageSpeed score?",
    "a": "Not blindly. Some apps, embeds and third-party scripts set a ceiling that no one can engineer past. What we do guarantee is the target we agree after auditing your store: it's written into the proposal, and if we miss it because of our code or recommendations, we keep optimizing at no extra cost. We also measure real-user Core Web Vitals, not just the lab score."
  },
  {
    "q": "How does Klickspell differ from cheap '90+ speed' optimization gigs on Fiverr?",
    "a": "Cheap speed services often use bot cloaking scripts that detect Google Lighthouse bots and hide all apps from testing tools while real human visitors still experience 5+ seconds of lag. Klickspell never uses bot tricks: we refactor Liquid directly, purge zombie app scripts, conditionally load assets, and measure success through real-user Chrome UX Report (CrUX) Core Web Vitals."
  },
  {
    "q": "Will optimizing store speed break our marketing or tracking apps?",
    "a": "No. We never delete essential tracking scripts like Meta Pixel, TikTok Pixel, Klaviyo, or Google Analytics. Instead, we schedule third-party scripts to run during idle time or after key user interactions, keeping analytics accurate while freeing up the main thread."
  },
  {
    "q": "Do you work on our live production store?",
    "a": "Never. All engineering, refactoring, and benchmarking is executed in an unpublished duplicate preview theme. Your live customers and checkout will experience zero downtime or disruption until you personally test and approve the speed improvements."
  },
  {
    "q": "How long does a Shopify speed sprint take?",
    "a": "A standard speed sprint takes 2 to 3 weeks from initial diagnostic audit to final production theme handover."
  },
  {
    "q": "Why shouldn't I just use a Shopify speed optimization app?",
    "a": "Speed optimizer apps typically inject heavy JavaScript that hides DOM elements or preloads resources indiscriminately. They often \"trick\" desktop synthetic tests while worsening real-world mobile CPU load and charging you a monthly subscription. We fix the underlying source code cleanly with zero recurring app fees."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://klickspell.com/services" },
    { "@type": "ListItem", "position": 3, "name": "Shopify Speed Optimization", "item": canonical }
  ]
};

const schemas = [serviceSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Shopify Speed Optimization — 90+ Mobile PageSpeed | Klickspell"
  description="We engineer sluggish Shopify stores into sub-second revenue engines. A 90+ mobile target agreed in writing, passing Core Web Vitals, and zero app breaks."
  canonical={canonical}
  ogImage="https://klickspell.com/assets/og-card.png"
  schema={schemas}
>
  <Nav />

  <main id="main-content">
    <!-- HERO SECTION -->
    <ServiceDetailHero
      crumb="Shopify Speed Optimization"
      copyMax={634}
      artAlign="top"
      art={{
        lg: '/assets/speed/speedometer.webp', lgW: 588, lgH: 404,
        sm: '/assets/speed/speedometer.webp', smW: 588, smH: 404,
      }}
      title="Speed that sells.<br />Performance that scales."
      sub="Custom Shopify optimization built to deliver lightning-fast experiences and higher conversions."
      primary={{ label: 'Book A Speed Audit →' }}
      secondary={{ label: 'Read Case Study →', href: '/blog/how-we-achieved-99-pagespeed-score-case-study' }}
      stats={[
        { label: 'Mobile Target', value: '90+ / 100', note: 'Agreed after audit, or we keep optimizing' },
        { label: 'Total Blocking Time', value: '< 200 ms', note: "Our aim: Lighthouse's \"good\" range" },
        { label: 'Delivery Timeline', value: '2–3 Weeks', note: 'Staged duplicate theme with zero live downtime' },
        { label: 'Safety Guarantee', value: '100% Intact', note: 'Analytics, tracking, and vital apps preserved' },
      ]}
    />


    <!-- THE ENGINEERING SPRINT -->
    <ServiceFeatures
      eyebrow="The Engineering Sprint"
      title="What it takes to make"
      titleEm="your store faster."
      sub="We fix the code slowing your store down for faster browsing and smoother checkouts."
      items={[
        { tag: 'Asset & Font Tuning', title: 'Next-Gen Media & Local Fonts', text: 'We convert oversized raster assets to modern WebP formats, eliminate layout shifts with explicit aspect ratios, and replace external render-blocking Google Font chains with self-hosted, preloaded variable fonts.' },
        { tag: 'Script Rescheduling', title: 'App Bloat & Pixel Decoupling', text: 'Klaviyo, Gorgias, reviews, and ad pixels freeze mobile CPUs. We implement intelligent script scheduling that delays non-critical tags until user engagement, keeping tracking 100% accurate while freeing the main thread.' },
        { tag: 'Critical CSS & DOM', title: 'Eliminating Render-Blocking Chains', text: 'We extract and inline critical above-the-fold CSS styles, prune unused vendor styles, and streamline bloated DOM nesting so mobile browsers can paint your hero section much sooner.' },
        { tag: 'Layout Shift Eradication', title: 'CLS Zeroing & Fluid Typography', text: "Unexpected jumps during page load destroy user trust and fail Google's Core Web Vitals. We reserve space for banners, popups, and dynamic app widgets so the layout remains rock-solid." },
        { tag: 'Zero Downtime Testing', title: 'Staged QA & Device Testing', text: 'Every change is implemented in an isolated theme environment. We audit your checkout, cart drawers, currency converters, and subscription flows on physical iOS and Android devices before anything touches production.' },
        { tag: 'Handover & Monitoring', title: 'Full Autonomy & Long-Term Maintenance', text: 'We provide a video walkthrough of every change and a checklist for your marketing team on how to upload future banners and install new apps without hurting your hard-earned 90+ score.' },
      ]}
    />

    <!-- PROVEN AUTHORITY -->
    <ServiceCaseStudy
      boxed
      eyebrow="Proven Authority"
      titleHtml="We don't preach speed.<br /><em>We <i>engineer it daily.</i></em>"
      textHtml="We recently audited and optimized Klickspell itself from the low 70s to a flawless <strong>98/100 on Mobile</strong> and <strong>99/100 on Desktop</strong> with 0ms Total Blocking Time and zero third-party dependencies.<br />The exact same principles applied to California skincare brand <strong>Jaxon Lane</strong> and modern DTC brands are deployed to supercharge your store."
      caseHref="/work/jaxon-lane"
      caseLabel="Read Full Case Study →"
      liveHref="/blog/how-we-achieved-99-pagespeed-score-case-study"
      liveLabel="Read Technical Playbook →"
      liveExternal={false}
      img={{ src: '/assets/projects/jaxon-lane.webp', alt: 'Jaxon Lane Shopify store optimized by Klickspell', width: 2994, height: 2046 }}
    />

    <!-- WHY SPEED MATTERS (every figure links to its source) -->
    <ServiceStats
      eyebrow="Why speed matters"
      title="The numbers behind"
      titleEm="the decision."
      stats={[
        { value: '2.5×', text: 'higher e-commerce conversion rate for sites that load in 1 second than for sites that load in 5 seconds.', source: 'Portent, 2022 (100M+ page views)', href: 'https://www.portent.com/blog/analytics/research-site-speed-hurting-everyone.htm' },
        { value: '+8.4%', text: 'retail conversions from a 0.1-second faster mobile site, across 37 brands.', source: 'Deloitte & Google, Milliseconds Make Millions', href: 'https://web.dev/case-studies/milliseconds-make-millions' },
        { value: '+8%', text: 'sales for Vodafone after improving Largest Contentful Paint by 31% in an A/B test.', source: 'web.dev, Vodafone case study', href: 'https://web.dev/case-studies/vodafone' },
      ]}
      cta={{ label: 'Calculate Your App Bloat →', href: '/speed' }}
    />

    <!-- ENGINEERING INTEGRITY -->
    <ServiceIntegrity
      eyebrow="Engineering Integrity"
      title="Real core web vitals vs."
      titleEm="Cheap “90+ score” Cloaking scams"
      sub="Many speed optimizers game performance scores instead of fixing real issues. Here's how to spot the difference."
      bad={{
        title: 'What Cheap "90+ Speed" Services Do',
        points: [
          { label: 'Bot Cloaking', text: 'Injects scripts that detect Google Lighthouse bots and disable Klaviyo, Meta Pixel, and apps exclusively during synthetic tests.' },
          { label: 'Zero Real Speed', text: 'Real shoppers on 4G mobile devices still wait 5 to 8 seconds for pages to render.' },
          { label: 'Broken Tracking', text: 'Often causes severe tracking drop-offs, misattributed revenue, and broken Meta/TikTok pixel events.' },
          { label: 'CrUX Failure', text: "Fails Google's real-user field data (Chrome UX Report), failing search ranking boosts." },
        ],
      }}
      good={{
        title: 'The Klickspell Architectural Standard',
        points: [
          { label: 'Direct Code Refactoring', text: 'Purges orphaned "zombie" Liquid snippets and dead asset requests left by uninstalled apps.' },
          { label: 'Conditional Scheduling', text: 'Loads review widgets and chat widgets only on pages and interaction moments when needed.' },
          { label: '100% Tracking Integrity', text: 'All marketing pixels and analytics fire accurately without blocking critical initial paint.' },
          { label: 'Passed Real-User CrUX', text: 'Delivers sub-second LCP and near-zero TBT for actual human customers on real mobile devices.' },
        ],
      }}
    />

    <!-- FAQ: shared design, this page's questions -->
    <Faq items={faqs} />

    <!-- CLOSING CTA -->
    <ServiceCtaBand
      title="Ready for a store that loads instantly? Let's audit your speed."
      sub="Book a free 30-minute diagnostic call with lead engineer Atul Bhatt. We will inspect your live store, identify your biggest bottlenecks, and give you an exact speed roadmap."
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .speed-numbers { margin-bottom:5rem; }
  .speed-stats { list-style:none; display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem; }
  .speed-stat { background:var(--white); border:.5px solid var(--border); border-radius:var(--radius); padding:1.75rem; display:flex; flex-direction:column; gap:.6rem; }
  .speed-stat-val { font-family:'Instrument Serif',serif; font-size:clamp(38px,4vw,48px); line-height:1; color:var(--accent); }
  .speed-stat-text { font-size:14.5px; color:var(--text-mid); line-height:1.6; flex:1; }
  .speed-source { color:var(--accent-hover); font-size:12.5px; font-weight:600; text-decoration:underline; text-underline-offset:3px; }
  .speed-source:hover { color:var(--accent); }
  @media (max-width:980px) { .speed-stats { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:680px) { .speed-stats { grid-template-columns:1fr; } }
</style>
