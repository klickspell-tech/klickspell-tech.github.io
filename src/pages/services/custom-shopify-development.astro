---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ServiceDetailHero from '../../components/ServiceDetailHero.astro';
import ServiceFeatures from '../../components/ServiceFeatures.astro';
import ServiceCaseStudy from '../../components/ServiceCaseStudy.astro';
import Faq from '../../components/Faq.astro';
import { faqPageSchema } from '../../lib/faqs';
import ServiceCta from '../../components/ServiceCta.astro';

const canonical = "https://klickspell.com/services/custom-shopify-development";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Custom Shopify Theme & Liquid Development",
  "serviceType": "E-Commerce Web Development",
  "provider": {
    "@type": "Organization",
    "name": "Klickspell",
    "url": "https://klickspell.com/"
  },
  "description": "Custom Shopify Liquid themes and modular customizer sections. Engineered for maximum speed, complete marketing team autonomy, and zero page-builder bloat.",
  "areaServed": "Global",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Shopify Engineering Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Custom Shopify 2.0 Theme Architecture & Migration"
        }
      }
    ]
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://klickspell.com/services" },
    { "@type": "ListItem", "position": 3, "name": "Custom Shopify Development", "item": canonical }
  ]
};

// Page-specific questions (the four in the Figma for this page); they drive both the FAQ
// section and the FAQPage schema, so the two never drift apart.
const faqs = [
  {
    q: "Can our non-technical team edit content and layouts after handover?",
    a: "Yes, 100%. Every section we build connects directly into Shopify's native Theme Customizer. Your marketing and product teams can change banners, copy, product grids, testimonials, and colors without touching a single line of code or paying for page-builder apps.",
  },
  {
    q: "Do you use off-the-shelf templates or build custom?",
    a: "We engineer custom themes tailored directly to your brand guidelines, product catalogs, and conversion goals. If you already have an existing theme (e.g. Dawn, Prestige, Empire), we refactor and build custom modular sections that integrate cleanly.",
  },
  {
    q: "Do you handle custom checkout, subscriptions, and app integrations?",
    a: "Yes. We have deep experience integrating Recharge subscription flows, Klaviyo segmentation, Judge.me/Yotpo reviews, custom bundle builders, and affiliate tracking systems like Awin.",
  },
  {
    q: "Are we locked into an agency retainer after launch?",
    a: "No. Our core philosophy is building for complete client autonomy. We provide thorough documentation, clean Git repositories, and a personalized video handover so you are never held hostage by an agency retainer.",
  },
];

const faqSchema = faqPageSchema(faqs);

const schemas = [serviceSchema, faqSchema, breadcrumbSchema];
---

<BaseLayout
  title="Custom Shopify Theme Development Agency | Klickspell"
  description="Custom Shopify Liquid themes built for brands that refuse to compromise. Zero page-builder bloat, native Theme Customizer sections, and complete handover."
  canonical={canonical}
  ogImage="https://klickspell.com/assets/og-card.png"
  schema={schemas}
>
  <Nav />

  <main id="main-content">
    <!-- HERO SECTION -->
    <ServiceDetailHero
      crumb="Custom Shopify Themes"
      title="Shopify stores built to convert and scale"
      sub="Break free from rigid templates and clunky page builders. Get a custom Shopify 2.0 theme with flexible, editable sections that put your marketing team in control—no developer needed."
      primary={{ label: 'Free Scoping Call →' }}
      secondary={{ label: 'See Jaxon Lane Case Study →', href: '/work/jaxon-lane' }}
      art={{
        lg: '/assets/shopify/shopping-bag-lg.webp', lgW: 452, lgH: 366,
        sm: '/assets/shopify/shopping-bag-sm.webp', smW: 380, smH: 310,
      }}
      artGapSm={[40, 24]}
      stats={[
        { label: 'Architecture', value: 'Shopify 2.0', note: 'Dynamic sections & blocks everywhere' },
        { label: 'Page-Builder Apps', value: '0 Apps', note: 'Zero third-party code injection or recurring fees' },
        { label: 'Client Handover', value: '100% Yours', note: 'Clean Git repo, documentation, and video guide' },
        { label: 'Engineering Access', value: 'Direct', note: 'Collaborate directly with senior developers' },
      ]}
    />




    <!-- CAPABILITIES -->
    <ServiceFeatures
      title="Custom Shopify engineering."
      titleEm="Built from the ground up."
      sub="Everything your DTC brand needs to grow—with cleaner code, faster stores, and seamless checkout experiences."
      items={[
        { tag: 'Custom Liquid Architecture', title: 'Custom 2.0 Theme Engineering', text: 'Pixel-perfect implementation of your Figma or custom designs using modern Shopify Liquid, semantic HTML5, and scoped vanilla CSS. Lightweight, maintainable, and built without framework bloat.' },
        { tag: 'Modular Sections', title: 'Drag-and-Drop Native Customizer', text: 'Every visual component (from hero banners and comparison tables to interactive bundle builders) is built as a reusable Shopify 2.0 section editable right from the native Shopify admin.' },
        { tag: 'Subscriptions & Checkout', title: 'Recharge & Custom Flows', text: 'We build reliable subscribe-and-save workflows, tiered volume discounts, custom bundle selectors, and smooth checkout extensions that maximize Average Order Value (AOV).' },
        { tag: 'Private Apps & APIs', title: 'Custom Integrations & Webhooks', text: 'Connect your ERP, warehouse 3PL, affiliate attribution systems (Awin), or internal CRM systems via Shopify Storefront and Admin GraphQL APIs.' },
        { tag: 'Performance-First Stack', title: 'Built-In 90+ Core Web Vitals', text: 'We build speed into every theme from day one: self-hosted variable typography, optimized WebP graphics, delayed script hydration, and zero layout shift.' },
        { tag: 'Unbiased App Audit', title: 'Clean App Stack Optimization', text: 'We audit your existing plugins and replace redundant monthly subscriptions with clean, lightweight custom Liquid sections. In our experience, this often cuts monthly app fees noticeably.' },
      ]}
    />

    <!-- CLIENT CASE STUDY -->
    <ServiceCaseStudy
      title="Jaxon Lane:"
      titleEm="California Skincare Partner."
      text="We serve as the long-term Shopify engineering partner for California skincare brand Jaxon Lane: architecting custom Recharge subscription flows, migrating affiliate tracking to Awin, and building customizer sections that their marketing team operates daily."
      caseHref="/work/jaxon-lane"
      liveHref="https://jaxonlane.com/"
      img={{ src: '/assets/projects/jaxon-lane.webp', alt: 'Jaxon Lane Shopify custom theme development by Klickspell', width: 2994, height: 2046 }}
    />

    <!-- FAQ: same component as the home and services pages, with this page's questions -->
    <Faq items={faqs} />

    <!-- CLOSING CTA: same component as the services page -->
    <ServiceCta />
  </main>

  <Footer />
</BaseLayout>
