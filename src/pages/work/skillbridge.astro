---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Skillbridge EdTech Platform Case Study — High-Performance Learning Portal & Custom Web Architecture",
    "description": "How Klickspell engineered a fast, responsive EdTech and career acceleration web platform for Skillbridge — led by founder Rajesh Durai (ex-VP upGrad, ex-HP) with custom modular components and clean mobile delivery.",
    "url": "https://klickspell.com/work/skillbridge.html",
    "image": "https://klickspell.com/assets/projects/skillbridge.png",
    "datePublished": "2026-08-15",
    "author": { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
    "publisher": { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
    "about": { "@type": "Organization", "name": "Skillbridge", "url": "https://skillbridge.net/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
      { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://klickspell.com/#work" },
      { "@type": "ListItem", "position": 3, "name": "Skillbridge", "item": "https://klickspell.com/work/skillbridge.html" }
    ]
  }
];
---

<BaseLayout
  title="Skillbridge EdTech Case Study — High-Performance Learning Portal | Klickspell"
  description="How Klickspell engineered a fast, responsive EdTech and career acceleration web platform for Skillbridge — led by founder Rajesh Durai (ex-VP upGrad, ex-HP)."
  canonical="https://klickspell.com/work/skillbridge.html"
  ogImage="https://klickspell.com/assets/projects/skillbridge.png"
  ogType="article"
  schema={schema}
>
  <Nav />

  <main id="main-content">
  <!-- CASE STUDY HERO -->
  <div class="cs-hero">
    <p class="cs-breadcrumb reveal"><a href="/">Home</a> / <a href="/#work">Work</a> / Skillbridge</p>
    <p class="section-eyebrow reveal">Case Study · EdTech &amp; Career Acceleration</p>
    <h1 class="cs-title reveal reveal-delay-1">Bridging ambitious learners<br>with <em>tailored, modular</em> web craft.</h1>
    <p class="cs-sub reveal reveal-delay-2">Skillbridge connects ambitious professionals with career-accelerating educational bootcamps. We partnered directly with founder Rajesh Durai (ex-VP upGrad, ex-HP) to architect a high-performance web experience engineered for clear curriculum discovery and frictionless enrollment.</p>
    <div class="cs-actions reveal reveal-delay-2">
      <a href="https://skillbridge.net/" target="_blank" rel="noopener" class="btn-primary">Visit live site ↗</a>
      <a href="https://cal.com/atul-bhatt-klickspell/30min" class="btn-ghost">Schedule discovery call →</a>
    </div>
    <div class="cs-meta-strip reveal reveal-delay-3">
      <div class="cs-meta-item"><p class="cs-meta-label">Client / Founder</p><p class="cs-meta-value">Rajesh Durai (ex-VP upGrad)</p></div>
      <div class="cs-meta-item"><p class="cs-meta-label">Industry</p><p class="cs-meta-value">EdTech &amp; Learning Platform</p></div>
      <div class="cs-meta-item"><p class="cs-meta-label">Architecture</p><p class="cs-meta-value">Custom Modular UI Architecture</p></div>
      <div class="cs-meta-item"><p class="cs-meta-label">Key Stack</p><p class="cs-meta-value">Modern Frontend · Lean Native Code</p></div>
    </div>
    <div class="cs-hero-image reveal reveal-delay-3">
      <img src="/assets/projects/skillbridge.webp" alt="Skillbridge EdTech Web Platform engineered by Klickspell" decoding="async">
    </div>
  </div>

  <!-- CASE STUDY BODY -->
  <div class="cs-body">

    <!-- 1. EXECUTIVE SUMMARY & STATS -->
    <div class="cs-section reveal">
      <p class="section-eyebrow">Key Deliverables</p>
      <h2>Engineered for clear learning pathways and admissions conversion.</h2>
      <p>In competitive EdTech, student attention is fleeting. Every awkward mobile interaction or cluttered curriculum view lowers inquiry rates. We replaced fragile third-party page-builder plugins with a custom modular component system that keeps course tracks, mentor credentials, and admissions inquiries completely frictionless.</p>
      <div class="about-stats" style="border-top:none; padding-top:1.5rem; justify-content:space-between; flex-wrap:wrap;">
        <div class="stat"><p class="stat-num">0</p><p class="stat-label">Heavy external page-builder plugins</p></div>
        <div class="stat"><p class="stat-num">100<span>%</span></p><p class="stat-label">Custom modular curriculum sections</p></div>
        <div class="stat"><p class="stat-num">Direct</p><p class="stat-label">Founder collaboration with Rajesh Durai</p></div>
      </div>
    </div>

    <!-- 2. THE CHALLENGE -->
    <div class="cs-section reveal">
      <p class="section-eyebrow">The Challenge</p>
      <h2>High curriculum density without visual clutter.</h2>
      <p>Professional bootcamp offerings require deep information density: multi-week syllabi, mentor profiles, pricing schedules, cohort calendars, and career outcomes. Generic templates collapse under this weight, either hiding critical details behind awkward tabs or overwhelming prospective students with endless vertical scrolling.</p>
      <p>Skillbridge needed an architecture that felt light, authoritative, and fast, allowing prospective students to explore tracks, review mentor credentials, and submit inquiries seamlessly from any mobile device.</p>
    </div>

    <!-- 3. THE ENGINEERING SOLUTION -->
    <div class="cs-section reveal">
      <p class="section-eyebrow">The Architecture</p>
      <h2>Tailored modular UI with direct founder collaboration.</h2>
      <p>We designed and engineered a bespoke modular component system tailored to the brand's identity:</p>
      <ul style="margin-top:1rem; padding-left:1.5rem; line-height:1.8; color:var(--text-mid); font-size:15.5px;">
        <li><strong>Dynamic Course Modules:</strong> Clear, interactive curriculum breakdowns that load instantly without heavy external accordion plugins.</li>
        <li><strong>Frictionless Lead Capture:</strong> Conversion-optimized inquiry funnels that capture intent and route student inquiries directly to admissions without drop-offs.</li>
        <li><strong>Uncompromising Web Vitals:</strong> Optimized typography, inline SVGs, and responsive picture tags ensuring lightning-fast mobile paint across throttled connections.</li>
      </ul>
    </div>

    <!-- 4. FOUNDER TESTIMONIAL -->
    <div class="cs-section reveal" style="background:var(--white); border:.5px solid var(--border); border-radius:var(--radius); padding:2.5rem 2rem;">
      <p class="section-eyebrow" style="margin-bottom:.5rem;">Client Words</p>
      <p class="testimonial-quote" style="font-size:18px; line-height:1.65; color:var(--text); margin-bottom:1.5rem;">
        "We hired Atul for one of our web-based projects. He took the time to understand my needs and provided a customized solution that exceeded my expectations. I would highly recommend working with Atul for any web-related project."
      </p>
      <div class="testimonial-author">
        <div class="testimonial-avatar">
          <img src="/assets/testimonials/rajesh-durai.webp" alt="Rajesh Durai" loading="lazy" decoding="async">
        </div>
        <div>
          <p class="testimonial-name">Rajesh Durai</p>
          <p class="testimonial-role">Founder, Skillbridge · ex-VP upGrad · ex-HP</p>
        </div>
      </div>
    </div>

    <!-- NEXT CASE STUDY NAV -->
    <div class="cs-next reveal">
      <div>
        <p class="cs-next-label">Next Case Study</p>
        <p class="cs-next-title">Jaxon Lane — Shopify Subscriptions &amp; Core Web Vitals</p>
      </div>
      <a href="/work/jaxon-lane.html" class="btn-primary">View Case Study →</a>
    </div>

  </div>
  </main>

  <Footer />
</BaseLayout>
