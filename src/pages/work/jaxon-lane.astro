---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Jaxon Lane Shopify Case Study — Subscriptions, Affiliate Tracking & AI-Ready SEO",
    "description": "How Klickspell became skincare brand Jaxon Lane's long-term Shopify development partner — building Recharge subscription flows, migrating affiliate tracking to Awin, and preparing the store for AI search discovery.",
    "url": "https://klickspell.com/work/jaxon-lane.html",
    "image": "https://klickspell.com/assets/projects/jaxon-lane.png",
    "datePublished": "2026-07-07",
    "author": { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
    "publisher": { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
    "about": { "@type": "Organization", "name": "Jaxon Lane", "url": "https://jaxonlane.com/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
      { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://klickspell.com/#work" },
      { "@type": "ListItem", "position": 3, "name": "Jaxon Lane", "item": "https://klickspell.com/work/jaxon-lane.html" }
    ]
  }
];
---

<BaseLayout
  title="Jaxon Lane Shopify Case Study — Subscriptions, Affiliate Tracking & AI-Ready SEO | Klickspell"
  description="How Klickspell became skincare brand Jaxon Lane's long-term Shopify development partner — building Recharge subscription flows, migrating affiliate tracking to Awin, and preparing the store for AI search discovery."
  canonical="https://klickspell.com/work/jaxon-lane.html"
  ogImage="https://klickspell.com/assets/projects/jaxon-lane.png"
  ogType="article"
  schema={schema}
>
  <Nav />

  <main id="main-content">
  <!-- CASE STUDY HERO -->
  <div class="cs-hero">
    <p class="cs-breadcrumb reveal"><a href="/">Home</a> / <a href="/#work">Work</a> / Jaxon Lane</p>
    <p class="section-eyebrow reveal">Case Study · Skincare</p>
    <h1 class="cs-title reveal reveal-delay-1">A Shopify partner that grew<br>with the brand — <em>not just a launch team.</em></h1>
    <p class="cs-sub reveal reveal-delay-2">Jaxon Lane already had a live Shopify store when we started working together in February 2025. What they needed wasn't a rebuild — it was a technical partner who could keep up with subscriptions, attribution, security, and SEO as the brand grew.</p>
    <div class="cs-actions reveal reveal-delay-2">
      <a href="https://jaxonlane.com/" target="_blank" rel="noopener" class="btn-primary">Visit live site ↗</a>
      <a href="#" onclick="event.preventDefault();openYTModal('mRuKJxc2r5Y')" class="btn-ghost">Watch video walkthrough ▶</a>
    </div>
    <div class="cs-meta-strip reveal reveal-delay-3">
      <div class="cs-meta-item"><p class="cs-meta-label">Industry</p><p class="cs-meta-value">Skincare &amp; Beauty</p></div>
      <div class="cs-meta-item"><p class="cs-meta-label">Region</p><p class="cs-meta-value">California, USA</p></div>
      <div class="cs-meta-item"><p class="cs-meta-label">Platform</p><p class="cs-meta-value">Shopify · Recharge · Awin</p></div>
      <div class="cs-meta-item"><p class="cs-meta-label">Partner since</p><p class="cs-meta-value">February 2025</p></div>
    </div>
    <div class="cs-hero-image reveal reveal-delay-3">
      <img src="/assets/projects/jaxon-lane.webp" alt="Jaxon Lane Shopify store built and maintained by Klickspell" decoding="async">
    </div>
  </div>

  <!-- CASE STUDY BODY -->
  <div class="cs-body">

    <div class="cs-section reveal">
      <p class="section-eyebrow">How it started</p>
      <h2>Introduced through a trusted referral.</h2>
      <p>Jaxon Lane was already live on Shopify, with an established skincare brand and growing US audience, when Karan Dubey — who was working in growth at Tealbox Digital, a performance marketing agency we'd already delivered a Webflow project for — introduced us to Jaxon Lane's CEO &amp; Co-Founder, Jen Yu, in February 2025.</p>
      <p>Tealbox was driving the marketing. What Jaxon Lane needed on the development side was a partner who could move at the same pace.</p>
    </div>

    <div class="cs-section reveal">
      <p class="section-eyebrow">The challenge</p>
      <h2>A growing brand needed more than a freelancer.</h2>
      <p>Jaxon Lane wasn't looking for a redesign. Their store was live and their growth was picking up — what they needed was a technical partner who wouldn't disappear after launch. Subscription features had to ship reliably, production issues needed same-day fixes, tracking systems had to migrate without breaking revenue attribution, and the site had to stay technically healthy as campaigns, integrations, and the catalog all grew at once. A one-off freelancer model isn't built for that kind of ongoing pace — so Klickspell became their standing Shopify development partner instead.</p>
    </div>

    <div class="cs-section reveal" style="max-width:none">
      <p class="section-eyebrow">What we built</p>
      <h2 style="max-width:700px">An ongoing partnership, not a single launch.</h2>
      <div class="cs-feature-grid" style="margin-top:2.5rem">
        <div class="cs-feature">
          <h3>Subscriptions &amp; account experience</h3>
          <p>Built a dual-login system spanning Shopify and Recharge accounts, rewrote copy across login and subscription-management flows, and rebuilt the customer portal — including recovering login and rewards functionality that had been lost during a theme upgrade.</p>
        </div>
        <div class="cs-feature">
          <h3>Affiliate &amp; attribution infrastructure</h3>
          <p>Migrated affiliate tracking from ShareASale to Awin: stripped out the legacy code, stood up the new integration, and tested it end-to-end so revenue attribution didn't drop during the switch.</p>
        </div>
        <div class="cs-feature">
          <h3>Product page &amp; content systems</h3>
          <p>Shipped a dynamic third tab on product pages, a product-specific UGC video gallery, a founder's-video section with custom playback controls, a fix for a mobile PDP gallery-scroll bug, and carousel navigation added without touching the underlying theme.</p>
        </div>
        <div class="cs-feature">
          <h3>Site integrity &amp; security</h3>
          <p>Set up Cloudflare with a custom WAF rule to block malicious traffic from specific regions, resolved a malicious-link injection issue, added an SPF record for email deliverability, and shipped cookie-consent tooling — plus same-day fixes, like a Safari login popup that was blocking checkout.</p>
        </div>
        <div class="cs-feature">
          <h3>SEO &amp; AI-search readiness</h3>
          <p>Fixed Google Search Console errors, a missing favicon, and duplicate product URLs in Google Merchant Center — then went further, updating robots.txt and implementing schema markup specifically so Jaxon Lane's pages are readable by AI crawlers like OpenAI's search.</p>
        </div>
        <div class="cs-feature">
          <h3>Continuous iteration</h3>
          <p>Dozens of smaller, steady improvements along the way — homepage rewards sections, footer and testimonial updates, blog formatting fixes, and mobile-view corrections — the kind of ongoing polish that keeps a growing store feeling cared for.</p>
        </div>
      </div>
    </div>

    <div class="cs-section reveal">
      <p class="section-eyebrow">The result</p>
      <h2>Still their Shopify partner, today.</h2>
      <div class="cs-testimonial-wrap">
        <div class="testimonial-card featured">
          <p class="testimonial-quote">Working with Atul was always a delight. His exceptional communication skills, timely delivery of great work, and strong skills made him a pleasure to collaborate with. His curiosity and willingness to step outside his expertise made him a valuable asset to any project.</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar"><img src="/assets/testimonials/jen-yu.webp" alt="Jen Yu" loading="lazy" decoding="async"></div>
            <div><p class="testimonial-name">Jen Yu</p><p class="testimonial-role">CEO &amp; Co-Founder, Jaxon Lane · ex-Google</p></div>
          </div>
        </div>
      </div>
      <p style="margin-top:2rem">More than a year into the relationship, Klickspell remains Jaxon Lane's go-to Shopify developer — for everything from urgent bug fixes to new feature builds.</p>
    </div>

    <div class="cs-section reveal" style="max-width:none">
      <div class="cs-next">
        <div>
          <p class="cs-next-label">See more work</p>
          <p class="cs-next-title">Explore the full portfolio</p>
        </div>
        <a href="/#work" class="btn-secondary">Back to Work ↗</a>
      </div>
    </div>

  </div>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-inner reveal">
      <h2 class="cta-title">Want a Shopify partner<br>who <em>sticks around</em><br>after launch?</h2>
      <h2 class="cta-title-mobile">Want a partner<br>who <em>sticks around?</em></h2>
      <p class="cta-sub">Let's start with a free 30-minute call. No commitment, no templates, no compromises.</p>
      <p class="cta-sub-mobile">Free 30-min call. No commitment. No templates.</p>
      <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" id="cta-d" style="font-size:16px;padding:1rem 2rem;cursor:pointer">Book your free call →</a>
      <a href="https://wa.me/919259598769" class="btn-primary" target="_blank" id="cta-m" style="font-size:16px;padding:1rem 2rem;display:none">💬 Chat on WhatsApp</a>
      <p class="cta-stamp">The craft in every click.</p>
    </div>
  </section>
  </main>

  <Footer />
</BaseLayout>
