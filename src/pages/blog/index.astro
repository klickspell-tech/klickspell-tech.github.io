---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

import { TOPICS } from '../../utils/topics';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};

const canonical = "https://klickspell.com/blog";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Technical Blog & Engineering Insights | Klickspell",
    "description": "Technical deep dives, Shopify Liquid patterns, headless architecture, and e-commerce engineering guides by Klickspell.",
    "url": canonical,
    "publisher": {
      "@type": "Organization",
      "name": "Klickspell",
      "url": "https://klickspell.com/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": canonical }
    ]
  }
];
---

<BaseLayout
  title="Technical Blog & Shopify Engineering Insights | Klickspell"
  description="Technical deep dives, Shopify Liquid patterns, headless architecture, and e-commerce engineering guides by Klickspell."
  canonical={canonical}
  schema={schemas}
>
  <Nav />

  <main id="main-content">
  <div class="blog-hero">
    <p class="cs-breadcrumb"><a href="/">Home</a> / Blog</p>
    <p class="section-eyebrow">Engineering &amp; Insights</p>
    <h1 class="blog-title">Technical writings<br><em>from the craft.</em></h1>
    <p class="blog-sub">Deep dives into Shopify architecture, custom Liquid workflows, headless engineering, and performance optimization.</p>

    <!-- Instant Search Input (WebMCP Declarative Tool) -->
    <div class="blog-search-wrap">
      <form 
        role="search" 
        class="blog-search-box" 
        toolname="search_engineering_articles"
        tooldescription="Search Klickspell engineering publications, architecture deep dives, and tutorials by keyword, tag, or topic."
        onsubmit="event.preventDefault();"
      >
        <svg class="blog-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="search" 
          id="blogSearchInput" 
          name="query"
          class="blog-search-input" 
          placeholder={`Search ${sortedPosts.length} articles by title, tag, or topic (e.g. 'judgeme', 'docker', 'redux')...`} 
          aria-label="Search technical blog articles"
          title="Search technical blog articles"
          autocomplete="off"
        />
        <button type="button" id="blogSearchClear" class="blog-search-clear" aria-label="Clear search" style="display:none;">✕</button>
      </form>
      <p id="blogSearchCount" class="blog-search-count" style="display:none;"></p>
    </div>

    <!-- Topic Navigation Pills -->
    <div style="display:flex; gap:.6rem; flex-wrap:wrap; margin:1.5rem 0 2.5rem;">
      <a href="/blog" class="team-pill-link" style="padding:.45rem 1rem; border-radius:100px; font-size:13px; text-decoration:none; font-weight:600; background:var(--accent); border:1px solid var(--accent); color:var(--white); pointer-events:none;">
        All Topics ({sortedPosts.length})
      </a>
      {Object.values(TOPICS).map((t) => (
        <a
          href={`/blog/topic/${t.slug}`}
          class="team-pill-link"
          style="padding:.45rem 1rem; border-radius:100px; font-size:13px; text-decoration:none; font-weight:600; background:var(--white); border:1px solid var(--border); color:var(--text-mid);"
        >
          {t.shortName}
        </a>
      ))}
    </div>

    {sortedPosts.length === 0 ? (
      <div style="background:var(--white); border:.5px solid var(--border); border-radius:var(--radius); padding:3rem; text-align:center; margin-top:2rem;">
        <p style="font-family:'Instrument Serif',serif; font-size:24px; color:var(--text); margin-bottom:.75rem;">Syncing technical articles...</p>
        <p style="font-size:15px; color:var(--text-mid); max-width:480px; margin:0 auto 1.5rem;">Run <code>npm run sync:devto &lt;username&gt;</code> to automatically import your Dev.to articles or create markdown files in <code>src/content/blog/</code>.</p>
        <a href="/" class="btn-primary" style="display:inline-flex;">Back to Home</a>
      </div>
    ) : (
      <>
        <div id="blogGrid" class="blog-grid">
          {sortedPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="blog-card" data-title={post.data.title.toLowerCase()} data-desc={(post.data.description || '').toLowerCase()} data-tags={(post.data.tags || []).join(' ').toLowerCase()}>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="blog-card-tags">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="blog-tag">{tag}</span>
                  ))}
                </div>
              )}
              <h2 class="blog-card-title">{post.data.title}</h2>
              <p class="blog-card-desc">{post.data.description}</p>
              <div class="blog-card-meta">
                <span>{formatDate(post.data.pubDate)}</span>
                {post.data.readingTime && <span>· {post.data.readingTime}</span>}
                <span class="blog-card-arrow">Read →</span>
              </div>
            </a>
          ))}
        </div>

        <div id="blogEmptyState" style="display:none; background:var(--white); border:.5px solid var(--border); border-radius:var(--radius); padding:4rem 2rem; text-align:center; margin-top:2.5rem;">
          <p style="font-family:'Instrument Serif',serif; font-size:28px; color:var(--text); margin-bottom:.5rem;">No matching articles found</p>
          <p style="font-size:15px; color:var(--text-mid); max-width:420px; margin:0 auto 1.5rem;">Try searching for a different keyword like <em>shopify</em>, <em>react</em>, <em>docker</em>, <em>pagespeed</em>, or <em>git</em>.</p>
          <button id="blogResetSearchBtn" class="btn-primary" style="display:inline-flex; cursor:pointer;">Clear Search Filter</button>
        </div>
      </>
    )}
  </div>
  </main>

  <script is:inline>
    (function() {
      const searchInput = document.getElementById('blogSearchInput');
      const clearBtn = document.getElementById('blogSearchClear');
      const countEl = document.getElementById('blogSearchCount');
      const cards = document.querySelectorAll('.blog-card');
      const emptyState = document.getElementById('blogEmptyState');
      const resetBtn = document.getElementById('blogResetSearchBtn');
      const totalCount = cards.length;

      if (!searchInput || !cards.length) return;

      function filterArticles() {
        const query = searchInput.value.trim().toLowerCase();
        let matched = 0;

        if (!query) {
          clearBtn.style.display = 'none';
          countEl.style.display = 'none';
          cards.forEach(c => c.style.display = '');
          if (emptyState) emptyState.style.display = 'none';
          return;
        }

        clearBtn.style.display = 'block';

        cards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          const tags = card.getAttribute('data-tags') || '';
          const text = title + ' ' + desc + ' ' + tags;

          if (text.includes(query)) {
            card.style.display = '';
            matched++;
          } else {
            card.style.display = 'none';
          }
        });

        countEl.style.display = 'block';
        countEl.textContent = `Showing ${matched} of ${totalCount} articles for "${query}"`;

        if (emptyState) {
          emptyState.style.display = matched === 0 ? 'block' : 'none';
        }
      }

      searchInput.addEventListener('input', filterArticles);

      function clearSearch() {
        searchInput.value = '';
        filterArticles();
        searchInput.focus();
      }

      clearBtn.addEventListener('click', clearSearch);
      if (resetBtn) resetBtn.addEventListener('click', clearSearch);

      // WebMCP (Web Model Context Protocol) Imperative Tool Registration for AI Browsing Agents
      (function registerWebMCP() {
        const mc = (typeof navigator !== 'undefined' && navigator.modelContext) || 
                   (typeof window !== 'undefined' && window.modelContext);
        if (mc && typeof mc.registerTool === 'function') {
          try {
            mc.registerTool({
              name: 'search_engineering_articles',
              description: 'Search Klickspell engineering publications, architecture deep dives, and tutorials by keyword, tag, or topic.',
              inputSchema: {
                type: 'object',
                properties: {
                  query: {
                    type: 'string',
                    description: 'Search term or topic (e.g. shopify, react, docker, liquid)'
                  }
                },
                required: ['query']
              },
              execute: ({ query }) => {
                if (typeof query === 'string') {
                  searchInput.value = query;
                  filterArticles();
                }
                const visible = document.querySelectorAll('.blog-card:not([style*="display: none"])');
                return { status: 'success', query, count: visible.length };
              }
            });
          } catch (e) {
            console.debug('WebMCP registration:', e);
          }
        }
      })();
    })();
  </script>

  <Footer />
</BaseLayout>
