---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getPostTopic } from '../../utils/topics';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const topic = getPostTopic(post.data.tags || []);
const canonical = post.data.canonicalUrl || `https://klickspell.com/blog/${post.slug}`;
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": post.data.title,
  "description": post.data.description,
  "url": `https://klickspell.com/blog/${post.slug}`,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  },
  "image": post.data.coverImage || "https://klickspell.com/assets/og-card.png",
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "inLanguage": "en-US",
  "keywords": (post.data.tags || []).join(', '),
  "about": topic.entities,
  "author": {
    "@type": "Person",
    "name": post.data.author || "Atul Bhatt",
    "url": "https://in.linkedin.com/in/mratulbhatt",
    "jobTitle": "Founder & Lead Web Engineer",
    "worksFor": {
      "@type": "Organization",
      "name": "Klickspell",
      "url": "https://klickspell.com/"
    },
    "sameAs": [
      "https://in.linkedin.com/in/mratulbhatt",
      "https://github.com/atulbhatt-system32",
      "https://www.youtube.com/@knowittodaykit"
    ],
    "knowsAbout": [
      "Shopify Theme Architecture",
      "Shopify Speed Optimization",
      "Core Web Vitals",
      "Liquid Templating",
      "React",
      "Headless Commerce"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Klickspell",
    "url": "https://klickspell.com/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://klickspell.com/assets/og-card.png",
      "width": 1200,
      "height": 630
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://klickspell.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://klickspell.com/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": topic.name,
      "item": `https://klickspell.com/blog/topic/${topic.slug}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": post.data.title,
      "item": `https://klickspell.com/blog/${post.slug}`
    }
  ]
};

const allPosts = await getCollection('blog');
const currentTags = post.data.tags || [];
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => {
    const pTags = p.data.tags || [];
    const shared = pTags.filter((t: string) => currentTags.includes(t)).length;
    return { post: p, score: shared };
  })
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 2)
  .map((item) => item.post);

const schemas = [articleSchema, breadcrumbSchema];

// Audio is pre-generated locally (scripts/tts/) and committed under
// public/audio/blog/ - not every post has one, so check at build time
// rather than assume.
const audioPath = fileURLToPath(new URL(`../../../public/audio/blog/${post.slug}.mp3`, import.meta.url));
const hasAudio = existsSync(audioPath);
const audioUrl = `/audio/blog/${post.slug}.mp3`;
---

<BaseLayout
  title={`${post.data.title} | Klickspell Blog`}
  description={post.data.description}
  canonical={canonical}
  ogImage={post.data.coverImage || "https://klickspell.com/assets/og-card.png"}
  ogType="article"
  schema={schemas}
>
  <Nav />
  <div id="readingProgressBar" role="progressbar" aria-label="Reading progress" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

  <main id="main-content">
  <article>
    <header class="post-header">
      <p class="cs-breadcrumb"><a href="/">Home</a> / <a href="/blog">Blog</a> / <a href={`/blog/topic/${topic.slug}`}>{topic.shortName}</a> / {post.data.title}</p>
      
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="blog-card-tags">
          {post.data.tags.map((tag) => (
            <span class="blog-tag">{tag}</span>
          ))}
        </div>
      )}

      <h1 class="post-title">{post.data.title}</h1>

      <div class="post-meta-bar">
        <span>By {post.data.author}</span>
        <span>·</span>
        <span>{formattedDate}</span>
        {post.data.readingTime && (
          <>
            <span>·</span>
            <span>{post.data.readingTime}</span>
          </>
        )}
      </div>

      {hasAudio && (
        <div class="post-audio-player">
          <button type="button" class="audio-play-btn" id="audioPlayBtn" aria-label="Play audio version of this article">
            <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
          </button>
          <div class="audio-player-info">
            <span class="audio-player-label">Listen to this article</span>
            <div class="audio-progress-track" id="audioProgressTrack">
              <div class="audio-progress-fill" id="audioProgressFill"></div>
            </div>
          </div>
          <span class="audio-player-time" id="audioPlayerTime">0:00</span>
          <audio id="postAudioEl" preload="none" src={audioUrl}></audio>
        </div>
      )}

      {post.data.devtoUrl && (
        <div class="canonical-banner">
          <span>💡</span>
          <div>
            <strong>Cross-posted content:</strong> This article is also published on Dev.to. View original on <a href={post.data.devtoUrl} target="_blank" rel="noopener">Dev.to ↗</a>
          </div>
        </div>
      )}

      {post.data.mediumUrl && (
        <div class="canonical-banner">
          <span>💡</span>
          <div>
            <strong>Cross-posted content:</strong> This article is also published on Medium. View original on <a href={post.data.mediumUrl} target="_blank" rel="noopener">Medium ↗</a>
          </div>
        </div>
      )}

      <div class="post-share-bar">
        <span class="share-bar-label">Share:</span>
        <button type="button" class="share-btn" id="copyLinkBtn" aria-label="Copy article link">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span id="copyLinkText">Copy link</span>
        </button>
        <a 
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(canonical)}&via=klickspell`} 
          target="_blank" 
          rel="noopener" 
          class="share-btn" 
          aria-label="Share on X"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>X (Twitter)</span>
        </a>
        <a 
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`} 
          target="_blank" 
          rel="noopener" 
          class="share-btn" 
          aria-label="Share on LinkedIn"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.24c-.9 0-1.63.73-1.63 1.63 0 .9.73 1.63 1.63 1.63.9 0 1.63-.73 1.63-1.63 0-.9-.73-1.63-1.63-1.63Z"/></svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </header>

    <div class="post-body">
      <div class="prose">
        <Content />
      </div>

      {/* CONTEXTUAL IN-ARTICLE CONVERSION CTA */}
      {topic.slug === 'web-performance' ? (
        <div class="in-article-cta">
          <span class="in-article-cta-badge">Mobile Performance Guarantee</span>
          <h3 class="in-article-cta-title">Losing mobile orders to slow page loads?<br><em>We guarantee a 90+ PageSpeed score.</em></h3>
          <p class="in-article-cta-desc">Every 100ms of mobile latency costs conversions and revenue. We audit your JavaScript bloat, decouple marketing trackers, and optimize critical rendering paths without deleting the apps you rely on.</p>
          <div class="in-article-cta-actions">
            <a href="/speed" class="btn-primary">⚡ Test App Bloat Estimator</a>
            <a href="/services/shopify-speed-optimization" class="btn-ghost">View Speed Optimization →</a>
          </div>
        </div>
      ) : topic.slug === 'shopify' ? (
        <div class="in-article-cta">
          <span class="in-article-cta-badge">Custom Shopify Engineering</span>
          <h3 class="in-article-cta-title">Scaling a high-growth Shopify brand?<br><em>Skip fragile apps. Build custom Liquid.</em></h3>
          <p class="in-article-cta-desc">We engineer custom Shopify themes, tailored sections, and high-converting store architectures for brands that refuse to compromise on design, speed, or autonomy.</p>
          <div class="in-article-cta-actions">
            <a href="/services/custom-shopify-development" class="btn-primary">Explore Custom Shopify Dev →</a>
            <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-ghost" style="cursor:pointer">Book Free 30-Min Call ↗</a>
          </div>
        </div>
      ) : (
        <div class="in-article-cta">
          <span class="in-article-cta-badge">Full-Stack Web Engineering</span>
          <h3 class="in-article-cta-title">Need technical precision for your web stack?<br><em>Architected for performance &amp; scale.</em></h3>
          <p class="in-article-cta-desc">From modern headless commerce to enterprise infrastructure and clean frontend state systems, Klickspell delivers senior engineering craft without agency bloat.</p>
          <div class="in-article-cta-actions">
            <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" style="cursor:pointer">Book Free Technical Call →</a>
            <a href="/services/headless-commerce" class="btn-ghost">Explore Headless Engineering ↗</a>
          </div>
        </div>
      )}

      {relatedPosts.length > 0 && (
        <div style="margin-top:4rem; padding-top:2.5rem; border-top:.5px solid var(--border);">
          <p class="section-eyebrow" style="margin-bottom:.75rem">Keep Reading</p>
          <h3 style="font-family:'Instrument Serif',serif; font-size:clamp(26px,3.5vw,34px); font-weight:400; margin-bottom:1.5rem; color:var(--text)">Related Engineering Articles</h3>
          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem; margin-bottom:2.5rem;">
            {relatedPosts.map((rPost) => (
              <a href={`/blog/${rPost.slug}`} class="blog-card" style="text-decoration:none; padding:1.5rem; display:flex; flex-direction:column; justify-content:space-between; background:var(--white); border:.5px solid var(--border); border-radius:var(--radius-sm); transition:border-color .2s, transform .2s;">
                <div>
                  <div style="display:flex; gap:.4rem; flex-wrap:wrap; margin-bottom:.75rem;">
                    {(rPost.data.tags || []).slice(0, 2).map((tag: string) => (
                      <span class="blog-tag">{tag}</span>
                    ))}
                  </div>
                  <h4 class="blog-card-title" style="font-family:'Instrument Serif',serif; font-size:21px; line-height:1.25; margin-bottom:.5rem; color:var(--text);">{rPost.data.title}</h4>
                  <p class="blog-card-desc" style="font-size:13px; color:var(--text-mid); line-height:1.6; margin-bottom:1rem;">{rPost.data.description}</p>
                </div>
                <div class="blog-card-meta" style="display:flex; justify-content:space-between; align-items:center; font-family:var(--font-mono); font-size:11px; color:var(--text-light); padding-top:.75rem; border-top:.5px solid var(--border);">
                  <span>{rPost.data.readingTime || '5 min read'}</span>
                  <span class="blog-card-arrow" style="color:var(--accent); font-weight:700;">Read →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="cs-section" style="max-width:none; padding-top:1.5rem; border-top:.5px solid var(--border);">
        <div class="cs-next">
          <div>
            <p class="cs-next-label">Technical Blog</p>
            <p class="cs-next-title">Explore all 50+ engineering tutorials</p>
          </div>
          <a href="/blog" class="btn-secondary">All Articles ↗</a>
        </div>
      </div>
    </div>
  </article>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-inner">
      <h2 class="cta-title">Looking for custom<br>Shopify engineering <em>craft?</em></h2>
      <h2 class="cta-title-mobile">Let's build<br>your store <em>right.</em></h2>
      <p class="cta-sub">Book a free 30-minute call. We'll talk through your store goals, timeline, and budget.</p>
      <p class="cta-sub-mobile">Free 30-min call · Discuss scope &amp; budget</p>
      <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" id="cta-d" style="font-size:16px;padding:1rem 2rem;cursor:pointer">Book your free call →</a>
      <a href="https://wa.me/919259598769" class="btn-primary" target="_blank" id="cta-m" style="font-size:16px;padding:1rem 2rem;display:inline-flex; align-items:center; justify-content:center; gap:8px;">
        <WhatsAppIcon size={18} fill="#fff" />
        <span>Chat on WhatsApp</span>
      </a>
      <p class="cta-stamp">The craft in every click.</p>
    </div>
  </section>
  </main>

  <Footer />

  <script is:inline>
    (function() {
      // Reading Progress Bar
      const bar = document.getElementById('readingProgressBar');
      const prose = document.querySelector('.prose');
      if (bar && prose) {
        let ticking = false;
        function updateProgress() {
          const rect = prose.getBoundingClientRect();
          const totalHeight = rect.height;
          const scrolled = Math.max(0, -rect.top);
          const percent = Math.min(100, Math.max(0, (scrolled / (totalHeight - window.innerHeight * 0.4)) * 100));
          bar.style.width = percent + '%';
          bar.setAttribute('aria-valuenow', Math.round(percent));
          ticking = false;
        }

        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }, { passive: true });
        updateProgress();
      }

      // Audio Player ("Listen to this article")
      const audioEl = document.getElementById('postAudioEl');
      const playBtn = document.getElementById('audioPlayBtn');
      const progressTrack = document.getElementById('audioProgressTrack');
      const progressFill = document.getElementById('audioProgressFill');
      const timeLabel = document.getElementById('audioPlayerTime');
      if (audioEl && playBtn) {
        const iconPlay = playBtn.querySelector('.icon-play');
        const iconPause = playBtn.querySelector('.icon-pause');
        function formatTime(seconds) {
          if (!isFinite(seconds)) return '0:00';
          const m = Math.floor(seconds / 60);
          const s = Math.floor(seconds % 60).toString().padStart(2, '0');
          return m + ':' + s;
        }
        playBtn.addEventListener('click', function() {
          if (audioEl.paused) {
            audioEl.play();
          } else {
            audioEl.pause();
          }
        });
        audioEl.addEventListener('play', function() {
          iconPlay.style.display = 'none';
          iconPause.style.display = '';
          playBtn.setAttribute('aria-label', 'Pause audio version of this article');
        });
        audioEl.addEventListener('pause', function() {
          iconPlay.style.display = '';
          iconPause.style.display = 'none';
          playBtn.setAttribute('aria-label', 'Play audio version of this article');
        });
        audioEl.addEventListener('ended', function() {
          progressFill.style.width = '0%';
          timeLabel.textContent = formatTime(audioEl.duration);
        });
        audioEl.addEventListener('timeupdate', function() {
          const pct = audioEl.duration ? (audioEl.currentTime / audioEl.duration) * 100 : 0;
          progressFill.style.width = pct + '%';
          timeLabel.textContent = formatTime(audioEl.currentTime);
        });
        audioEl.addEventListener('loadedmetadata', function() {
          timeLabel.textContent = formatTime(audioEl.duration);
        });
        progressTrack.addEventListener('click', function(e) {
          if (!audioEl.duration) return;
          const rect = progressTrack.getBoundingClientRect();
          const pct = (e.clientX - rect.left) / rect.width;
          audioEl.currentTime = pct * audioEl.duration;
        });
      }

      // Copy Link Button with Visual Feedback
      const copyBtn = document.getElementById('copyLinkBtn');
      const copyText = document.getElementById('copyLinkText');
      if (copyBtn && copyText) {
        copyBtn.addEventListener('click', async function() {
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyBtn.classList.add('copied');
            copyText.textContent = '✓ Copied!';
            setTimeout(function() {
              copyBtn.classList.remove('copied');
              copyText.textContent = 'Copy link';
            }, 2200);
          } catch (e) {
            const temp = document.createElement('input');
            temp.value = window.location.href;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            copyBtn.classList.add('copied');
            copyText.textContent = '✓ Copied!';
            setTimeout(function() {
              copyBtn.classList.remove('copied');
              copyText.textContent = 'Copy link';
            }, 2200);
          }
        });
      }
    })();
  </script>
</BaseLayout>
