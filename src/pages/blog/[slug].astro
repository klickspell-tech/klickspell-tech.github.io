---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const canonical = post.data.canonicalUrl || `https://klickspell.com/blog/${post.slug}`;
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": post.data.title,
  "description": post.data.description,
  "url": `https://klickspell.com/blog/${post.slug}`,
  "image": post.data.coverImage || "https://klickspell.com/assets/projects/jaxon-lane.png",
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author || "Atul Bhatt",
    "url": "https://in.linkedin.com/in/mratulbhatt"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Klickspell",
    "url": "https://klickspell.com/"
  }
};
---

<BaseLayout
  title={`${post.data.title} | Klickspell Blog`}
  description={post.data.description}
  canonical={canonical}
  ogImage={post.data.coverImage || "https://klickspell.com/assets/projects/jaxon-lane.png"}
  ogType="article"
  schema={articleSchema}
>
  <Nav />

  <main id="main-content">
  <article>
    <header class="post-header">
      <p class="cs-breadcrumb reveal"><a href="/">Home</a> / <a href="/blog">Blog</a> / {post.data.title}</p>
      
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="blog-card-tags reveal">
          {post.data.tags.map((tag) => (
            <span class="blog-tag">{tag}</span>
          ))}
        </div>
      )}

      <h1 class="post-title reveal reveal-delay-1">{post.data.title}</h1>

      <div class="post-meta-bar reveal reveal-delay-2">
        <span>By {post.data.author}</span>
        <span>·</span>
        <span>{formattedDate}</span>
        {post.data.readingTime && (
          <>
            <span>·</span>
            <span>{post.data.readingTime}</span>
          </>
        )}
      </div>

      {post.data.devtoUrl && (
        <div class="canonical-banner reveal reveal-delay-2">
          <span>💡</span>
          <div>
            <strong>Cross-posted content:</strong> This article is also published on Dev.to. View original on <a href={post.data.devtoUrl} target="_blank" rel="noopener">Dev.to ↗</a>
          </div>
        </div>
      )}

      {post.data.mediumUrl && (
        <div class="canonical-banner reveal reveal-delay-2">
          <span>💡</span>
          <div>
            <strong>Cross-posted content:</strong> This article is also published on Medium. View original on <a href={post.data.mediumUrl} target="_blank" rel="noopener">Medium ↗</a>
          </div>
        </div>
      )}
    </header>

    <div class="post-body">
      <div class="prose reveal reveal-delay-3">
        <Content />
      </div>

      <div class="cs-section reveal" style="max-width:none; margin-top:4rem; padding-top:2rem; border-top:.5px solid var(--border);">
        <div class="cs-next">
          <div>
            <p class="cs-next-label">Technical Blog</p>
            <p class="cs-next-title">Explore more engineering articles</p>
          </div>
          <a href="/blog" class="btn-secondary">All Articles ↗</a>
        </div>
      </div>
    </div>
  </article>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-inner reveal">
      <h2 class="cta-title">Looking for custom<br>Shopify engineering <em>craft?</em></h2>
      <h2 class="cta-title-mobile">Let's build<br>your store <em>right.</em></h2>
      <p class="cta-sub">Let's start with a free 30-minute call. No commitment, no templates, no compromises.</p>
      <p class="cta-sub-mobile">Free 30-min call. No commitment. No templates.</p>
      <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" id="cta-d" style="font-size:16px;padding:1rem 2rem;cursor:pointer">Book your free call →</a>
      <a href="https://wa.me/919259598769" class="btn-primary" target="_blank" id="cta-m" style="font-size:16px;padding:1rem 2rem;display:none">💬 Chat on WhatsApp</a>
      <p class="cta-stamp">The craft in every click.</p>
    </div>
  </section>
  </main>

  <Footer />
</BaseLayout>
