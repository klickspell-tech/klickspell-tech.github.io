---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Brand {
  name: string;
  about: string;
  site: string;
  caseStudy?: string;
  partnership?: string;
}

const groups: { title: string; intro: string; brands: Brand[]; partners?: boolean }[] = [
  {
    title: "Partners",
    intro: "Firms we team up with. They bring us in when a project needs web engineering, and we work as one team with theirs.",
    partners: true,
    brands: [
      { name: "Look Beyond", about: "AI consulting · Singapore", site: "https://lookbeyond.sg/", partnership: "/partners/look-beyond" }
    ]
  },
  {
    title: "Shopify & e-commerce",
    intro: "Our speciality. Custom themes, headless storefronts and the day-to-day work of running an online store.",
    brands: [
      { name: "Jaxon Lane", about: "Skincare · US", site: "https://jaxonlane.com/", caseStudy: "/work/jaxon-lane" },
      { name: "Bounce Back Drinks", about: "Food & beverage · UK", site: "https://bouncebackdrinks.com/" },
      { name: "Under Design", about: "Creative merch · Israel", site: "https://store.weareunder.design/" },
      { name: "Noukai Tokyo", about: "Skincare · Headless on Shopify Hydrogen", site: "https://noukaitokyo.com/", caseStudy: "/work/noukai-tokyo" },
      { name: "Pragya Vijh", about: "Headless commerce on Medusa.js", site: "https://pragyavijh.com/in", caseStudy: "/work/pragya-vijh" },
      { name: "Bambrew", about: "Sustainable packaging", site: "https://www.bambrew.in/" },
      { name: "Easy Rugs", about: "Home decor", site: "https://easyrugs.in/" },
      { name: "Cove & Lane", about: "Fashion & apparel", site: "https://coveandlane.in/", caseStudy: "/work/cove-and-lane" },
      { name: "Taarz", about: "Fashion & apparel", site: "https://taarz.in/" },
      { name: "Haycure Wellness", about: "Wellness & beauty", site: "https://haycurewellness.com/" }
    ]
  },
  {
    title: "Web apps & platforms",
    intro: "Products people log in to and use every day.",
    brands: [
      { name: "Skillbridge", about: "EdTech & career platform", site: "https://skillbridge.net/", caseStudy: "/work/skillbridge" },
      { name: "SourceBae", about: "Talent marketplace", site: "https://sourcebae.com/" },
      { name: "Nuva Gurukul", about: "Education & student enrolment", site: "https://nuvagurukul.com/" }
    ]
  },
  {
    title: "Brand & marketing sites",
    intro: "Websites that explain what a company does and bring in the right people.",
    brands: [
      { name: "DealShare", about: "Corporate & investor site", site: "https://about.dealshare.in/", caseStudy: "/work/dealshare" },
      { name: "CallSara AI", about: "Voice AI platform · Webflow", site: "https://www.callsara.ai/", caseStudy: "/work/callsara-ai" },
      { name: "Tealbox Digital", about: "Performance marketing agency · Webflow", site: "https://tealbox.digital/" },
      { name: "Mogra Media", about: "Creative studio & film production", site: "https://mogramedia.com/", caseStudy: "/work/mogra-media" },
      { name: "ARBC", about: "Business consulting", site: "https://www.arbc.in/" }
    ]
  }
];

const total = groups.filter(g => !g.partners).reduce((n, g) => n + g.brands.length, 0);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Partners & Brands — Klickspell",
    "url": "https://klickspell.com/partners",
    "about": { "@type": "Organization", "name": "Klickspell", "url": "https://klickspell.com/" },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": groups.reduce((n, g) => n + g.brands.length, 0),
      "itemListElement": groups.flatMap(g => g.brands).map((b, i) => ({
        "@type": "ListItem", "position": i + 1,
        "item": { "@type": "Organization", "name": b.name, "url": b.site }
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://klickspell.com/" },
      { "@type": "ListItem", "position": 2, "name": "Partners", "item": "https://klickspell.com/partners" }
    ]
  }
];
---

<BaseLayout
  title="Partners & Brands — Klickspell"
  description={`Klickspell's partners and the ${total} brands we've built for, from Shopify stores and headless commerce to web platforms and brand sites.`}
  canonical="https://klickspell.com/partners"
  schema={schema}
>
  <Nav isHome={false} />

  <main id="main-content">
    <section class="team-hero">
      <p class="cs-breadcrumb reveal"><a href="/">Home</a> / Partners</p>
      <p class="section-eyebrow">Partners &amp; Brands</p>
      <h1 class="team-title">The brands we've<br><em>built with.</em></h1>
      <p class="team-sub">The partners we work alongside, and {total} brands we've built for, from funded startups to Shark Tank India founders and stores in the US, the UK and Israel. Every brand listed is a live project we shipped. Where we've written up the work, you'll find a case study.</p>
    </section>

    {groups.map(group => (
      <section class="partner-group">
        <div class="partner-group-head reveal">
          <h2 class="partner-group-title">{group.title} <span>{group.brands.length}</span></h2>
          <p class="partner-group-intro">{group.intro}</p>
        </div>
        <div class="partner-grid">
          {group.brands.map(brand => (
            <article class="partner-card reveal">
              <h3 class="partner-name">{brand.name}</h3>
              <p class="partner-about">{brand.about}</p>
              <div class="partner-links">
                {brand.partnership && <a href={brand.partnership} class="partner-link partner-link-primary">Partnership →</a>}
                {brand.caseStudy && <a href={brand.caseStudy} class="partner-link partner-link-primary">Case study →</a>}
                <a href={brand.site} target="_blank" rel="noopener" class="partner-link">Visit site ↗</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="cta-section">
      <div class="cta-inner reveal">
        <h2 class="cta-title">Want your brand<br>on this <em>list?</em></h2>
        <p class="cta-sub">Tell us what you're building. We'll start with a free 30-minute call and an honest view of what it takes.</p>
        <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" id="cta-d" style="font-size:16px;padding:1rem 2rem;cursor:pointer">Book your free call →</a>
        <a href="https://wa.me/919259598769" class="btn-primary" target="_blank" id="cta-m" style="font-size:16px;padding:1rem 2rem;display:none">💬 Chat on WhatsApp</a>
        <p class="cta-stamp">The craft in every click.</p>
      </div>
    </section>
  </main>

  <Footer isHome={false} />
</BaseLayout>

<style>
  .partner-group { max-width:1200px; margin:0 auto; padding:0 2rem 4.5rem; }
  .partner-group-head { border-top:.5px solid var(--border); padding-top:2rem; margin-bottom:1.75rem; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.2fr); gap:1rem 3rem; align-items:baseline; }
  .partner-group-title { font-family:'Instrument Serif',serif; font-size:clamp(28px,3.4vw,38px); font-weight:400; color:var(--text); }
  .partner-group-title span { font-family:var(--font-mono); font-size:12px; color:var(--accent); vertical-align:super; margin-left:.25rem; }
  .partner-group-intro { font-size:16px; color:var(--text-mid); line-height:1.7; }
  .partner-grid { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:1.25rem; }
  .partner-card { background:var(--white); border:.5px solid var(--border); border-radius:var(--radius); padding:1.5rem 1.6rem; display:flex; flex-direction:column; transition:border-color .3s, box-shadow .3s, transform .3s; }
  .partner-card:hover { border-color:rgba(58,91,224,0.3); box-shadow:0 16px 40px rgba(0,0,0,0.07); transform:translateY(-3px); }
  .partner-name { font-family:'Instrument Serif',serif; font-size:26px; font-weight:400; line-height:1.15; color:var(--text); }
  .partner-about { font-size:14px; color:var(--text-mid); margin-top:.35rem; flex:1; }
  .partner-links { display:flex; flex-wrap:wrap; gap:1rem; margin-top:1.25rem; }
  .partner-link { font-family:var(--font-mono); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--text-mid); text-decoration:none; transition:color .2s; }
  .partner-link:hover { color:var(--accent); }
  .partner-link-primary { color:var(--accent); }
  .partner-link-primary:hover { color:var(--accent-hover); }

  @media (max-width:900px) {
    .partner-grid { grid-template-columns:repeat(2, minmax(0,1fr)); }
    .partner-group-head { grid-template-columns:1fr; }
  }
  @media (max-width:600px) {
    .partner-group { padding:0 1rem 3.5rem; }
    .partner-grid { grid-template-columns:1fr; }
  }
</style>
