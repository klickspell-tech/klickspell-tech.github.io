---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Klickspell",
    "description": "Klickspell is a web engineering and digital product studio crafting high-performance Shopify stores, Webflow marketing sites, Medusa.js headless commerce, and custom business systems.",
    "url": "https://klickspell.com/",
    "image": "https://klickspell.com/assets/projects/jaxon-lane.png",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Rudrapur",
      "addressRegion": "Uttarakhand",
      "addressCountry": "IN"
    },
    "areaServed": "Worldwide",
    "founder": {
      "@type": "Person",
      "name": "Atul Bhatt"
    },
    "sameAs": [
      "https://in.linkedin.com/in/mratulbhatt",
      "https://github.com/atulbhatt-system32",
      "https://www.youtube.com/@knowittodaykit",
      "https://www.youtube.com/playlist?list=PL1p7vprQFvmus468rKCaHoQvHmaHopMyo"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What services and platforms does Klickspell specialize in?",
        "acceptedAnswer": { "@type": "Answer", "text": "We build across five core pillars: Custom Shopify & Headless E-Commerce, Webflow Marketing & SaaS sites, Headless Commerce (Medusa.js with custom integrations like Cal.com), High-Converting Lead Landing Pages, and Custom Web Applications / ERP Systems (Frappe/ERPNext)." }
      },
      {
        "@type": "Question",
        "name": "How long does a project take?",
        "acceptedAnswer": { "@type": "Answer", "text": "Landing pages and Webflow builds typically launch in 7–14 days. Custom Shopify and full-stack web/e-commerce builds typically go live in 20–30 days depending on scope. You'll get an exact date in your proposal after our discovery call." }
      },
      {
        "@type": "Question",
        "name": "How much does a project cost?",
        "acceptedAnswer": { "@type": "Answer", "text": "Every project is scoped and quoted individually based on your requirements — no fixed one-size-fits-all packages, no hidden markups. You'll know the complete investment before we write a single line of code." }
      },
      {
        "@type": "Question",
        "name": "Will I be able to edit and manage the site myself after launch?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes — that is our core engineering philosophy. Whether on Shopify, Webflow, or custom CMS, every section is designed to be fully editable by your team without needing developer help for everyday changes." }
      },
      {
        "@type": "Question",
        "name": "Can you build custom headless commerce (Medusa.js) or integrate booking engines?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build custom commerce backends using Medusa.js and integrate bespoke workflows such as Cal.com booking flows, custom checkouts, and custom APIs tailored to your exact business model." }
      },
      {
        "@type": "Question",
        "name": "Do you offer post-launch support and maintenance?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every project ends with comprehensive documentation and a walkthrough. For teams that want ongoing peace of mind, we provide ongoing maintenance, optimization, and daily tech management." }
      },
      {
        "@type": "Question",
        "name": "Do you work with international clients outside India?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes — we have built and shipped products for brands across the US, UK, Israel, Japan, and India with seamless async communication and flexible meeting hours." }
      }
    ]
  }
];
---

<BaseLayout
  title="Klickspell — The craft in every click."
  description="Klickspell is a web engineering and digital product studio crafting high-performance Shopify stores, Webflow marketing sites, Medusa.js headless commerce, and custom business systems."
  canonical="https://klickspell.com/"
  ogImage="https://klickspell.com/assets/projects/jaxon-lane.png"
  schema={schema}
>
  <Nav isHome={true} />

  <main id="main-content">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-arc hero-arc-1"></div>
    <div class="hero-arc hero-arc-2"></div>
    <div class="hero-arc hero-arc-3"></div>
    <div class="hero-arc hero-arc-4"></div>
    <div class="floating-cards">
      <div class="float-card fc-1"><div class="fc-dot"></div>Shopify &amp; Headless</div>
      <div class="float-card fc-2"><div class="fc-dot"></div>Webflow &amp; SaaS</div>
      <div class="float-card fc-3"><div class="fc-dot"></div>Medusa &amp; Custom Web</div>
      <div class="float-card fc-4"><div class="fc-dot"></div>20+ Projects shipped</div>
    </div>
    <div class="hero-eyebrow">Web Engineering &amp; Digital Products Studio</div>
    <h1 class="hero-headline">We build the web products<br>you <span class="accent">actually</span><br><span class="dim">imagined.</span></h1>
    <h1 class="hero-headline-mobile">Your product,<br><span class="accent">truly</span> yours.</h1>
    <p class="hero-sub">Custom Shopify stores, high-converting Webflow sites, Medusa.js headless commerce, and tailored web applications. Built for your independence — not our dependency.</p>
    <p class="hero-sub-mobile">Custom Shopify stores, Webflow sites, and web apps built for your independence. No templates. No dependency.</p>
    <div class="hero-actions">
      <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" id="hero-cta-d">Book a free 30-min call →</a>
      <a href="https://wa.me/919259598769" class="btn-primary" target="_blank" id="hero-cta-m">💬 Chat on WhatsApp</a>
      <a href="#work" class="btn-ghost">See our work</a>
    </div>
    <p class="hero-note"><a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' style="color:inherit;text-decoration:underline;text-decoration-style:dotted;text-underline-offset:3px;cursor:pointer">Schedule a free 30-min call</a> · No commitment</p>
    <p class="hero-note-mobile">Free 30-min call · No commitment</p>
  </section>

  <!-- MARQUEE -->
  <div class="clients">
    <p class="clients-label">Brands &amp; Teams We've Built For</p>
    <div class="marquee-track">
      <span class="marquee-item">Skillbridge</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Tealbox Digital</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">CallSara AI</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">DealShare</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Mogra Media</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Jaxon Lane</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Cove &amp; Lane</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Bambrew</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Pragya Vijh</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Nuva Gurukul</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Easy Rugs</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">ARBC</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">SourceBae</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Bounce Back Drinks</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Noukai Tokyo</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Under Design</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Haycure Wellness</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Taarz</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Skillbridge</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Tealbox Digital</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">CallSara AI</span>
    </div>
  </div>

  <!-- SERVICES -->
  <section id="services">
    <div class="section">
      <div class="reveal">
        <p class="section-eyebrow">Our Capabilities</p>
        <h2 class="section-title">Built for your vision,<br><em>not our convenience.</em></h2>
        <p class="section-sub">Every project is engineered around your specific goals, performance benchmarks, and budget. You'll know the full scope and cost before we write a single line of code.</p>
      </div>
      <div class="services-grid reveal reveal-delay-1">
        <div class="service-card">
          <p class="service-num">01 —</p>
          <p class="service-name">Shopify &amp; E-Commerce</p>
          <p class="service-desc">Custom Shopify stores built from the ground up — bespoke Liquid themes, Hydrogen headless builds, and customizer sections you can actually edit without developer help.</p>
          <a href="/services/custom-shopify-development" class="service-learn-more">Explore Custom Shopify →</a>
        </div>
        <div class="service-card">
          <p class="service-num">02 —</p>
          <p class="service-name">Shopify Speed Optimization</p>
          <p class="service-desc">Guaranteed <strong>90+ Mobile PageSpeed scores</strong>, sub-second LCP, and zero main-thread blocking without breaking your analytics, pixels, or essential apps.</p>
          <a href="/services/shopify-speed-optimization" class="service-learn-more">Guaranteed 90+ Speed →</a>
        </div>
        <div class="service-card">
          <p class="service-num">03 —</p>
          <p class="service-name">Headless &amp; Custom Commerce</p>
          <p class="service-desc">Modular commerce powered by <strong>Medusa.js, Next.js, and custom APIs.</strong> Integrated with Cal.com booking flows and tailored checkout experiences.</p>
          <a href="/services/headless-commerce" class="service-learn-more">Explore Headless Architecture →</a>
        </div>
        <div class="service-card">
          <p class="service-num">04 —</p>
          <p class="service-name">Webflow &amp; Visual Development</p>
          <p class="service-desc">World-class Webflow marketing sites for B2B SaaS, tech startups, and agencies. <strong>Fast load speeds, dynamic CMS architecture, and silky interactions.</strong></p>
        </div>
        <div class="service-card">
          <p class="service-num">05 —</p>
          <p class="service-name">Custom Web Apps &amp; ERP Systems</p>
          <p class="service-desc">Full-stack web applications, Frappe &amp; ERPNext business workflow automations, third-party API integrations, and robust cloud DevOps.</p>
        </div>
        <div class="service-cta-card">
          <p class="service-cta-text">Not sure which stack or service fits?<br><em>Let's scope it together.</em></p>
          <button class="service-cta-btn" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}'>Book a free call →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFFERENTIATORS -->
  <div class="diff-section">
    <div class="diff-inner">
      <div class="diff-left reveal">
        <p class="section-eyebrow">Why Klickspell</p>
        <h2 class="section-title">Built to hand<br>over. <em>Fully.</em></h2>
        <p class="section-sub">Most agencies build dependency so you're locked into endless retainers. We engineer for your autonomy. Every project ends with clean code, documentation, and you in complete control.</p>
        <div style="margin-top:2.5rem"><a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" style="cursor:pointer">Book a discovery call →</a></div>
      </div>
      <div class="diff-list reveal reveal-delay-1">
        <div class="diff-item"><span class="diff-num">01</span><div><p class="diff-name">Vision first — zero cookie-cutter templates</p><p class="diff-desc">We start with your unique product requirements and design aspirations, building exactly what fits your business model.</p></div></div>
        <div class="diff-item"><span class="diff-num">02</span><div><p class="diff-name">Truly editable &amp; modular architecture</p><p class="diff-desc">Whether on Shopify, Webflow, or a custom CMS, you get full control over text, media, and layout blocks without code.</p></div></div>
        <div class="diff-item"><span class="diff-num">03</span><div><p class="diff-name">Unbiased tech stack advisory</p><p class="diff-desc">We recommend platforms and third-party tools based strictly on your performance needs and budget — never referral kickbacks.</p></div></div>
        <div class="diff-item"><span class="diff-num">04</span><div><p class="diff-name">Direct access to the engineer</p><p class="diff-desc">You collaborate directly with the lead engineer building your product. No account managers or lost-in-translation briefs.</p></div></div>
      </div>
    </div>
  </div>

  <!-- PORTFOLIO -->
  <section id="work">
    <div class="section">
      <div class="portfolio-header reveal">
        <div>
          <p class="section-eyebrow">Selected Work</p>
          <h2 class="section-title">18+ projects.<br><em>Built across modern stacks.</em></h2>
        </div>
        <div class="portfolio-filters">
          <button class="filter-btn active" data-filter="all">All (18)</button>
          <button class="filter-btn" data-filter="shopify">Shopify (9)</button>
          <button class="filter-btn" data-filter="webflow">Webflow (2)</button>
          <button class="filter-btn" data-filter="headless">Headless &amp; Custom (2)</button>
          <button class="filter-btn" data-filter="landing">Landing &amp; Brand (6)</button>
        </div>
      </div>

      <div class="portfolio-grid" id="portfolioGrid">
        <!-- 1. JAXON LANE (Shopify Featured) -->
        <a href="/work/jaxon-lane.html" class="project-card featured reveal" data-category="shopify">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('mRuKJxc2r5Y')">
              <img src="/assets/projects/jaxon-lane.webp" alt="Jaxon Lane" loading="lazy" decoding="async">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Shopify · US Skincare</span>
          </div>
          <div class="project-body"><div><p class="project-name">Jaxon Lane</p><p class="project-niche">Shopify Custom Theme · US Brand</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 2. TEALBOX DIGITAL (Webflow) -->
        <a href="https://tealbox.digital/" target="_blank" rel="noopener" class="project-card regular reveal reveal-delay-1" data-category="webflow">
          <div class="project-thumb">
            <img src="/assets/projects/tealbox.webp" alt="Tealbox Digital" loading="lazy" decoding="async">
            <span class="project-niche-tag">Webflow · Agency</span>
          </div>
          <div class="project-body"><div><p class="project-name">Tealbox Digital</p><p class="project-niche">Webflow · Performance Marketing Agency</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 3. SKILLBRIDGE (Landing & Brand / EdTech) -->
        <a href="https://skillbridge.net/" target="_blank" rel="noopener" class="project-card featured reveal" data-category="landing">
          <div class="project-thumb">
            <img src="/assets/projects/skillbridge.webp" alt="Skillbridge" loading="lazy" decoding="async">
            <span class="project-niche-tag">EdTech &amp; Career Platform</span>
          </div>
          <div class="project-body"><div><p class="project-name">Skillbridge</p><p class="project-niche">EdTech Platform · Custom Web Application</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 4. DEALSHARE (Landing & Brand) -->
        <a href="https://about.dealshare.in/" target="_blank" rel="noopener" class="project-card regular reveal reveal-delay-1" data-category="landing">
          <div class="project-thumb">
            <img src="/assets/projects/dealshare.webp" alt="DealShare Corporate" loading="lazy" decoding="async">
            <span class="project-niche-tag">Corporate &amp; Investor Portfolio</span>
          </div>
          <div class="project-body"><div><p class="project-name">DealShare</p><p class="project-niche">Corporate Portfolio · E-Grocery Unicorn</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 4. CALLSARA AI (Webflow) -->
        <a href="https://www.callsara.ai/" target="_blank" rel="noopener" class="project-card regular reveal reveal-delay-1" data-category="webflow">
          <div class="project-thumb">
            <img src="/assets/projects/callsara.webp" alt="CallSara AI" loading="lazy" decoding="async">
            <span class="project-niche-tag">Webflow · AI SaaS</span>
          </div>
          <div class="project-body"><div><p class="project-name">CallSara AI</p><p class="project-niche">Webflow · Voice AI Agent Platform</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 5. COVE & LANE (Shopify) -->
        <a href="/work/cove-and-lane.html" class="project-card regular reveal" data-category="shopify">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('Ufh6W6h4Kqo')">
              <img src="/assets/projects/cove-and-lane.webp" alt="Cove &amp; Lane" loading="lazy" decoding="async">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Shopify · Apparel</span>
          </div>
          <div class="project-body"><div><p class="project-name">Cove &amp; Lane</p><p class="project-niche">Shopify Theme &amp; Daily Store Management</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 6. MOGRA MEDIA (Landing Page & Brand Flagship) -->
        <a href="/work/mogra-media.html" class="project-card half reveal reveal-delay-1" data-category="landing">
          <div class="project-thumb">
            <img src="/assets/projects/mogra-media.webp" alt="Mogra Media" loading="lazy" decoding="async">
            <span class="project-niche-tag">Astro v7 · Film &amp; Creative Studio</span>
          </div>
          <div class="project-body"><div><p class="project-name">Mogra Media</p><p class="project-niche">Editorial Brand Flagship &amp; Cinematic Experience</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 7. THE BLISSFUL SOUL / PRAGYA VIJH (Headless & Custom Medusa) -->
        <a href="/work/the-blissful-soul.html" class="project-card half reveal" data-category="headless">
          <div class="project-thumb">
            <img src="/assets/projects/pragya-vijh.webp" alt="The Blissful Soul (Pragya Vijh)" loading="lazy" decoding="async">
            <span class="project-niche-tag">Headless · Next.js + Medusa</span>
          </div>
          <div class="project-body"><div><p class="project-name">The Blissful Soul</p><p class="project-niche">Headless Commerce &amp; Cal.com Booking Ecosystem</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 8. BAMBREW (Shopify) -->
        <a href="https://www.bambrew.in/" target="_blank" rel="noopener" class="project-card half reveal reveal-delay-1" data-category="shopify">
          <div class="project-thumb">
            <img src="/assets/projects/bambrew.webp" alt="Bambrew" loading="lazy" decoding="async">
            <span class="project-niche-tag">Sustainability</span>
          </div>
          <div class="project-body"><div><p class="project-name">Bambrew</p><p class="project-niche">Shopify E-Commerce · Sustainable Packaging</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 9. NUVA GURUKUL (Landing & Brand) -->
        <a href="https://nuvagurukul.com/" target="_blank" rel="noopener" class="project-card half reveal" data-category="landing">
          <div class="project-thumb">
            <img src="/assets/projects/nuva-gurukul.webp" alt="Nuva Gurukul" loading="lazy" decoding="async">
            <span class="project-niche-tag">Education &amp; Lead Gen</span>
          </div>
          <div class="project-body"><div><p class="project-name">Nuva Gurukul</p><p class="project-niche">Education &amp; Student Enrollment Platform</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 10. NOUKAI TOKYO (Headless Shopify Hydrogen) -->
        <a href="/work/noukai-tokyo.html" class="project-card half reveal reveal-delay-1" data-category="headless">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('sMlf7cl_L-o')">
              <img src="/assets/projects/noukai-tokyo.webp" alt="Noukai Tokyo" loading="lazy" decoding="async">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Shopify Hydrogen</span>
          </div>
          <div class="project-body"><div><p class="project-name">Noukai Tokyo</p><p class="project-niche">Headless Hydrogen &amp; 3D Rituals · Japan</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 11. EASY RUGS (Shopify Shark Tank) -->
        <a href="https://easyrugs.in/" target="_blank" rel="noopener" class="project-card half reveal" data-category="shopify">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('s1FYKKLfmbA')">
              <img src="/assets/projects/easy-rugs.webp" alt="Easy Rugs" loading="lazy" decoding="async">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">🦈 Shark Tank India</span>
          </div>
          <div class="project-body"><div><p class="project-name">Easy Rugs</p><p class="project-niche">Home Decor · <span style="color:var(--accent);font-weight:700;">Shark Tank India Featured</span></p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 12. SOURCEBAE (Landing & Brand) -->
        <a href="https://sourcebae.com/" target="_blank" rel="noopener" class="project-card half reveal reveal-delay-1" data-category="landing">
          <div class="project-thumb">
            <img src="/assets/projects/sourcebae.webp" alt="SourceBae" loading="lazy" decoding="async">
            <span class="project-niche-tag">Talent Marketplace</span>
          </div>
          <div class="project-body"><div><p class="project-name">SourceBae</p><p class="project-niche">Talent Marketplace Platform · Seed Stage</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 13. ARBC (Landing & Brand) -->
        <a href="https://www.arbc.in/" target="_blank" rel="noopener" class="project-card half reveal" data-category="landing">
          <div class="project-thumb">
            <img src="/assets/projects/arbc.webp" alt="ARBC" loading="lazy" decoding="async">
            <span class="project-niche-tag">Enterprise &amp; Consulting</span>
          </div>
          <div class="project-body"><div><p class="project-name">ARBC</p><p class="project-niche">Corporate Portfolio · Business Consulting</p></div><div class="project-arrow">↗</div></div>
        </a>

        <!-- 14. BOUNCE BACK DRINKS (Shopify) -->
        <a href="https://bouncebackdrinks.com/" target="_blank" rel="noopener" class="project-card half reveal reveal-delay-1" data-category="shopify">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('XZEMgipm2EQ')">
              <img src="/assets/projects/bounce-back-drinks.webp" alt="Bounce Back Drinks" loading="lazy" decoding="async">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
