---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Contact from '../components/Contact.astro';
import FreeResources from '../components/FreeResources.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import Capabilities from '../components/Capabilities.astro';
import WhyKlickspell from '../components/WhyKlickspell.astro';
import SelectedWork from '../components/SelectedWork.astro';
import { SHOW_ABOUT } from '../lib/site-flags';

// The "About" section ("Built in the mountains of Uttarakhand.") is hidden for now.
// Flip to true to render it again; the markup is kept below.

// Dynamic career experience calculation (Started June 2020 at SheThink)
const careerStartDate = new Date('2020-06-01');
const now = new Date();
let yearsExperience = now.getFullYear() - careerStartDate.getFullYear();
const monthDiff = now.getMonth() - careerStartDate.getMonth();
if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < careerStartDate.getDate())) {
  yearsExperience--;
}

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Klickspell",
    "legalName": "KlickSpell Private Limited",
    "foundingDate": "2026-05-25",
    "description": "Klickspell is a web engineering and digital product studio crafting high-performance Shopify stores, Webflow marketing sites, Medusa.js headless commerce, and custom business systems.",
    "url": "https://klickspell.com/",
    "image": "https://klickspell.com/assets/projects/jaxon-lane.png",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Rudrapur",
      "addressRegion": "Uttarakhand",
      "addressCountry": "IN"
    },
    "areaServed": "Worldwide",
    "founder": {
      "@type": "Person",
      "name": "Atul Bhatt"
    },
    "sameAs": [
      "https://klickspell.online/",
      "https://in.linkedin.com/in/mratulbhatt",
      "https://github.com/atulbhatt-system32",
      "https://www.youtube.com/@knowittodaykit",
      "https://www.youtube.com/playlist?list=PL1p7vprQFvmus468rKCaHoQvHmaHopMyo"
    ],
    "owns": [
      {
        "@type": "WebApplication",
        "name": "Klickspell Online",
        "url": "https://klickspell.online/",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "All",
        "description": "Verified digital menus and service catalogues for local cafes, restaurants, and hospitality businesses across top destinations."
      }
    ],
    "knowsAbout": [
      "Shopify 2.0 Theme Architecture",
      "Shopify Speed Optimization",
      "Core Web Vitals & PageSpeed",
      "Liquid Templating Language",
      "Headless Commerce & Medusa.js",
      "Astro Framework Architecture",
      "Next.js Web Applications",
      "Front-End Engineering"
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Klickspell Core Engineering Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Shopify Speed Optimization & Core Web Vitals",
            "url": "https://klickspell.com/services/shopify-speed-optimization"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Custom Shopify Theme Development",
            "url": "https://klickspell.com/services/custom-shopify-development"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Headless Commerce & Custom Web Apps",
            "url": "https://klickspell.com/services/headless-commerce"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What services and platforms does Klickspell specialize in?",
        "acceptedAnswer": { "@type": "Answer", "text": "We build across five core pillars: Custom Shopify & Headless E-Commerce, Webflow Marketing & SaaS sites, Headless Commerce (Medusa.js with custom integrations like Cal.com), High-Converting Lead Landing Pages, and Custom Web Applications / ERP Systems (Frappe/ERPNext)." }
      },
      {
        "@type": "Question",
        "name": "How long does a project take?",
        "acceptedAnswer": { "@type": "Answer", "text": "Landing pages typically launch in 7–14 days and full Webflow sites in 2–4 weeks. Custom Shopify stores take 3–6 weeks from approved designs, and headless or full-stack builds 6–10 weeks, depending on scope. You'll get an exact date in your proposal after our discovery call." }
      },
      {
        "@type": "Question",
        "name": "How much does a project cost?",
        "acceptedAnswer": { "@type": "Answer", "text": "Every project is scoped and quoted individually based on your requirements, without rigid packages or surprise fees. You'll know the complete investment before we write a single line of code." }
      },
      {
        "@type": "Question",
        "name": "Will I be able to edit and manage the site myself after launch?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. That is our core engineering philosophy. Whether on Shopify, Webflow, or custom CMS, every section is designed to be fully editable by your team without needing developer help for everyday changes." }
      },
      {
        "@type": "Question",
        "name": "Can you build custom headless commerce (Medusa.js) or integrate booking engines?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build custom commerce backends using Medusa.js and integrate custom workflows such as Cal.com booking flows, tailored checkouts, and APIs designed for your exact business model." }
      },
      {
        "@type": "Question",
        "name": "Do you offer post-launch support and maintenance?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every project ends with full documentation and a walkthrough. For teams that want ongoing peace of mind, we provide ongoing maintenance, optimization, and daily tech management." }
      },
      {
        "@type": "Question",
        "name": "Do you work with international clients outside India?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. We have built and shipped products for brands across the US, UK, Israel, Japan, and India with clear async communication and flexible meeting hours." }
      }
    ]
  }
];
---

<BaseLayout
  title="Klickspell — The craft in every click."
  description="Klickspell is a web engineering studio building high-performance Shopify stores, Webflow sites, and Medusa.js headless commerce for ambitious brands."
  canonical="https://klickspell.com/"
  ogImage="https://klickspell.com/assets/projects/jaxon-lane.png"
  schema={schema}
>
  <Nav isHome={true} />

  <main id="main-content">
  <Hero />

  <Capabilities />

  <WhyKlickspell />

  <SelectedWork />

  <Testimonials />

  <!-- PROCESS -->
  <div class="process-section">
    <div class="process-inner">
      <div class="reveal"><p class="section-eyebrow">How We Work</p><h2 class="section-title">Simple process.<br><em>No surprises.</em></h2></div>
      <div class="process-grid reveal reveal-delay-1">
        <div class="process-step"><div class="process-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg></div><p class="process-num">01 —</p><p class="process-title">Discovery call</p><p class="process-desc">30 minutes. We understand your vision, your tech requirements, and your timeline. We provide honest feedback on scope and feasibility.</p></div>
        <div class="process-step"><div class="process-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg></div><p class="process-num">02 —</p><p class="process-title">Scope &amp; proposal</p><p class="process-desc">A clear proposal with fixed pricing, milestone timelines, and deliverable specs. No surprises mid-build.</p></div>
        <div class="process-step"><div class="process-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg></div><p class="process-num">03 —</p><p class="process-title">Build &amp; review</p><p class="process-desc">We build in agile stages with regular demo check-ins. You see progress, test live previews, and refine until it's pixel-perfect.</p></div>
        <div class="process-step"><div class="process-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg></div><p class="process-num">04</p><p class="process-title">Handover &amp; autonomy</p><p class="process-desc">Full documentation and a hands-on walkthrough. Your team leaves fully equipped to manage and scale independently.</p></div>
      </div>
    </div>
  </div>

  <!-- ABOUT: hidden for now. Set SHOW_ABOUT = true in src/lib/site-flags.ts to bring it back (its nav/footer links come back with it). -->
  {SHOW_ABOUT && (
  <section id="about">
    <div class="section">
      <div class="about-inner">
        <div class="about-photo reveal">
          <img src="/assets/atul-bhatt-portrait.webp" alt="Atul Bhatt" loading="lazy" decoding="async">
          <div class="about-photo-badge">Atul Bhatt<span>Founder, Klickspell · Rudrapur, Uttarakhand</span></div>
        </div>
        <div class="about-text reveal reveal-delay-1">
          <p class="section-eyebrow">About</p>
          <h2 class="section-title" style="font-size:clamp(32px,4vw,48px)">Built in the<br>mountains of <span style="color:var(--accent)">Uttarakhand.</span></h2>
          <p class="about-prose">Klickspell is an independent web engineering and digital product studio founded by Atul Bhatt, incorporated as KlickSpell Private Limited in May 2026. We partner with ambitious founders, brands, and marketing teams to build custom web products that refuse to compromise on design or code craft.</p>
          <p class="about-prose"><strong>Lean by choice, not by limitation.</strong> Every project receives our undivided attention. You work directly with the builder, not an account manager. We scope honestly, build carefully, and hand over completely.</p>
          <div class="about-stats">
            <div class="stat"><p class="stat-num">20<span>+</span></p><p class="stat-label">Projects shipped</p></div>
            <div class="stat"><p class="stat-num"><span id="expYears">{yearsExperience}</span><span>+</span></p><p class="stat-label">Years experience</p></div>
            <div class="stat"><p class="stat-num">6</p><p class="stat-label">Engineers &amp; designer</p></div>
          </div>
          <div class="team-teaser">
            <p class="team-teaser-text">Backed by a specialized pod of 5 engineers and a product designer across Shopify, Webflow, Medusa.js, and Full-Stack systems.</p>
            <a href="/team" class="team-teaser-link">Meet the full engineering team →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  )}

  <FreeResources />

  <Faq />

  <Contact />

  </main>

  <Footer isHome={true} />

  <!-- Portfolio filtering now lives in components/SelectedWork.astro -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Dynamic Years of Experience update (June 2020)
      const expEl = document.getElementById('expYears');
      if (expEl) {
        const start = new Date('2020-06-01');
        const today = new Date();
        let exp = today.getFullYear() - start.getFullYear();
        const m = today.getMonth() - start.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < start.getDate())) exp--;
        expEl.textContent = exp;
      }
    });
  </script>

  <!-- Contact Form Submission Handler (Frappe CRM). Not is:inline, because
       import.meta.env is only replaced by Vite in processed (module) scripts —
       an is:inline script is emitted as a classic <script> and import.meta
       throws a SyntaxError there. -->
  <script>
    const contactForm = document.getElementById('contactForm');
    if (contactForm) {
      const FRAPPE_CRM_URL = import.meta.env.PUBLIC_FRAPPE_CRM_URL || 'https://erp.klickspell.com';
      const submitBtn = document.getElementById('contactSubmitBtn');
      const btnText = document.getElementById('contactBtnText');
      const btnSpinner = document.getElementById('contactBtnSpinner');
      const successBox = document.getElementById('contactSuccess');
      const errorBox = document.getElementById('contactErrorBox');

      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorBox.style.display = 'none';
        successBox.style.display = 'none';
        submitBtn.disabled = true;
        btnText.style.display = 'none';
        btnSpinner.style.display = 'inline-block';

        const payload = {
          first_name: document.getElementById('contactName').value.trim(),
          email: document.getElementById('contactEmail').value.trim(),
          organization: document.getElementById('contactOrg').value.trim(),
          message: document.getElementById('contactMessage').value.trim(),
          company_url: document.getElementById('contactCompanyUrl').value.trim(),
        };

        try {
          const res = await fetch(`${FRAPPE_CRM_URL}/api/method/klickspell_customizations.api.website.contact_lead`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error(`Request failed: ${res.status}`);

          contactForm.reset();
          successBox.style.display = 'block';
        } catch (err) {
          console.warn('Contact form submission failed:', err);
          errorBox.style.display = 'block';
        } finally {
          submitBtn.disabled = false;
          btnText.style.display = 'inline';
          btnSpinner.style.display = 'none';
        }
      });
    }
  </script>
</BaseLayout>
