---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Klickspell",
    "description": "Shopify development agency crafting custom, fully-editable stores for brands that refuse to compromise.",
    "url": "https://klickspell.com/",
    "image": "https://klickspell.com/assets/projects/jaxon-lane.png",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Rudrapur",
      "addressRegion": "Uttarakhand",
      "addressCountry": "IN"
    },
    "areaServed": "Worldwide",
    "founder": {
      "@type": "Person",
      "name": "Atul Bhatt"
    },
    "sameAs": [
      "https://in.linkedin.com/in/mratulbhatt",
      "https://www.youtube.com/playlist?list=PL1p7vprQFvmus468rKCaHoQvHmaHopMyo"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How long does a project take?",
        "acceptedAnswer": { "@type": "Answer", "text": "With everything we have in place, most custom builds go live in 20–30 days depending on scope. You'll get an exact date in your proposal after the discovery call — and we stick to it." }
      },
      {
        "@type": "Question",
        "name": "How much does it cost?",
        "acceptedAnswer": { "@type": "Answer", "text": "Every project is scoped and quoted individually based on what you actually need — no fixed packages, no hidden markups. You'll know the full cost before we write a line of code." }
      },
      {
        "@type": "Question",
        "name": "Will I be able to edit the site myself after launch?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes — that's the whole point. Every custom section we build is editable from your Shopify customizer: text, images, blocks, layout. No developer call needed for everyday changes." }
      },
      {
        "@type": "Question",
        "name": "I don't know which apps I need — can you help?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Before we touch a line of code, we review your requirements and budget, then recommend what actually fits — no referral bias, no upselling complexity." }
      },
      {
        "@type": "Question",
        "name": "I already have a theme — can you still help?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. If your current theme doesn't quite fit your brand, we customize it exactly to your needs — custom sections, layout fixes, performance improvements — without a full rebuild." }
      },
      {
        "@type": "Question",
        "name": "Do you offer support after the site goes live?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every project ends with full documentation and a walkthrough so you can run things independently. If you'd rather we stay involved, we also take on ongoing maintenance and day-to-day store management." }
      },
      {
        "@type": "Question",
        "name": "Do you work with clients outside India?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes — we've built for brands across the US, UK, Israel, Japan, and India. We work async and adjust calls to your time zone." }
      }
    ]
  }
];
---

<BaseLayout
  title="Klickspell — The craft in every click."
  description="Klickspell is a Shopify development agency crafting custom, fully-editable stores for brands that refuse to compromise. Custom design, honest app advice, and a complete handover — no templates, no dependency."
  canonical="https://klickspell.com/"
  ogImage="https://klickspell.com/assets/projects/jaxon-lane.png"
  schema={schema}
>
  <Nav isHome={true} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-arc hero-arc-1"></div>
    <div class="hero-arc hero-arc-2"></div>
    <div class="hero-arc hero-arc-3"></div>
    <div class="hero-arc hero-arc-4"></div>
    <div class="floating-cards">
      <div class="float-card fc-1"><div class="fc-dot"></div>Shopify Expert</div>
      <div class="float-card fc-2"><div class="fc-dot"></div>8 Projects shipped</div>
      <div class="float-card fc-3"><div class="fc-dot"></div>Custom sections</div>
      <div class="float-card fc-4"><div class="fc-dot"></div>India &amp; Global</div>
    </div>
    <div class="hero-eyebrow">Shopify Development Agency</div>
    <h1 class="hero-headline">We build the store<br>you <span class="accent">actually</span><br><span class="dim">imagined.</span></h1>
    <h1 class="hero-headline-mobile">Your store,<br><span class="accent">truly</span> yours.</h1>
    <p class="hero-sub">Custom design. Sections you can edit yourself. Apps chosen honestly for your budget. Built for your independence — not our dependency.</p>
    <p class="hero-sub-mobile">Custom Shopify stores you can actually edit yourself. No templates. No dependency.</p>
    <div class="hero-actions">
      <a data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" id="hero-cta-d">Book a free 30-min call →</a>
      <a href="https://wa.me/919259598769" class="btn-primary" target="_blank" id="hero-cta-m" style="display:none">💬 Chat on WhatsApp</a>
      <a href="#work" class="btn-ghost">See our work</a>
    </div>
    <p class="hero-note"><a data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' style="color:inherit;text-decoration:underline;text-decoration-style:dotted;text-underline-offset:3px;cursor:pointer">Schedule a free 30-min call</a> · No commitment</p>
    <p class="hero-note-mobile">Free 30-min call · No commitment</p>
  </section>

  <!-- MARQUEE -->
  <div class="clients">
    <p class="clients-label">Brands we've built for</p>
    <div class="marquee-track">
      <span class="marquee-item">Cove &amp; Lane</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Jaxon Lane</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Taarz</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Haycure Wellness</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Noukai Tokyo</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Under Design</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Easy Rugs</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Bounce Back Drinks</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Bambrew</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Cove &amp; Lane</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Jaxon Lane</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Taarz</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Haycure Wellness</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Noukai Tokyo</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Under Design</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Easy Rugs</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Bounce Back Drinks</span><span class="marquee-item marquee-dot">·</span>
      <span class="marquee-item">Bambrew</span>
    </div>
  </div>

  <!-- SERVICES -->
  <section id="services">
    <div class="section">
      <div class="reveal">
        <p class="section-eyebrow">What we do</p>
        <h2 class="section-title">Built for your vision,<br><em>not our convenience.</em></h2>
        <p class="section-sub">Every project is scoped and quoted individually — no fixed packages, no hidden markups. You'll know the full cost before we write a line of code.</p>
      </div>
      <div class="services-grid reveal reveal-delay-1">
        <div class="service-card">
          <p class="service-num">01 —</p>
          <p class="service-name">Custom Shopify Development</p>
          <p class="service-desc">Not a template with your logo on it. <strong>A store built from your vision — custom sections, custom design, custom everything.</strong> Every section fully editable from your customizer. No developer call for everyday changes.</p>
        </div>
        <div class="service-card">
          <p class="service-num">02 —</p>
          <p class="service-name">Theme Customization</p>
          <p class="service-desc">Already have a theme that doesn't quite fit? We customise it exactly to your brand — custom sections, layout fixes, performance improvements, full editability from day one.</p>
        </div>
        <div class="service-card">
          <p class="service-num">03 —</p>
          <p class="service-name">App Integration &amp; Consulting</p>
          <p class="service-desc">Before we touch a line of code, <strong>we help you choose.</strong> We review your requirements and budget — then recommend what actually fits. No referral bias. No upselling complexity.</p>
        </div>
        <div class="service-card">
          <p class="service-num">04 —</p>
          <p class="service-name">Performance &amp; CRO</p>
          <p class="service-desc">Speed, conversion rate, Core Web Vitals — we audit what's holding your store back and fix it. <strong>Faster stores convert better.</strong> We make yours fast and keep it that way.</p>
        </div>
        <div class="service-card">
          <p class="service-num">05 —</p>
          <p class="service-name">Systems &amp; Infrastructure</p>
          <p class="service-desc">Custom web apps, API integrations, DevOps, and self-hosted infrastructure. When your business needs something built beyond Shopify — we scope it, build it, document it.</p>
        </div>
        <div class="service-cta-card">
          <p class="service-cta-text">Not sure which service fits?<br><em>Let's figure it out together.</em></p>
          <button class="service-cta-btn" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}'>Book a free call →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFFERENTIATORS -->
  <div class="diff-section">
    <div class="diff-inner">
      <div class="diff-left reveal">
        <p class="section-eyebrow">Why Klickspell</p>
        <h2 class="section-title">Built to hand<br>over. <em>Fully.</em></h2>
        <p class="section-sub">Most agencies build dependency. We build your independence. Every project ends with you fully in control — no ongoing reliance on us for basic changes.</p>
        <div style="margin-top:2.5rem"><a data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="btn-primary" style="cursor:pointer">Book a discovery call →</a></div>
      </div>
      <div class="diff-list reveal reveal-delay-1">
        <div class="diff-item"><span class="diff-num">01</span><div><p class="diff-name">Vision first — not templates</p><p class="diff-desc">We start with what you imagined and engineer backwards. No compromises before we've even started.</p></div></div>
        <div class="diff-item"><span class="diff-num">02</span><div><p class="diff-name">Truly editable custom sections</p><p class="diff-desc">Every custom section is editable from your Shopify customizer. Text, images, blocks — no developer call for everyday changes.</p></div></div>
        <div class="diff-item"><span class="diff-num">03</span><div><p class="diff-name">Honest app advice</p><p class="diff-desc">We help you choose apps based on your actual needs and budget — not our familiarity or referral fees.</p></div></div>
        <div class="diff-item"><span class="diff-num">04</span><div><p class="diff-name">Direct access — no middlemen</p><p class="diff-desc">You talk to the person building your store. No account managers. No lost-in-translation briefs.</p></div></div>
      </div>
    </div>
  </div>

  <!-- PORTFOLIO -->
  <section id="work">
    <div class="section">
      <div class="portfolio-header reveal">
        <div>
          <p class="section-eyebrow">Selected work</p>
          <h2 class="section-title">9 stores.<br><em>9 different visions.</em></h2>
        </div>
      </div>
      <div class="portfolio-grid">
        <a href="/work/jaxon-lane.html" class="project-card featured reveal">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('mRuKJxc2r5Y')">
              <img src="/assets/projects/jaxon-lane.png" alt="Jaxon Lane">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Skincare · US</span>
          </div>
          <div class="project-body"><div><p class="project-name">Jaxon Lane</p><p class="project-niche">Skincare · US Brand · Featured</p></div><div class="project-arrow">↗</div></div>
        </a>
        <a href="/work/cove-and-lane.html" class="project-card regular reveal reveal-delay-1">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('Ufh6W6h4Kqo')">
              <img src="/assets/projects/cove-and-lane.png" alt="Cove &amp; Lane">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Fashion &amp; Apparel</span>
          </div>
          <div class="project-body"><div><p class="project-name">Cove &amp; Lane</p><p class="project-niche">Fashion &amp; Apparel</p></div><div class="project-arrow">↗</div></div>
        </a>
        <a href="https://www.bambrew.in/" target="_blank" rel="noopener" class="project-card featured reveal">
          <div class="project-thumb">
            <img src="/assets/projects/bambrew.png" alt="Bambrew">
            <span class="project-niche-tag">Sustainability</span>
          </div>
          <div class="project-body"><div><p class="project-name">Bambrew</p><p class="project-niche">Sustainable Packaging · Featured</p></div><div class="project-arrow">↗</div></div>
        </a>
        <a href="https://bouncebackdrinks.com/" target="_blank" rel="noopener" class="project-card regular reveal reveal-delay-1">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('XZEMgipm2EQ')">
              <img src="/assets/projects/bounce-back-drinks.png" alt="Bounce Back Drinks">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">UK Brand</span>
          </div>
          <div class="project-body"><div><p class="project-name">Bounce Back Drinks</p><p class="project-niche">Food &amp; Beverage · UK Brand</p></div><div class="project-arrow">↗</div></div>
        </a>
        <a href="https://easyrugs.in/" target="_blank" rel="noopener" class="project-card half reveal">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('s1FYKKLfmbA')">
              <img src="/assets/projects/easy-rugs.png" alt="Easy Rugs">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">🦈 Shark Tank India</span>
          </div>
          <div class="project-body"><div><p class="project-name">Easy Rugs</p><p class="project-niche">Home Decor · <span style="color:var(--accent);font-weight:700;">As seen on Shark Tank India</span></p></div><div class="project-arrow">↗</div></div>
        </a>
        <a href="https://noukaitokyo.com/" target="_blank" rel="noopener" class="project-card half reveal reveal-delay-1">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('sMlf7cl_L-o')">
              <img src="/assets/projects/noukai-tokyo.png" alt="Noukai Tokyo">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Shopify Hydrogen</span>
          </div>
          <div class="project-body"><div><p class="project-name">Noukai Tokyo</p><p class="project-niche">Beauty Rituals · <span style="color:var(--accent);font-weight:700;">Built with Hydrogen</span></p></div><div class="project-arrow">↗</div></div>
        </a>
        <a href="https://store.weareunder.design/" target="_blank" rel="noopener" class="project-card half reveal">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('4NaWXprt2Zo')">
              <img src="/assets/projects/store-weareunder.png" alt="Under Design">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Israel Brand</span>
          </div>
          <div class="project-body"><div><p class="project-name">Under Design</p><p class="project-niche">Creative Merch · Israel Brand</p></div><div class="project-arrow">↗</div></div>
        </a>
        <a href="https://haycurewellness.com/" target="_blank" rel="noopener" class="project-card half reveal reveal-delay-1">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('PyUQr6Zfiu8')">
              <img src="/assets/projects/haycure-wellness.png" alt="Haycure Wellness">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Wellness</span>
          </div>
          <div class="project-body"><div><p class="project-name">Haycure Wellness</p><p class="project-niche">Wellness &amp; Beauty</p></div><div class="project-arrow">↗</div></div>
        </a>
        <a href="https://taarz.in/" target="_blank" rel="noopener" class="project-card half reveal">
          <div class="project-thumb">
            <div class="yt-facade" onclick="event.preventDefault();openYTModal('JF39xGGsWcA')">
              <img src="/assets/projects/taarz.png" alt="Taarz">
              <div class="yt-play"><div class="yt-play-btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
            </div>
            <span class="project-niche-tag">Fashion</span>
          </div>
          <div class="project-body"><div><p class="project-name">Taarz</p><p class="project-niche">Fashion</p></div><div class="project-arrow">↗</div></div>
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <div class="testimonials-section">
    <div class="testimonials-inner">
      <div class="reveal"><p class="section-eyebrow">Client words</p><h2 class="section-title">Don't take<br><em>our word for it.</em></h2></div>
      <div class="testimonials-masonry reveal reveal-delay-1">

        <div class="testimonial-card featured">
          <span class="testimonial-source"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></span>
          <p class="testimonial-quote">I brought Atul onboard my pre-seed startup as a contract frontend developer. He more than made up for his early career stage with his drive, efficiency, reliability, and a positive attitude. Atul always delivered — generally with the level of quality you'd expect from someone with more grey hairs.</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar"><img src="/assets/testimonials/saswat-panda.jpg" alt="Saswat Panda"></div>
            <div><p class="testimonial-name">Saswat Panda</p><p class="testimonial-role">Entrepreneur · Forbes 30 Under 30 · Harvard Business School</p></div>
          </div>
        </div>

        <div class="testimonial-card featured">
          <span class="testimonial-source"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.546-1.405 0-2.543-1.14-2.545-2.546V3.492H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-1.19c.529 1.107 1.182 2.229 1.974 3.221l-1.673 7.873h2.797l1.213-5.71c1.063.679 2.285 1.109 3.686 1.109 3 0 5.439-2.452 5.439-5.45 0-3-2.439-5.439-5.439-5.439z"/></svg></span>
          <p class="testimonial-quote">Working with Atul was always a delight. His exceptional communication skills, timely delivery of great work, and strong skills made him a pleasure to collaborate with. His curiosity and willingness to step outside his expertise made him a valuable asset to any project.</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar"><img src="/assets/testimonials/eden-vidal.jpg" alt="Eden Vidal"></div>
            <div><p class="testimonial-name">Eden Vidal</p><p class="testimonial-role">Founder &amp; CEO, Under</p></div>
          </div>
        </div>

        <div class="testimonial-card featured">
          <span class="testimonial-source"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.546-1.405 0-2.543-1.14-2.545-2.546V3.492H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-1.19c.529 1.107 1.182 2.229 1.974 3.221l-1.673 7.873h2.797l1.213-5.71c1.063.679 2.285 1.109 3.686 1.109 3 0 5.439-2.452 5.439-5.45 0-3-2.439-5.439-5.439-5.439z"/></svg></span>
          <p class="testimonial-quote">We hired Atul for one of our web-based projects. He took the time to understand my needs and provided a customized solution that exceeded my expectations. I would highly recommend working with Atul for any web-related project.</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar"><img src="/assets/testimonials/rajesh-durai.png" alt="Rajesh Durai"></div>
            <div><p class="testimonial-name">Rajesh Durai</p><p class="testimonial-role">Founder, Skillbridge · ex-VP upGrad · ex-HP</p></div>
          </div>
