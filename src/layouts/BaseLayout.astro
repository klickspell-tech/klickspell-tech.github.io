---
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Klickspell — The craft in every click.",
  description = "Klickspell is a Shopify development agency crafting custom, fully-editable stores for brands that refuse to compromise. Custom design, honest app advice, and a complete handover — no templates, no dependency.",
  canonical = Astro.url.href,
  ogImage = "https://klickspell.com/assets/projects/jaxon-lane.png",
  ogType = "website",
  schema
} = Astro.props;

const canonicalUrl = canonical.startsWith('http') ? canonical : new URL(canonical, Astro.site || 'https://klickspell.com').href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site || 'https://klickspell.com').href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="theme-color" content="#F2F0EC" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Klickspell" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImage} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%233A5BE0'/%3E%3Ctext x='50%25' y='55%25' font-family='Georgia,serif' font-style='italic' font-size='38' fill='white' text-anchor='middle' dominant-baseline='middle'%3EK%3C/text%3E%3C/svg%3E" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" />
  </noscript>

  <!-- Global Styles inlined automatically by Astro -->

  {schema && (
    Array.isArray(schema) ? (
      schema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )
  )}
</head>
<body>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <slot />

  <!-- Video Modal -->
  <div id="ytModal" class="yt-modal">
    <div class="yt-modal-overlay" id="ytModalOverlay"></div>
    <div class="yt-modal-box">
      <button class="yt-modal-close" id="ytModalClose" aria-label="Close video modal">✕</button>
      <iframe id="ytModalIframe" src="" title="Video Walkthrough Player" allow="autoplay; fullscreen" allowfullscreen></iframe>
    </div>
  </div>

  <script>
    import Lenis from 'lenis';

    let lenis: Lenis | null = null;
    // Only initialize smooth scroll on desktop pointer devices
    if (window.matchMedia('(pointer: fine)').matches) {
      lenis = new Lenis({ lerp: 0.08, smoothWheel: true });
      lenis.on('scroll', () => {
        const nav = document.getElementById('nav');
        if (nav) nav.classList.toggle('scrolled', lenis!.scroll > 40);
      });
      function raf(time: number) {
        lenis?.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    } else {
      // Native scroll on mobile for max 120fps performance and zero CPU overhead
      window.addEventListener('scroll', () => {
        const nav = document.getElementById('nav');
        if (nav) nav.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });
    }

    // Video modal
    (window as any).openYTModal = function(videoId: string) {
      const iframe = document.getElementById('ytModalIframe') as HTMLIFrameElement | null;
      const modal = document.getElementById('ytModal');
      if (iframe && modal) {
        iframe.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
        modal.classList.add('open');
        lenis?.stop();
      }
    };
    (window as any).closeYTModal = function() {
      const iframe = document.getElementById('ytModalIframe') as HTMLIFrameElement | null;
      const modal = document.getElementById('ytModal');
      if (iframe && modal) {
        iframe.src = '';
        modal.classList.remove('open');
        lenis?.start();
      }
    };

    document.getElementById('ytModalOverlay')?.addEventListener('click', () => (window as any).closeYTModal());
    document.getElementById('ytModalClose')?.addEventListener('click', () => (window as any).closeYTModal());
    document.addEventListener('keydown', e => { if (e.key === 'Escape') (window as any).closeYTModal(); });

    // Custom Cursor (Desktop mouse only to conserve mobile CPU)
    if (window.matchMedia('(pointer: fine)').matches) {
      const cur = document.getElementById('cursor'), ring = document.getElementById('cursorRing');
      let mx = 0, my = 0, rx = 0, ry = 0;
      document.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        if (cur) { cur.style.left = mx + 'px'; cur.style.top = my + 'px'; }
      });
      (function anim(){
        rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12;
        if (ring) { ring.style.left = rx + 'px'; ring.style.top = ry + 'px'; }
        requestAnimationFrame(anim);
      })();
      document.querySelectorAll('a, button, .service-card, .project-card, .diff-item, .stat, .tutorial-card, .blog-card').forEach(el => {
        el.addEventListener('mouseenter', () => document.body.classList.add('hovering'));
        el.addEventListener('mouseleave', () => document.body.classList.remove('hovering'));
      });
    }

    // Mobile menu
    const burger = document.getElementById('burger'), menu = document.getElementById('mobileMenu');
    if (burger && menu) {
      burger.addEventListener('click', () => {
        burger.classList.toggle('open');
        menu.classList.toggle('open');
      });
      document.querySelectorAll('.mobile-link, .mobile-cta-link').forEach(l => {
        l.addEventListener('click', () => {
          burger.classList.remove('open');
          menu.classList.remove('open');
        });
      });
    }

    // Scroll reveal
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

    // Smooth scroll via Lenis for internal hash links
    document.querySelectorAll('a[href^="#"]').forEach(a => a.addEventListener('click', e => {
      const href = a.getAttribute('href');
      if (href && href !== '#') {
        const t = document.querySelector(href);
        if (t) {
          e.preventDefault();
          if (lenis) {
            lenis.scrollTo(t as HTMLElement, { offset: 0, duration: 1.2 });
          } else {
            t.scrollIntoView({ behavior: 'smooth' });
          }
        }
      }
    }));
  </script>

  <!-- Cal.com embed (lazy-loaded on interaction or idle to prevent blocking initial paint) -->
  <script is:inline type="text/javascript">
    function loadCal() {
      if (window._calLoaded) return;
      window._calLoaded = true;
      (function(C,A,L){let p=function(a,ar){a.q.push(ar)};let d=C.document;C.Cal=C.Cal||function(){let cal=C.Cal;let ar=arguments;if(!cal.loaded){cal.ns={};cal.q=cal.q||[];d.head.appendChild(d.createElement("script")).src=A;cal.loaded=true}if(ar[0]===L){const api=function(){p(api,arguments)};const namespace=ar[1];api.q=api.q||[];typeof namespace==="string"?(cal.ns[namespace]=api)&&p(api,ar):p(cal,ar);return}p(cal,ar)};})(window,"https://app.cal.com/embed/embed.js","init");
      Cal("init","30min",{origin:"https://cal.com"});
      Cal.ns["30min"]("ui",{"styles":{"branding":{"brandColor":"#3A5BE0"}},"hideEventTypeDetails":false,"layout":"month_view"});
    }
    // Load Cal.com on user scroll, touch, pointer move, or when idle
    ['scroll', 'touchstart', 'mousemove', 'click'].forEach(evt => window.addEventListener(evt, loadCal, { once: true, passive: true }));
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(loadCal, 2500));
    } else {
      setTimeout(loadCal, 3500);
    }
  </script>
</body>
</html>
