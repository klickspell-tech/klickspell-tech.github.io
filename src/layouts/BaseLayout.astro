---
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Klickspell — The craft in every click.",
  description = "Klickspell is a Shopify development agency crafting custom, fully-editable stores for brands that refuse to compromise. Custom design, honest app advice, and a complete handover — no templates, no dependency.",
  canonical = Astro.url.href,
  ogImage = "https://klickspell.com/assets/og-card.png",
  ogType = "website",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  schema
} = Astro.props;

// Staging builds set PUBLIC_STAGING=true (in the staging workflow only, never committed
// to config) so the preview site can't be indexed. Production leaves it unset.
const isStaging = import.meta.env.PUBLIC_STAGING === 'true';
const robotsContent = isStaging ? 'noindex, nofollow' : robots;

const canonicalUrl = canonical.startsWith('http') ? canonical : new URL(canonical, Astro.site || 'https://klickspell.com').href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site || 'https://klickspell.com').href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="theme-color" content="#F2F0EC" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Klickspell" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@mratulbhatt" />
  <meta name="twitter:creator" content="@mratulbhatt" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <link id="app-favicon" rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Klickspell Blog RSS Feed" href="https://klickspell.com/rss.xml" />

  <!-- Preload Critical Self-Hosted Fonts -->
  <link rel="preload" href="/assets/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/instrument-serif-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Global Styles inlined automatically by Astro -->

  {schema && (
    Array.isArray(schema) ? (
      schema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )
  )}

  <!-- Animated 3D rotating favicon (works across Chrome, Edge, and Firefox) -->
  <script is:inline>
  (function () {
    try {
      var cvs = document.createElement('canvas');
      cvs.width = 64;
      cvs.height = 64;
      var ctx = cvs.getContext('2d');
      if (!ctx) return;

      var DURATION = 2600; // ms for full 360-degree rotation
      var lastDraw = 0;
      var FRAME_INTERVAL = 50; // ~20 fps: smooth rotation with negligible CPU overhead

      function drawRoundedRect(x, y, w, h, r) {
        if (w <= 0 || h <= 0) return;
        var radius = Math.min(r, w / 2, h / 2);
        ctx.beginPath();
        ctx.moveTo(x + radius, y);
        ctx.lineTo(x + w - radius, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + radius);
        ctx.lineTo(x + w, y + h - radius);
        ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);
        ctx.lineTo(x + radius, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - radius);
        ctx.lineTo(x, y + radius);
        ctx.quadraticCurveTo(x, y, x + radius, y);
        ctx.closePath();
      }

      function render(angle) {
        ctx.clearRect(0, 0, 64, 64);

        var cos = Math.cos(angle);
        var sin = Math.sin(angle);
        var absCos = Math.max(0.04, Math.abs(cos));
        var isFront = cos >= 0;

        var baseWidth = 54;
        var cardHeight = 54;
        var cardY = 5;
        var curWidth = baseWidth * absCos;
        var cardX = 32 - curWidth / 2;

        // 1. Draw 3D Depth Rim / Edge when turning
        var depth = 3.5;
        var edgeWidth = depth * Math.abs(sin);
        if (edgeWidth > 0.8) {
          var edgeX = sin > 0 ? (cardX + curWidth - edgeWidth * 0.3) : (cardX - edgeWidth * 0.7);
          drawRoundedRect(edgeX, cardY, edgeWidth, cardHeight, 10 * absCos);
          ctx.fillStyle = '#18308C';
          ctx.fill();
        }

        // 2. Draw Main Card Face with lighting
        drawRoundedRect(cardX, cardY, curWidth, cardHeight, 12 * absCos);
        var shade = 0.82 + 0.18 * absCos;
        ctx.fillStyle = isFront
          ? 'rgb(' + Math.round(58 * shade) + ',' + Math.round(91 * shade) + ',' + Math.round(224 * shade) + ')'
          : 'rgb(' + Math.round(38 * shade) + ',' + Math.round(68 * shade) + ',' + Math.round(200 * shade) + ')';
        ctx.fill();

        // 3. Subtle Gloss Gradient on Front Face
        if (isFront && absCos > 0.25) {
          var grad = ctx.createLinearGradient(cardX, cardY, cardX + curWidth, cardY + cardHeight);
          grad.addColorStop(0, 'rgba(255, 255, 255, 0.28)');
          grad.addColorStop(0.55, 'rgba(255, 255, 255, 0.05)');
          grad.addColorStop(1, 'rgba(0, 0, 0, 0.1)');
          drawRoundedRect(cardX, cardY, curWidth, cardHeight, 12 * absCos);
          ctx.fillStyle = grad;
          ctx.fill();
        }

        // 4. Letter "K" on BOTH front and back faces (readable on both sides!)
        if (absCos > 0.12) {
          ctx.save();
          ctx.translate(32, 34);
          ctx.scale(absCos, 1);
          ctx.font = 'italic bold 35px Georgia, serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillStyle = isFront ? '#FFFFFF' : '#E6EEFF';
          ctx.fillText('K', 0, 0);
          ctx.restore();
        }

        // 5. Update Favicon via replaceChild to force Chrome & Firefox to repaint
        var dataUrl = cvs.toDataURL('image/png');
        var oldLink = document.getElementById('app-favicon') || document.querySelector("link[rel*='icon']");
        var newLink = document.createElement('link');
        newLink.id = 'app-favicon';
        newLink.rel = 'icon';
        newLink.type = 'image/png';
        newLink.href = dataUrl;

        if (oldLink && oldLink.parentNode) {
          oldLink.parentNode.replaceChild(newLink, oldLink);
        } else {
          document.head.appendChild(newLink);
        }
      }

      var start = null;
      function tick(timestamp) {
        if (!start) start = timestamp;
        if (!document.hidden && (timestamp - lastDraw >= FRAME_INTERVAL)) {
          lastDraw = timestamp;
          var progress = ((timestamp - start) % DURATION) / DURATION;
          var angle = progress * Math.PI * 2;
          render(angle);
        }
        requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);
    } catch (e) {
      // Graceful fallback to static favicon
    }
  })();
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <slot />

  <!-- Video Modal -->
  <div id="ytModal" class="yt-modal">
    <div class="yt-modal-overlay" id="ytModalOverlay"></div>
    <div class="yt-modal-box">
      <button class="yt-modal-close" id="ytModalClose" aria-label="Close video modal">✕</button>
      <iframe id="ytModalIframe" src="" title="Video Walkthrough Player" allow="autoplay; fullscreen" allowfullscreen></iframe>
    </div>
  </div>

  <script is:inline>
    // Video modal
    window.openYTModal = function(videoId) {
      const iframe = document.getElementById('ytModalIframe');
      const modal = document.getElementById('ytModal');
      if (iframe && modal) {
        iframe.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
        modal.classList.add('open');
        window._lenis?.stop();
      }
    };
    window.closeYTModal = function() {
      const iframe = document.getElementById('ytModalIframe');
      const modal = document.getElementById('ytModal');
      if (iframe && modal) {
        iframe.src = '';
        modal.classList.remove('open');
        window._lenis?.start();
      }
    };

    document.getElementById('ytModalOverlay')?.addEventListener('click', window.closeYTModal);
    document.getElementById('ytModalClose')?.addEventListener('click', window.closeYTModal);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') window.closeYTModal(); });

    // Desktop mouse devices: Custom Cursor & Smooth Scroll
    if (window.matchMedia('(pointer: fine)').matches) {
      const cur = document.getElementById('cursor'), ring = document.getElementById('cursorRing');
      let mx = -100, my = -100, rx = -100, ry = -100;
      document.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        if (cur) cur.style.transform = `translate3d(${mx}px, ${my}px, 0) translate(-50%, -50%)`;
      }, { passive: true });
      (function anim(){
        rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12;
        if (ring) ring.style.transform = `translate3d(${rx}px, ${ry}px, 0) translate(-50%, -50%)`;
        requestAnimationFrame(anim);
      })();
      document.querySelectorAll('a, button, .service-card, .project-card, .diff-item, .stat, .tutorial-card, .blog-card').forEach(el => {
        el.addEventListener('mouseenter', () => document.body.classList.add('hovering'), { passive: true });
        el.addEventListener('mouseleave', () => document.body.classList.remove('hovering'), { passive: true });
      });

      // Lazy load Lenis asynchronously on desktop
      import('/assets/js/lenis.mjs').then(({ default: Lenis }) => {
        const lenis = new Lenis({ lerp: 0.08, smoothWheel: true });
        window._lenis = lenis;
        lenis.on('scroll', () => {
          const nav = document.getElementById('nav');
          if (nav) nav.classList.toggle('scrolled', lenis.scroll > 40);
        });
        (function raf(time) { lenis.raf(time); requestAnimationFrame(raf); })(0);
      }).catch(() => {});
    } else {
      // Mobile touch screens: requestAnimationFrame-throttled scroll listener (prevents forced reflow)
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const nav = document.getElementById('nav');
            if (nav) nav.classList.toggle('scrolled', window.scrollY > 40);
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }

    // Mobile menu
    const burger = document.getElementById('burger'), menu = document.getElementById('mobileMenu');
    if (burger && menu) {
      burger.addEventListener('click', () => {
        burger.classList.toggle('open');
        menu.classList.toggle('open');
      });
      document.querySelectorAll('.mobile-link, .mobile-cta-link').forEach(l => {
        l.addEventListener('click', () => {
          burger.classList.remove('open');
          menu.classList.remove('open');
        });
      });
    }

    // Scroll reveal
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

    // Smooth scroll for internal hash links
    document.querySelectorAll('a[href^="#"]').forEach(a => a.addEventListener('click', e => {
      const href = a.getAttribute('href');
      if (href && href !== '#') {
        const t = document.querySelector(href);
        if (t) {
          e.preventDefault();
          if (window._lenis) {
            window._lenis.scrollTo(t, { offset: 0, duration: 1.2 });
          } else {
            t.scrollIntoView({ behavior: 'smooth' });
          }
        }
      }
    }));
  </script>

  <!-- Cal.com embed (lazy-loaded ONLY on user interaction or CTA hover/click to prevent forced reflow and third-party blocking during initial paint) -->
  <script is:inline type="text/javascript">
    function loadCal() {
      if (window._calLoaded) return;
      window._calLoaded = true;
      (function(C,A,L){let p=function(a,ar){a.q.push(ar)};let d=C.document;C.Cal=C.Cal||function(){let cal=C.Cal;let ar=arguments;if(!cal.loaded){cal.ns={};cal.q=cal.q||[];d.head.appendChild(d.createElement("script")).src=A;cal.loaded=true}if(ar[0]===L){const api=function(){p(api,arguments)};const namespace=ar[1];api.q=api.q||[];typeof namespace==="string"?(cal.ns[namespace]=api)&&p(api,ar):p(cal,ar);return}p(cal,ar)};})(window,"https://app.cal.com/embed/embed.js","init");
      Cal("init","30min",{origin:"https://cal.com"});
      Cal.ns["30min"]("ui",{"styles":{"branding":{"brandColor":"#3A5BE0"}},"hideEventTypeDetails":false,"layout":"month_view"});
    }
    // Bind to all booking CTAs so Cal loads ahead of time when user points at or clicks them
    function initCalTriggers() {
      document.querySelectorAll('[data-cal-link], .nav-cta, #hero-cta, a[href*="cal.com"]').forEach(el => {
        el.addEventListener('pointerenter', loadCal, { once: true, passive: true });
        el.addEventListener('touchstart', loadCal, { once: true, passive: true });
        el.addEventListener('focus', loadCal, { once: true, passive: true });
        el.addEventListener('click', loadCal, { once: true });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCalTriggers);
    } else {
      initCalTriggers();
    }
  </script>

  <!-- Service Worker for offline asset caching and instant repeat font/asset delivery -->
  <script is:inline>
    if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</body>
</html>
