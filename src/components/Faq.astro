---
// Figma: klickspell › FAQ "Questions" (desktop 82:752). Built from a saved render of the
// frame (Figma API limit hit), so measurements are accurate to a few px.
// Questions/answers are the same as before and match the FAQPage JSON-LD in pages/index.astro.
interface Props {
  /** page-specific questions; defaults to the general list below (home and services pages) */
  items?: { q: string; a: string }[];
}
const { items } = Astro.props;
const defaultFaqs = [
  {
    q: 'What platforms and stacks does Klickspell specialize in?',
    a: 'We engineer across five primary verticals: Custom Shopify theme and Hydrogen headless development, Webflow for SaaS & marketing sites, Headless Commerce (Medusa.js + Cal.com integrations), High-Converting Lead Landing Pages, and Custom Web Applications / ERP Systems (Frappe/ERPNext).',
  },
  {
    q: 'How long does a project take?',
    a: "High-converting landing pages typically go live in 7–14 days and full Webflow sites in 2–4 weeks. Custom Shopify stores take 3–6 weeks from approved designs, and headless or full-stack builds 6–10 weeks, depending on complexity. You'll receive a committed milestone timeline in your scope proposal.",
  },
  {
    q: 'How much does a project cost?',
    a: "Every project is scoped and quoted individually based on what you actually need, with no rigid packages or surprise invoices. You'll know the complete cost before we write a single line of code.",
  },
  {
    q: 'Will I be able to edit the site myself after launch?',
    a: 'Yes, that is central to how we build. Whether on Shopify, Webflow, or a custom CMS, all sections are built to be easily editable (text, imagery, layout blocks) by non-technical team members without developer calls.',
  },
  {
    q: 'Can you build custom headless commerce or custom integrations (like Medusa.js & Cal.com)?',
    a: 'Yes. When off-the-shelf platforms are too restrictive, we build headless commerce backends with Medusa.js, integrate Cal.com scheduling workflows, and create custom APIs tailored to your exact business logic.',
  },
  {
    q: 'Do you offer support after the site goes live?',
    a: "Yes. Every project ends with full documentation and a recorded walkthrough. If you'd like ongoing peace of mind, we also provide maintenance retainers and day-to-day store/site management.",
  },
  {
    q: 'Do you work with clients outside India?',
    a: "Yes. We've shipped products for brands across the US, UK, Israel, Japan, and India. We operate asynchronously with high communication fidelity and align calls with your local timezone.",
  },
];
const faqs = items ?? defaultFaqs;
---

<section id="faq" class="fq">
  <div class="fq-inner">
    <p class="fq-eyebrow"><span class="fq-rule" aria-hidden="true"></span>Questions</p>
    <h2 class="fq-title">Straight answers,<br />before <em>you commit.</em></h2>

    <div class="fq-list">
      {faqs.map((f, i) => (
        <details class="fq-item" name="faq" open={i === 0}>
          <summary>
            <h3 class="fq-q">{f.q}</h3>
            <svg class="fq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6.25 8 10.25l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="fq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .fq { --pad: clamp(24px, 6.25vw, 90px); background: var(--bg-soft); }
  .fq-inner { max-width: 1440px; margin: 0 auto; padding: 40px 20px; }

  .fq-eyebrow {
    display: flex; align-items: center; gap: 8px;
    font-size: 12px; line-height: 16px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--accent);
  }
  .fq-rule { display: block; width: 24px; height: 1px; background: var(--accent); }
  .fq-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 9.524vw, 40px); font-weight: 500; line-height: 1.2; letter-spacing: -1.16px; /* 40px on a 420px phone */
    color: var(--text);
    margin: 16px 0 40px;
  }
  .fq-title em { font-style: italic; font-weight: 500; color: var(--text-light); }

  .fq-list { display: flex; flex-direction: column; gap: 24px; }

  .fq-item {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    transition: border-color .25s var(--ease), box-shadow .25s var(--ease);
  }
  .fq-item:hover { border-color: rgba(58,91,224,0.35); }
  .fq-item summary {
    list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 15px 24px; /* + 1px border: 16px inside, as in the Figma mobile frame */
    cursor: pointer;
  }
  .fq-item summary::-webkit-details-marker { display: none; }
  .fq-item summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 12px; }
  .fq-item[open] summary { padding-bottom: 6px; }

  .fq-q {
    font-family: var(--font-display);
    font-size: 18px; font-weight: 500; line-height: 28px; letter-spacing: 0;
    color: var(--text);
  }
  .fq-chevron { flex-shrink: 0; color: var(--text); transition: transform .3s var(--ease); }
  .fq-item[open] .fq-chevron { transform: rotate(180deg); }

  .fq-a {
    padding: 2px 24px 16px;
    font-size: 14px; line-height: 19px; color: var(--text-light);
  }
  .fq-item[open] .fq-a { animation: fq-in .3s var(--ease); }
  @keyframes fq-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

  @media (min-width: 641px) {
    .fq-inner { padding: clamp(48px, 5.56vw, 80px) var(--pad); }
    .fq-title { font-size: clamp(40px, 3.889vw, 56px); letter-spacing: -0.0207em; }
    .fq-item summary { padding-inline: 22px; }
    .fq-a { padding-inline: 22px; }
  }
  @media (min-width: 1000px) {
    .fq-item summary { padding-block: 15px; }
    .fq-item[open] summary { padding-bottom: 6px; }
    .fq-a { padding-top: 0; padding-bottom: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fq-item[open] .fq-a { animation: none; }
    .fq-chevron { transition: none; }
  }
</style>
