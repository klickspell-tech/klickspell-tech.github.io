---
// Service detail pages › "Why speed matters" (Figma Speed page, 1440 frame): soft background,
// primary eyebrow, two-line title, three stat cards (primary number, claim, linked source)
// and a centred black pill under them.
interface Stat { value: string; text: string; source: string; href: string }
interface Props {
  eyebrow: string;
  title: string;
  titleEm: string;
  stats: Stat[];
  cta?: { label: string; href: string };
}
const { eyebrow, title, titleEm, stats, cta } = Astro.props;
---

<section class="ss">
  <div class="ss-inner">
    <p class="ss-eyebrow"><span class="ss-rule" aria-hidden="true"></span>{eyebrow}</p>
    <h2 class="ss-title">{title}<br /><em>{titleEm}</em></h2>

    <div class="ss-grid">
      {stats.map((s) => (
        <article class="ss-card">
          <p class="ss-value">{s.value}</p>
          <p class="ss-text">{s.text}</p>
          <p class="ss-source"><a href={s.href} target="_blank" rel="noopener">{s.source}</a></p>
        </article>
      ))}
    </div>

    {cta && <div class="ss-cta"><a href={cta.href} class="ss-btn">{cta.label}</a></div>}
  </div>
</section>

<style>
  .ss { --pad: clamp(24px, 6.25vw, 90px); background: var(--bg-soft); }
  .ss-inner { max-width: 1440px; margin: 0 auto; padding: 40px 20px; }

  .ss-eyebrow { display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 16px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--accent); }
  .ss-rule { display: block; width: 24px; height: 1px; background: var(--accent); }
  .ss-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 9.524vw, 40px); font-weight: 500; line-height: 1.2; letter-spacing: -0.03em;
    color: var(--text); margin-top: 16px;
  }
  .ss-title em { font-style: italic; font-weight: 500; color: var(--text-light); }

  .ss-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 40px; }
  .ss-card {
    display: flex; flex-direction: column; align-items: flex-start;
    padding: 20px; background: var(--white);
    border: 1px solid var(--line); border-radius: 12px;
  }
  .ss-value { font-family: var(--font-display); font-size: 40px; font-weight: 600; line-height: 50px; letter-spacing: -0.01em; color: var(--accent); }
  .ss-text { margin-top: 16px; font-size: 16px; line-height: 22px; color: var(--text); }
  .ss-source { margin-top: 24px; padding: 10px; background: #F5F7FD; font-size: 16px; font-weight: 600; line-height: 22px; align-self: stretch; }
  .ss-source a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .ss-source a:hover { color: var(--accent-hover); }
  .ss-source a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

  .ss-cta { display: flex; justify-content: center; margin-top: 40px; }
  .ss-btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 56px; padding: 0 16px; border-radius: 100px;
    background: var(--text); color: var(--white);
    font-size: 16px; font-weight: 500; line-height: normal; text-decoration: none; white-space: nowrap;
    transition: background .25s var(--ease), transform .2s var(--ease), box-shadow .25s var(--ease);
  }
  .ss-btn:hover { background: #2A2A28; transform: translateY(-2px); box-shadow: 0 10px 24px rgba(20,20,18,0.2); }
  .ss-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (min-width: 641px) {
    .ss-inner { padding: clamp(56px, 5.56vw, 80px) var(--pad); }
    .ss-title { font-size: clamp(40px, 3.889vw, 56px); letter-spacing: -0.0207em; }
    .ss-grid { margin-top: 40px; }
    .ss-cta { margin-top: 40px; }
  }
  @media (min-width: 900px) {
    .ss-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .ss-text { margin-bottom: 16px; }
    .ss-source { margin-top: 0; }
    /* number / claim / source rows line up across the three cards, as in the design */
    @supports (grid-template-rows: subgrid) {
      .ss-grid { grid-template-rows: auto auto auto; row-gap: 0; }
      .ss-card { display: grid; grid-row: span 3; grid-template-rows: subgrid; align-content: start; }
      .ss-text { margin-top: 16px; }
      .ss-source { align-self: start; }
    }
  }
  @media (prefers-reduced-motion: reduce) { .ss-btn, .ss-btn:hover { transition: none; transform: none; } }
</style>
