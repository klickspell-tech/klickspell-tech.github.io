---
// Figma: klickspell › Get in touch (desktop 85:832, mobile 135:818)
// The form keeps the ids/names the submit script in pages/index.astro relies on.
const art = '/assets/contact';

// 12 columns x 8 rows = 96 interactive grid boxes
// Accent pre-filled boxes matching the original Figma composition
const accentIndices = new Set([24, 31, 37, 39, 66]);
const gridCells = Array.from({ length: 96 });
---

<section id="contact" class="ct">
  <div class="ct-stage">
    <div class="ct-head">
      <p class="ct-eyebrow"><span class="ct-rule" aria-hidden="true"></span>Get in Touch</p>
      <h2 class="ct-title">Have a project <em>in mind?</em></h2>
      <p class="ct-sub">Send a few details and we'll get back within one business day — or book a call directly below.</p>
    </div>

    <form id="contactForm" class="ct-card">
      <div class="ct-fields">
        <div class="ct-row">
          <div class="ct-field">
            <label for="contactName">Name</label>
            <input type="text" id="contactName" name="first_name" placeholder="Jane" autocomplete="name" required />
          </div>
          <div class="ct-field">
            <label for="contactEmail">Email</label>
            <input type="email" id="contactEmail" name="email" placeholder="abc@xyz.com" autocomplete="email" required />
          </div>
        </div>
        <div class="ct-stack">
          <div class="ct-field">
            <label for="contactOrg">Company</label>
            <input type="text" id="contactOrg" name="organization" placeholder="*Optional" autocomplete="organization" />
          </div>
          <div class="ct-field">
            <label for="contactMessage">Tell us about your project</label>
            <textarea id="contactMessage" name="message" placeholder="Type here" rows="1"></textarea>
          </div>
        </div>
      </div>
      <input type="text" id="contactCompanyUrl" name="company_url" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" id="contactSubmitBtn" class="ct-send">
        <span id="contactBtnText">Send Message →</span>
        <span id="contactBtnSpinner" class="scanner-spinner" style="display:none;"></span>
      </button>
      <div id="contactSuccess" class="video-audit-success" style="display:none;">Thanks — we'll be in touch within one business day.</div>
      <div id="contactErrorBox" class="contact-error" style="display:none;">Something went wrong. Please try WhatsApp or email instead.</div>
    </form>

    <div class="ct-art" aria-hidden="true">
      <div class="ct-grid" id="ctGrid">
        {gridCells.map((_, i) => (
          <div
            class={`ct-grid-cell${accentIndices.has(i) ? ' is-accent' : ''}`}
            data-index={i}
          />
        ))}
      </div>
      <div class="ct-illu">
        <img src={`${art}/illustration.webp`} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Interactive grid touch trail for mobile & tablet screens
  (function() {
    const grid = document.getElementById('ctGrid');
    if (!grid) return;
    let activeCell = null;
    let clearTimer = null;

    function lightCell(cell) {
      if (!cell || cell === activeCell) return;
      if (activeCell) activeCell.classList.remove('is-lit');
      activeCell = cell;
      cell.classList.add('is-lit');
      clearTimeout(clearTimer);
      clearTimer = setTimeout(function() {
        if (activeCell) {
          activeCell.classList.remove('is-lit');
          activeCell = null;
        }
      }, 700);
    }

    grid.addEventListener('touchstart', function(e) {
      const t = e.touches[0];
      if (!t) return;
      const el = document.elementFromPoint(t.clientX, t.clientY);
      const cell = el ? el.closest('.ct-grid-cell') : null;
      if (cell) lightCell(cell);
    }, { passive: true });

    grid.addEventListener('touchmove', function(e) {
      const t = e.touches[0];
      if (!t) return;
      const el = document.elementFromPoint(t.clientX, t.clientY);
      const cell = el ? el.closest('.ct-grid-cell') : null;
      if (cell) lightCell(cell);
    }, { passive: true });

    grid.addEventListener('touchend', function() {
      clearTimeout(clearTimer);
      clearTimer = setTimeout(function() {
        if (activeCell) {
          activeCell.classList.remove('is-lit');
          activeCell = null;
        }
      }, 500);
    }, { passive: true });
  })();

  // The message box is one line tall like the Figma, then grows as people type.
  (function() {
    const msg = document.getElementById('contactMessage');
    if (msg && !CSS.supports('field-sizing', 'content')) {
      const grow = function() {
        msg.style.height = 'auto';
        msg.style.height = Math.min(msg.scrollHeight + 2, 220) + 'px';
      };
      msg.addEventListener('input', grow);
    }
  })();
</script>

<style>
  /* --u scales the Figma geometry: 1 unit = 1px on the design frame
     (420px frame below 1200px, 1440px frame from 1200px up). */
  .ct {
    --u: min(calc(100vw / 420), 1.34px);
    position: relative;
    overflow: hidden;
    background: var(--white);
  }
  .ct::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: calc(100% - 208 * var(--u)); /* blue band; the last 208 units of the frame are white */
    background: var(--accent);
  }
  .ct-stage {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 20px calc(46 * var(--u));
    display: flex;
    flex-direction: column;
  }

  /* Heading */
  .ct-head {
    position: relative;
    z-index: 2;
    max-width: 810px;
    pointer-events: none;
  }
  .ct-head * {
    pointer-events: none;
  }
  .ct-eyebrow {
    display: flex; align-items: center; gap: 8px;
    font-size: 12px; line-height: 16px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--white);
  }
  .ct-rule { display: block; width: 24px; height: 1px; background: var(--white); }
  .ct-title {
    font-family: var(--font-display);
    font-size: 40px; font-weight: 500; line-height: 1.2;
    letter-spacing: -1.16px;
    color: var(--white);
    margin: 16px 0 20px;
  }
  .ct-title em { font-style: italic; font-weight: 500; }
  .ct-sub { font-size: 16px; line-height: 1.5; color: var(--white); max-width: 572px; }

  /* Form card */
  .ct-card {
    position: relative; z-index: 2;
    margin-top: 34px;
    width: 100%; max-width: 585px;
    padding: 20px 40px;
    background: var(--bg);
    border-radius: 12px;
  }
  .ct-fields { display: flex; flex-direction: column; gap: 14px; }
  .ct-row { display: flex; gap: 12px; }
  .ct-row .ct-field { flex: 1 1 0; min-width: 0; }
  .ct-stack { display: flex; flex-direction: column; gap: 12px; }
  .ct-field { display: flex; flex-direction: column; gap: 8px; }
  .ct-field label { font-size: 12px; font-weight: 500; line-height: 16.4px; color: var(--text); }
  .ct-field input, .ct-field textarea {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    font-family: inherit; font-size: 14px; font-weight: 400; line-height: 20px;
    color: var(--text);
    outline: none;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .ct-field textarea { height: auto; padding: 13px 14px; resize: none; min-height: 48px; max-height: 220px; field-sizing: content; overflow-y: auto; }
  .ct-field input::placeholder, .ct-field textarea::placeholder { color: var(--text-light); opacity: 1; }
  .ct-field input:focus, .ct-field textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-light); }

  .ct-send {
    margin-top: 40px;
    display: inline-flex; align-items: center; justify-content: center;
    height: 40px; padding: 8px 20px;
    border: 0; border-radius: 100px;
    background: var(--text); color: var(--white);
    font-family: inherit; font-size: 12px; font-weight: 500; line-height: normal;
    cursor: pointer; white-space: nowrap;
    transition: background .25s var(--ease), transform .2s var(--ease);
  }
  .ct-send:hover { background: #2A2A28; transform: translateY(-1px); }
  .ct-send:disabled { opacity: .7; cursor: progress; transform: none; }
  .ct-send:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .ct-card :global(.video-audit-success), .ct-card :global(.contact-error) { margin-top: 16px; }

  /* Artwork: interactive translucent grid + 3D illustration */
  .ct-art {
    position: relative;
    z-index: 1;
    width: calc(100% + 40px);
    max-width: calc(420 * var(--u));
    height: calc(400 * var(--u));
    margin: 0 -20px; /* bleed out of the page padding to the screen edges */
    pointer-events: none;
  }
  .ct-grid {
    position: absolute; left: 0; top: 0;
    width: calc(436.458 * var(--u)); height: calc(300.188 * var(--u));
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(8, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    pointer-events: auto;
    z-index: 1;
  }
  .ct-grid-cell {
    position: relative;
    box-sizing: border-box;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: transparent;
    pointer-events: auto;
    cursor: default;
    border-radius: 0;
    transform: scale(1);
    z-index: 1;
    transition: 
      background 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.8s ease,
      transform 0.6s ease,
      border-radius 0.6s ease;
  }

  /* Accent pre-filled cells matching original composition */
  .ct-grid-cell.is-accent {
    background: rgba(255, 255, 255, 0.14);
    animation: ctBoxBreathe 6s ease-in-out infinite;
  }
  .ct-grid-cell.is-accent:nth-child(even) {
    animation-delay: 3s;
  }

  @keyframes ctBoxBreathe {
    0%, 100% {
      background: rgba(255, 255, 255, 0.08);
      box-shadow: none;
    }
    50% {
      background: rgba(255, 255, 255, 0.22);
      box-shadow: inset 0 0 10px rgba(255, 255, 255, 0.2);
    }
  }

  /* Interactive white box hover animation */
  .ct-grid-cell:hover,
  .ct-grid-cell.is-lit {
    background: rgba(255, 255, 255, 0.94) !important;
    border-color: rgba(255, 255, 255, 1) !important;
    border-radius: 4px;
    box-shadow: 
      0 0 20px rgba(255, 255, 255, 0.9),
      0 0 40px rgba(255, 255, 255, 0.5),
      inset 0 0 12px #ffffff !important;
    transform: scale(1.05);
    z-index: 10;
    animation: none !important;
    transition: 
      background 0.03s ease,
      box-shadow 0.03s ease,
      border-color 0.03s ease,
      transform 0.03s ease,
      border-radius 0.03s ease;
  }

  .ct-illu {
    position: absolute; left: 0; top: calc(77 * var(--u));
    width: calc(418.764 * var(--u)); height: calc(323 * var(--u));
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
  }
  .ct-illu img {
    position: absolute; top: 0; left: -19.07%;
    width: 119.07%; height: 102.91%; max-width: none;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Narrow phones: stack the Name / Email fields */
  @media (max-width: 379px) {
    .ct-card { padding: 20px 24px; }
    .ct-row { flex-direction: column; gap: 14px; }
  }

  /* Tablet: art sits centred under the card */
  @media (min-width: 641px) {
    .ct-stage { padding-inline: clamp(32px, 6.25vw, 90px); }
    .ct-title { font-size: 48px; }
    .ct-sub { font-size: 18px; }
    .ct-art { width: calc(420 * var(--u)); margin-left: auto; margin-right: auto; }
  }

  /* Desktop: the 1440px Figma frame, everything scaled by --u */
  @media (min-width: 1200px) {
    .ct { --u: min(1px, calc(100vw / 1440)); }
    .ct::before { height: calc(568 * var(--u)); }
    .ct-stage { height: calc(808 * var(--u)); padding: 0; display: block; }
    .ct-head { position: absolute; left: calc(90 * var(--u)); top: calc(80 * var(--u)); width: calc(810 * var(--u)); max-width: none; }
    .ct-title { font-size: max(40px, calc(56 * var(--u))); letter-spacing: -0.0207em; margin: 16px 0 16px; }
    .ct-sub { font-size: max(16px, calc(20 * var(--u))); color: rgba(255,255,255,0.7); max-width: calc(572 * var(--u)); }
    .ct-card { position: absolute; left: calc(90 * var(--u)); top: calc(331 * var(--u)); width: calc(585 * var(--u)); max-width: none; margin: 0; }
    .ct-art { position: absolute; inset: 0; width: auto; max-width: none; height: auto; margin: 0; }
    .ct-grid {
      left: calc(697 * var(--u)); top: calc(171 * var(--u));
      width: calc(678.813 * var(--u)); height: calc(466.876 * var(--u));
    }
    .ct-illu { left: calc(789 * var(--u)); top: calc(295 * var(--u)); width: calc(561.454 * var(--u)); height: calc(433.059 * var(--u)); }
  }
</style>
