---
// Services page › "Interactive Studio Tools" (from the Figma screenshot): heading + two tool
// cards on a soft panel. Links go to the existing calculators.
const tools = [
  {
    title: 'Shopify App & Speed Estimator',
    text: 'Select the apps currently installed on your store and see their real impact on JavaScript payload, main-thread blocking time, and conversion rate.',
    href: '/speed', cta: 'Launch Speed Estimator →', primary: true,
  },
  {
    title: 'Checkout Architecture Quiz',
    text: "Answer 5 quick questions about your store's average order value, payment gateways, and COD ratios to receive a custom checkout recommendation.",
    href: '/checkout-quiz', cta: 'Take Checkout Quiz', primary: false,
  },
];
---

<section class="st" id="tools">
  <div class="st-inner">
    <p class="st-eyebrow"><span class="st-rule" aria-hidden="true"></span>Interactive Studio Tools</p>
    <h2 class="st-title">Free calculators built by<br /><em>our engineers.</em></h2>
    <p class="st-sub">Audit your Shopify speed overhead or find the ideal checkout flow in under 2 minutes.</p>

    <div class="st-panel">
      {tools.map((t) => (
        <article class="st-card">
          <span class="st-badge">Free Estimator</span>
          <h3 class="st-name">{t.title}</h3>
          <p class="st-text">{t.text}</p>
          <a href={t.href} class={`st-btn ${t.primary ? 'st-btn-primary' : 'st-btn-outline'}`}>{t.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .st { --pad: clamp(24px, 6.25vw, 90px); background: var(--white); }
  .st-inner { max-width: 1440px; margin: 0 auto; padding: 48px 20px; }

  .st-eyebrow { display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 16px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--accent); }
  .st-rule { display: block; width: 24px; height: 1px; background: var(--accent); }
  .st-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 9.524vw, 40px); font-weight: 500; line-height: 1.2; letter-spacing: -1.16px;
    color: var(--text); margin: 16px 0 16px;
  }
  .st-title em { font-style: italic; font-weight: 500; color: var(--text-light); }
  @media (max-width: 640px) { .st-title br { display: none; } }
  .st-sub { font-size: 16px; line-height: 1.5; color: var(--text-light); max-width: 680px; }

  .st-panel {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px;
    margin: 32px -20px 0; padding: 32px 20px;
    background: var(--bg-soft);
  }
  .st-card {
    display: flex; flex-direction: column; align-items: flex-start;
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 10px 28px -12px rgba(20,20,18,0.18);
    transition: transform .25s var(--ease), box-shadow .25s var(--ease);
  }
  .st-card:hover { transform: translateY(-3px); box-shadow: 0 18px 36px -14px rgba(20,20,18,0.24); }
  .st-badge { display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border-radius: 100px; background: var(--accent-light); color: var(--accent); font-size: 12px; font-weight: 500; }
  .st-name { margin-top: 24px; font-family: var(--font-display); font-size: 24px; font-weight: 500; line-height: 30px; color: var(--text); }
  .st-text { margin-top: 14px; font-size: 16px; line-height: 1.5; color: var(--text-light); }
  .st-btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 54px; margin-top: 28px; padding: 0 18px; border-radius: 100px;
    font-size: 16px; font-weight: 500; line-height: normal; text-decoration: none; white-space: nowrap;
    transition: background .25s var(--ease), transform .2s var(--ease), box-shadow .25s var(--ease);
  }
  .st-btn-primary { background: var(--accent); color: var(--white); }
  .st-btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 8px 20px rgba(58,91,224,0.3); }
  .st-btn-outline { color: var(--accent); border: 1px solid var(--accent); }
  .st-btn-outline:hover { background: var(--accent-light); }
  .st-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (min-width: 641px) {
    .st-inner { padding: clamp(56px, 5.56vw, 80px) var(--pad); }
    .st-title { font-size: clamp(40px, 3.889vw, 56px); letter-spacing: -0.0207em; }
    .st-sub { font-size: clamp(16px, 1.25vw, 18px); }
    .st-panel { margin: 56px 0 0; padding: clamp(32px, 5.56vw, 80px) clamp(24px, 2.78vw, 40px); border-radius: 4px; }
  }
  @media (min-width: 900px) {
    .st-panel { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  }
  @media (prefers-reduced-motion: reduce) { .st-card, .st-card:hover, .st-btn, .st-btn:hover { transition: none; transform: none; } }
</style>
