---
// Service page hero, from the desktop + mobile screenshots of the Figma frame.
// Artwork: public/assets/Service Page/futuristic-blue-lg.webp (desktop) and
// futuristic-blue-sm.webp (mobile), rendered from the Figma SVG exports (PNG inside, ~1.9 MB each). The folder name has a space, so the URLs are encoded.
const art = '/assets/Service%20Page';
const stats = [
  { label: 'Mobile Performance', value: '90/100', note: 'Target agreed in writing after a free audit.' },
  { label: 'Team Autonomy', value: '100%', note: 'Visual customization, zero code.' },
  { label: 'Page-Builder Apps', value: '0 Apps', note: 'No PageFly or Shogun. Save on SaaS fees.' },
  { label: 'Client Handover', value: 'Full Git', note: 'Clean repo, Loom guides & admin control.' },
];
---

<header class="sv">
  <div class="sv-inner">
    <p class="sv-crumb"><a href="/">Home</a> / Services &amp; Capabilities</p>

    <div class="sv-top">
      <div class="sv-copy">
        <h1 class="sv-title">Built for your<br />vision, not<br /><em>our convenience.</em></h1>
        <p class="sv-sub">We build custom Shopify stores, headless commerce and business web apps. You own every line of code, your team edits everything without a developer, and there's no agency lock-in.</p>
        <div class="sv-actions">
          <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="sv-btn sv-btn-primary" style="cursor:pointer">Free Scoping Call →</a>
          <a href="#services-list" class="sv-btn sv-btn-outline">See Service →</a>
        </div>
        <p class="sv-note">30 minutes with our lead engineer. Honest advice, no pitch deck.</p>
      </div>

      <picture class="sv-art" aria-hidden="true">
        <source media="(max-width: 900px)" srcset={`${art}/futuristic-blue-sm.webp`} width="380" height="290" />
        <img src={`${art}/futuristic-blue-lg.webp`} alt="" width="471" height="360" fetchpriority="high" decoding="async" />
      </picture>
    </div>

    <div class="sv-strip">
      <p class="sv-strip-label"><span>What every project comes with</span></p>
      <div class="sv-stats">
        {stats.map((s) => (
          <div class="sv-stat">
            <p class="sv-stat-label">{s.label}</p>
            <p class="sv-stat-value">{s.value}</p>
            <p class="sv-stat-note">{s.note}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  .sv { --pad: clamp(24px, 6.25vw, 90px); position: relative; overflow: hidden; background: var(--bg); }
  .sv-inner { position: relative; max-width: 1440px; margin: 0 auto; padding: 112px 20px 40px; }

  .sv-crumb { position: absolute; top: 84px; left: 20px; font-size: 12px; line-height: 16px; color: var(--text-light); }
  .sv-crumb a { color: inherit; text-decoration: none; }
  .sv-crumb a:hover { color: var(--accent); }

  .sv-top { position: relative; }
  .sv-copy { position: relative; z-index: 1; max-width: 690px; }
  .sv-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 9.524vw, 40px); font-weight: 500; line-height: 1.3; letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 20px;
  }
  .sv-title em { font-style: italic; font-weight: 500; color: var(--text-light); }
  .sv-sub { font-size: 16px; line-height: 1.5; color: var(--text-light); margin-bottom: 32px; }

  .sv-actions { display: flex; align-items: center; gap: 13px; }
  .sv-btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 56px; padding: 13px 16px; border-radius: 100px;
    font-size: 16px; font-weight: 500; line-height: normal; text-decoration: none; white-space: nowrap;
    transition: background .25s var(--ease), transform .2s var(--ease), box-shadow .25s var(--ease);
  }
  .sv-btn-primary { background: var(--accent); color: var(--white); }
  .sv-btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(58,91,224,0.3); }
  .sv-btn-outline { color: var(--accent); font-weight: 600; border: 1px solid var(--accent); }
  .sv-btn-outline:hover { background: var(--accent-light); transform: translateY(-1px); }
  .sv-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .sv-note { margin-top: 16px; font-size: 12px; line-height: 16px; color: var(--text-light); }

  /* Mobile: artwork sits under the copy, full width */
  .sv-art { display: block; margin-top: 40px; }
  .sv-art img { display: block; width: 100%; max-width: 420px; height: auto; margin: 0 auto; }

  /* Stats strip */
  .sv-strip { margin-top: 40px; max-width: 1209px; }
  .sv-strip-label {
    display: flex; align-items: center; gap: 16px;
    font-size: 12px; font-weight: 600; line-height: 16px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text);
  }
  .sv-strip-label::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  /* phones: one swipeable row (the Figma mobile frame cuts the second stat off at the edge) */
  .sv-stats {
    display: flex; gap: 24px; margin: 24px -20px 0; padding: 0 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; scrollbar-width: none;
  }
  .sv-stats::-webkit-scrollbar { display: none; }
  .sv-stat { flex: 0 0 236px; scroll-snap-align: start; }
  .sv-stat-label { font-size: 14px; font-weight: 500; line-height: 20px; color: var(--text); }
  .sv-stat-value { margin-top: 8px; font-family: var(--font-display); font-size: 22px; font-weight: 500; line-height: 28px; color: var(--text); }
  .sv-stat-note { margin-top: 6px; font-size: 12px; line-height: 16px; color: var(--text-light); }

  /* Phones: both buttons share the row; the note is centred under them */
  @media (max-width: 640px) {
    .sv-actions .sv-btn { flex: 1 1 0; min-width: 0; padding-inline: 10px; }
    .sv-note { text-align: center; }
  }
  @media (max-width: 359px) {
    .sv-actions { flex-direction: column; align-items: stretch; }
  }

  @media (min-width: 641px) {
    .sv-inner { padding: 150px var(--pad) 56px; }
    .sv-crumb { top: 100px; left: var(--pad); }
    .sv-title { font-size: clamp(44px, 4.17vw, 60px); }
    .sv-sub { font-size: clamp(17px, 1.39vw, 20px); margin-bottom: 40px; }
    .sv-strip { margin-top: 64px; }
    .sv-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 28px 0 0; padding: 0; overflow: visible; }
  }
  /* Desktop: copy left, artwork right */
  @media (min-width: 1000px) {
    .sv-inner { padding-top: 176px; padding-bottom: 60px; }
    .sv-crumb { top: 112px; }
    .sv-copy { max-width: min(690px, 50vw); } /* keeps the copy clear of the artwork on mid-size screens */
    .sv-art { position: absolute; right: clamp(0px, 3.5vw, 50px); top: 52px; margin: 0; width: clamp(340px, 32.7vw, 471px); pointer-events: none; }
    .sv-art img { max-width: none; }
    .sv-strip { margin-top: 110px; }
    .sv-stats { grid-template-columns: repeat(4, minmax(0, 265px)); gap: 24px; } /* columns ~289px apart */
  }
  @media (prefers-reduced-motion: reduce) { .sv-btn, .sv-btn:hover { transition: none; transform: none; } }
</style>
