---
// Hero for the individual service pages (/services/*), from the Custom Shopify Themes
// desktop + mobile screenshots: breadcrumb, title, copy, two buttons, artwork on the right
// (under the buttons on phones) and the "What every project comes with" stats strip.
interface Stat { label: string; value: string; note: string }
interface Props {
  crumb: string;
  title: string;
  sub: string;
  primary: { label: string; href?: string };
  secondary: { label: string; href: string };
  art?: { lg: string; lgW: number; lgH: number; sm: string; smW: number; smH: number };
  stats: Stat[];
  /** optional max width (px) of the copy column, when a design wraps the copy narrower */
  copyMax?: number;
  /** desktop artwork placement: centred on the copy (default) or top-aligned with the title,
   *  at its natural width (lgW), as in the Speed page Figma */
  artAlign?: 'center' | 'top';
  /** phones: space above and below the artwork in px (the mobile designs differ per page; default 56 / 56) */
  artGapSm?: [number, number];
}
const { crumb, title, sub, primary, secondary, art, stats, copyMax, artAlign = 'center', artGapSm } = Astro.props;
const vars = [
  copyMax ? `--copy-max: ${copyMax}px` : '',
  art ? `--art-w: ${art.lgW}px` : '',
  artGapSm ? `--art-mt: ${artGapSm[0]}px; --art-mb: ${artGapSm[1]}px` : '',
].filter(Boolean).join('; ') || undefined;
---

<header class:list={['sd', { 'art-top': artAlign === 'top' }]} style={vars}>
  <div class="sd-inner">
    <div class="sd-crumb" role="navigation" aria-label="Breadcrumb">
      <a href="/services">Service</a>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span aria-current="page">{crumb}</span>
    </div>

    <div class="sd-top">
      <div class="sd-copy">
        <h1 class="sd-title" set:html={title} />
        <p class="sd-sub">{sub}</p>
        <div class="sd-actions">
          {primary.href
            ? <a href={primary.href} class="sd-btn sd-btn-primary">{primary.label}</a>
            : <a href="https://cal.com/atul-bhatt-klickspell/30min" data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="sd-btn sd-btn-primary" style="cursor:pointer">{primary.label}</a>}
          <a href={secondary.href} class="sd-btn sd-btn-outline">{secondary.label}</a>
        </div>
      </div>

      {art && (
        <picture class="sd-art" aria-hidden="true">
          <source media="(max-width: 999px)" srcset={art.sm} width={art.smW} height={art.smH} />
          <img src={art.lg} alt="" width={art.lgW} height={art.lgH} fetchpriority="high" decoding="async" />
        </picture>
      )}
    </div>

    <div class="sd-strip">
      <p class="sd-strip-label"><span>What every project comes with</span></p>
      <div class="sd-stats">
        {stats.map((s) => (
          <div class="sd-stat">
            <p class="sd-stat-label">{s.label}</p>
            <p class="sd-stat-value">{s.value}</p>
            <p class="sd-stat-note">{s.note}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  .sd { --pad: clamp(24px, 6.25vw, 90px); position: relative; overflow: hidden; background: var(--bg); }
  .sd-inner { position: relative; max-width: 1440px; margin: 0 auto; padding: 92px 20px 40px; }

  .sd-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; font-size: 16px; line-height: 24px; color: var(--text-light); }
  @media (max-width: 359px) { .sd-crumb { font-size: 14px; } }
  .sd-crumb a { color: var(--text); font-weight: 500; text-decoration: none; }
  .sd-crumb a:hover { color: var(--accent); }
  .sd-crumb svg { flex: none; color: var(--text); }

  .sd-top { position: relative; margin-top: 24px; }
  .sd-copy { position: relative; z-index: 1; max-width: var(--copy-max, 640px); }
  .sd-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 9.524vw, 40px); font-weight: 500; line-height: 1.25; letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 20px;
    max-width: 343px; /* the Figma mobile title box: wraps to three lines on a 420px phone */
  }
  .sd-sub { font-size: 16px; line-height: 1.5; color: var(--text-light); margin-bottom: 40px; }

  .sd-actions { display: flex; flex-direction: column; align-items: stretch; gap: 13px; }
  .sd-btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 56px; padding: 13px 20px; border-radius: 100px;
    font-size: 16px; font-weight: 500; line-height: normal; text-decoration: none; white-space: nowrap;
    transition: background .25s var(--ease), transform .2s var(--ease), box-shadow .25s var(--ease);
  }
  .sd-btn-primary { background: var(--accent); color: var(--white); }
  .sd-btn-primary:hover { background: var(--accent-hover); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(58,91,224,0.3); }
  .sd-btn-outline { color: var(--accent); border: 1px solid var(--accent); }
  .sd-btn-outline:hover { background: var(--accent-light); transform: translateY(-1px); }
  .sd-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* Phones/tablets: artwork under the buttons */
  .sd-art { display: block; margin-top: var(--art-mt, 56px); }
  .sd-art img { display: block; width: 100%; max-width: 380px; height: auto; margin: 0 auto; }

  /* Stats strip */
  .sd-strip { margin-top: var(--art-mb, 56px); max-width: 1209px; }
  .sd-strip-label {
    display: flex; align-items: center; gap: 16px;
    font-size: 14px; font-weight: 600; line-height: 19px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--text);
  }
  .sd-strip-label::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  /* phones: one swipeable row */
  .sd-stats {
    display: flex; gap: 64px; margin: 24px -20px 0; padding: 0 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 20px; scrollbar-width: none;
  }
  .sd-stats::-webkit-scrollbar { display: none; }
  .sd-stat { flex: 0 0 225px; scroll-snap-align: start; }
  .sd-stat-label { font-size: 14px; font-weight: 500; line-height: 19px; color: var(--text); }
  .sd-stat-value { margin-top: 8px; font-family: var(--font-display); font-size: 24px; font-weight: 500; line-height: 33px; color: var(--text); }
  .sd-stat-note { margin-top: 4px; font-size: 12px; line-height: 16px; color: var(--text-light); }
  @media (max-width: 640px) { .sd-stat-note { white-space: nowrap; } } /* one line in the swipe row, as in Figma */

  @media (min-width: 641px) {
    .sd-inner { padding: 112px var(--pad) 56px; }
    .sd-top { margin-top: 48px; }
    .sd-title { font-size: clamp(44px, 4.44vw, 64px); max-width: none; }
    .sd-sub { font-size: clamp(17px, 1.39vw, 20px); margin-bottom: 40px; }
    .sd-actions { flex-direction: row; align-items: center; gap: 13px; }
    .sd-btn-primary { padding-inline: 48px; }
    .sd-btn-outline { padding-inline: 17px; }
    .sd-art { margin-top: 56px; }
    .sd-art img { max-width: 420px; }
    .sd-strip { margin-top: 64px; }
    /* tablets: 2 x 2, desktop overrides to one row of four */
    .sd-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 40px; margin: 32px 0 0; padding: 0; overflow: visible; }
  }
  /* Desktop: copy left, artwork right */
  @media (min-width: 1000px) {
    .sd-inner { padding-top: 130px; padding-bottom: 80px; }
    .sd-top { margin-top: 61px; }
    .sd-copy { max-width: min(var(--copy-max, 640px), 50vw); }
    .sd-art { position: absolute; right: clamp(0px, 3.5vw, 50px); top: 50%; translate: 0 -50%; margin: 0; width: clamp(340px, 31.4vw, 452px); pointer-events: none; }
    .sd-art img { max-width: none; }
    /* Speed page: art top-aligned with the title, 16px in from the content edge, natural width */
    .sd.art-top .sd-art { top: 6px; translate: none; right: 16px; width: min(var(--art-w, 588px), calc(100% - min(var(--copy-max, 640px), 50vw) - 24px)); }
    .sd-strip { margin-top: 58px; }
    /* columns sized by content with 64px between them, as in the Figma auto-layout */
    .sd-stats { grid-template-columns: minmax(0, 225px) minmax(0, 225px) minmax(0, 264px) minmax(0, 280px); justify-content: start; row-gap: 0; column-gap: clamp(24px, 4.44vw, 64px); }
  }
  @media (prefers-reduced-motion: reduce) { .sd-btn, .sd-btn:hover { transition: none; transform: none; } }
</style>
