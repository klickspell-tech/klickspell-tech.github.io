---
// Services page › "Core Engineering Capabilities" list (from the Figma screenshot).
// Rows are <details> accordions: the closed row matches the design; the open state reuses the
// existing service descriptions, checklists and links. The "Start with your problem" chips open
// and scroll to the matching service.
type Service = {
  id: string; n: string; title: string; summary: string; time: string; timeNote: string;
  desc: string; features: string[]; link: { href: string; label: string; cal?: boolean };
};
const cal = 'https://cal.com/atul-bhatt-klickspell/30min';
const services: Service[] = [
  {
    id: 'svc-shopify', n: '01', title: 'Custom Shopify Themes', summary: 'Handcrafted Liquid, fully editable in the native customizer.',
    time: '3–6 weeks', timeNote: 'typical',
    desc: 'Bespoke Shopify stores built from approved designs. Handcrafted Liquid architecture, modular Theme Customizer sections your marketing team can edit without code, and high-converting checkout flows.',
    features: ['100% native Theme Customizer controls (no page builders)', 'Sub-second mobile loading with clean semantic Liquid', 'Custom product bundles, slide-out carts & upsells', 'Complete Git handover & non-technical team training'],
    link: { href: '/services/custom-shopify-development', label: 'Explore Custom Shopify Development' },
  },
  {
    id: 'svc-speed', n: '02', title: 'Speed Optimization', summary: 'An agreed 90+ mobile score, or we keep optimizing for free.',
    time: '2–3 weeks', timeNote: 'typical',
    desc: 'We turn slow, app-heavy Shopify stores into sub-second conversion engines. Deep Liquid refactoring, script deferral, critical CSS inlining, and image pipeline tuning without breaking tracking pixels or analytics.',
    features: ['Agreed 90+ mobile target, or we keep optimizing for free', 'Passing Core Web Vitals: fast LCP and near-zero layout shift', 'Zero broken apps, analytics, Klaviyo flows, or ad pixels', 'Comprehensive before/after audit report & ongoing guidance'],
    link: { href: '/services/shopify-speed-optimization', label: 'Explore Speed Optimization' },
  },
  {
    id: 'svc-headless', n: '03', title: 'Headless Commerce', summary: 'Next.js, Medusa.js and Hydrogen for complex stores.',
    time: '6–10 weeks', timeNote: 'typical',
    desc: 'Modular commerce architectures powered by Next.js, Medusa.js, and Shopify Hydrogen. Perfect for brands with complex product configurators, international multi-currency setups, or custom booking flows.',
    features: ['Ultra-fast edge rendering via Cloudflare / Vercel', 'Tailored checkout logic, B2B wholesale pricing & custom APIs', 'Freedom from monolithic SaaS e-commerce constraints'],
    link: { href: '/services/headless-commerce', label: 'Explore Headless Architecture' },
  },
  {
    id: 'svc-retainer', n: '04', title: 'Performance & accessibility retainer', summary: 'Core Web Vitals and WCAG 2.2 monitoring, cancel anytime.',
    time: 'Monthly', timeNote: 'no lock-in',
    desc: 'Continuous technical governance for stores that cannot afford regressions. Monthly real-user Core Web Vitals surveillance, manual screen-reader accessibility audits, and third-party script triage.',
    features: ['Monthly CrUX and lab Core Web Vitals verification', 'WCAG 2.2 AA audits tested with screen readers (NVDA/VoiceOver)', 'Third-party app governance & privacy consent order verification'],
    link: { href: '/services/performance-accessibility-retainer', label: 'Explore Retainers & Pricing' },
  },
  {
    id: 'svc-webflow', n: '05', title: 'Webflow & visual development', summary: 'CMS-driven marketing sites your team can run.',
    time: '2–4 weeks', timeNote: 'typical',
    desc: 'World-class Webflow marketing sites for B2B SaaS, startups, and creative agencies. Dynamic CMS architecture, silky micro-interactions, clean semantic HTML, and rapid time-to-market.',
    features: ['Dynamic CMS collections built for marketing autonomy', 'Lightweight interactions with zero animation stutter', 'SEO-optimized heading structures & clean metadata'],
    link: { href: cal, label: 'Discuss a Webflow project', cal: true },
  },
  {
    id: 'svc-apps', n: '06', title: 'Custom web apps & ERP workflows', summary: 'Frappe apps, client portals and process automation.',
    time: 'Custom scope', timeNote: 'quoted',
    desc: 'Full-stack web applications, custom Frappe & ERPNext business workflow automations, third-party API sync engines, and robust DevOps deployments engineered for operational scaling.',
    features: ['Custom Frappe apps, DocTypes, and business process automations', 'Tailored React/Next.js client portals & dashboards', 'Secure API pipelines & cloud server management'],
    link: { href: cal, label: 'Discuss custom app architecture', cal: true },
  },
];
const problems = [
  { label: 'My store is slow', to: 'svc-speed' },
  { label: 'I need a store', to: 'svc-shopify' },
  { label: "Shopify can't do what I need", to: 'svc-headless' },
  { label: 'I want it to stay fast', to: 'svc-retainer' },
  { label: 'I need custom solutions', to: 'svc-apps' },
];
---

<section class="sc" id="services-list">
  <div class="sc-inner">
    <p class="sc-eyebrow"><span class="sc-rule" aria-hidden="true"></span>Core Engineering Capabilities</p>
    <h2 class="sc-title">Specialized services for<br /><em>ambitious brands.</em></h2>
    <p class="sc-sub">Open any service to see what's included, who it's for and how long it takes.</p>

    <div class="sc-problems">
      <p class="sc-problems-label">Start with your problem:</p>
      <div class="sc-chips">
        {problems.map((p) => <button type="button" class="sc-chip" data-open={p.to}>{p.label}</button>)}
      </div>
    </div>

    <div class="sc-list">
      {services.map((s) => (
        <details class="sc-item" id={s.id} name="services">
          <summary>
            <span class="sc-num">{s.n}</span>
            <span class="sc-head">
              <span class="sc-name">{s.title}</span>
              <span class="sc-summary">{s.summary}</span>
            </span>
            <span class="sc-time"><strong>{s.time}</strong><span>{s.timeNote}</span></span>
            <svg class="sc-chev" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6.25 8 10.25l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </summary>
          <div class="sc-body">
            <p class="sc-desc">{s.desc}</p>
            <ul class="sc-features">{s.features.map((f) => <li>{f}</li>)}</ul>
            {s.link.cal
              ? <a href={s.link.href} data-cal-link="atul-bhatt-klickspell/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view"}' class="sc-link" style="cursor:pointer">{s.link.label} →</a>
              : <a href={s.link.href} class="sc-link">{s.link.label} →</a>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.sc');
  if (root) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.sc-chip')];
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const target = document.getElementById(chip.dataset.open || '') as HTMLDetailsElement | null;
      if (!target) return;
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      root.querySelectorAll<HTMLDetailsElement>('.sc-item[open]').forEach((d) => { if (d !== target) d.open = false; });
      target.open = true;
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
    }));
  }
</script>

<style>
  .sc { --pad: clamp(24px, 6.25vw, 90px); background: var(--white); scroll-margin-top: 80px; }
  .sc-inner { max-width: 1440px; margin: 0 auto; padding: 48px 20px; }

  .sc-eyebrow { display: flex; align-items: center; gap: 8px; font-size: 12px; line-height: 16px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--accent); }
  .sc-rule { display: block; width: 24px; height: 1px; background: var(--accent); }
  .sc-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 9.524vw, 40px); font-weight: 500; line-height: 1.2; letter-spacing: -1.16px;
    color: var(--text); margin: 16px 0 16px;
  }
  .sc-title em { font-style: italic; font-weight: 500; color: var(--text-light); }
  @media (max-width: 640px) { .sc-title br { display: none; } } /* avoid a lone "for" line on phones */
  .sc-sub { font-size: 16px; line-height: 1.5; color: var(--text-light); }

  /* Problem chips: one swipeable row on phones */
  .sc-problems { margin-top: 32px; }
  .sc-problems-label { font-size: 12px; font-weight: 600; line-height: 16px; color: var(--text); margin-bottom: 12px; }
  .sc-chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 0 -20px; padding: 0 20px; }
  .sc-chips::-webkit-scrollbar { display: none; }
  .sc-chip {
    flex: 0 0 auto; height: 36px; padding: 0 14px;
    border: 1px solid var(--line); border-radius: 100px; background: var(--white);
    font-family: inherit; font-size: 12px; font-weight: 400; color: var(--text); white-space: nowrap; cursor: pointer;
    transition: border-color .2s var(--ease), background .2s var(--ease), color .2s var(--ease);
  }
  .sc-chip:hover { border-color: var(--text); }
  .sc-chip.is-active { background: var(--text); border-color: var(--text); color: var(--white); }
  .sc-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Accordion list */
  .sc-list { margin-top: 32px; border-top: 1px solid var(--line); }
  .sc-item { border-bottom: 1px solid var(--line); scroll-margin-top: 100px; }
  .sc-item summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: 36px minmax(0, 1fr) 16px; grid-template-areas: 'num head chev' '. time .';
    align-items: start; column-gap: 12px; row-gap: 8px;
    padding: 24px 0;
  }
  .sc-item summary::-webkit-details-marker { display: none; }
  .sc-item summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .sc-num { grid-area: num; font-size: 14px; line-height: 22px; color: var(--text); }
  .sc-head { grid-area: head; display: flex; flex-direction: column; gap: 4px; }
  .sc-name { font-family: var(--font-display); font-size: 16px; font-weight: 500; line-height: 22px; color: var(--text); transition: color .2s var(--ease); }
  .sc-summary { font-size: 13px; line-height: 18px; color: var(--text-light); }
  .sc-time { grid-area: time; display: flex; align-items: baseline; gap: 6px; }
  .sc-time strong { font-size: 13px; font-weight: 600; color: var(--text); }
  .sc-time span { font-size: 11px; color: var(--text-light); }
  .sc-chev { grid-area: chev; margin-top: 3px; color: var(--text); transition: transform .3s var(--ease); }
  .sc-item:hover .sc-name { color: var(--accent); }
  .sc-item[open] .sc-chev { transform: rotate(180deg); }

  .sc-body { padding: 0 0 28px 48px; max-width: 820px; }
  .sc-item[open] .sc-body { animation: sc-in .3s var(--ease); }
  @keyframes sc-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .sc-desc { font-size: 15px; line-height: 1.6; color: var(--text-light); }
  .sc-features { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 8px; }
  .sc-features li { position: relative; padding-left: 22px; font-size: 14px; line-height: 20px; color: var(--text); }
  .sc-features li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
  .sc-link { display: inline-block; margin-top: 18px; font-size: 13px; font-weight: 600; color: var(--accent); text-decoration: none; }
  .sc-link:hover { text-decoration: underline; }

  @media (min-width: 641px) {
    .sc-inner { padding: clamp(56px, 5.56vw, 80px) var(--pad); }
    .sc-title { font-size: clamp(40px, 3.889vw, 56px); letter-spacing: -0.0207em; }
    .sc-sub { font-size: clamp(17px, 1.39vw, 20px); }
    .sc-problems { display: flex; align-items: center; gap: 16px; margin-top: 40px; }
    .sc-problems-label { margin: 0; flex-shrink: 0; }
    .sc-chips { flex-wrap: wrap; overflow: visible; margin: 0; padding: 0; }
    .sc-item summary { grid-template-columns: 56px minmax(0, 1fr) auto 24px; grid-template-areas: 'num head time chev'; align-items: center; column-gap: 16px; padding: 30px 0; }
    .sc-num { font-size: 14px; }
    .sc-time { flex-direction: column; align-items: flex-end; gap: 2px; }
    .sc-chev { margin: 0; justify-self: end; }
    .sc-body { padding-left: 72px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-item[open] .sc-body { animation: none; }
    .sc-chev { transition: none; }
  }
</style>
