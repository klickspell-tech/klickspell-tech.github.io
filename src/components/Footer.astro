---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const prefix = isHome ? "" : "/";
---

<footer>
  <div class="footer-inner">
    <span class="footer-logo">Klick<span>spell</span></span>
    <span class="footer-stamp">The craft in every click.</span>
    <ul class="footer-links">
      <li><a href={`${prefix}#services`}>Services</a></li>
      <li><a href={`${prefix}#work`}>Work</a></li>
      <li><a href={`${prefix}#about`}>About</a></li>
      <li><a href="/team">Team</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href={`${prefix}#faq`}>FAQ</a></li>
      <li><a href="https://wa.me/919259598769" target="_blank" rel="noopener">Contact</a></li>
      <li><a href="https://in.linkedin.com/in/mratulbhatt" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href="https://www.youtube.com/playlist?list=PL1p7vprQFvmus468rKCaHoQvHmaHopMyo" target="_blank" rel="noopener">YouTube</a></li>
    </ul>

    <div style="width:100%; display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center; margin-top:1.25rem; padding-top:1.25rem; border-top:.5px solid rgba(255,255,255,0.08); font-size:12px;">
      <span style="color:rgba(255,255,255,0.4); text-transform:uppercase; font-family:'DM Mono',monospace; letter-spacing:.08em;">Services:</span>
      <a href="/services/shopify-speed-optimization" style="color:rgba(255,255,255,0.7); text-decoration:none; transition:color .2s;">Shopify Speed Optimization ↗</a>
      <a href="/services/custom-shopify-development" style="color:rgba(255,255,255,0.7); text-decoration:none; transition:color .2s;">Custom Shopify Themes ↗</a>
      <a href="/services/headless-commerce" style="color:rgba(255,255,255,0.7); text-decoration:none; transition:color .2s;">Headless Commerce ↗</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p class="footer-copy">© 2026 Klickspell · Rudrapur, Uttarakhand, India</p>
    <p class="footer-copy">klickspell.com</p>
  </div>
</footer>
