---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const prefix = isHome ? "" : "/";
---

<footer>
  <div class="footer-inner">
    <span class="footer-logo">Klick<span>spell</span></span>
    <span class="footer-stamp">The craft in every click.</span>
    <ul class="footer-links">
      <li><a href={`${prefix}#services`}>Services</a></li>
      <li><a href={`${prefix}#work`}>Work</a></li>
      <li><a href={`${prefix}#about`}>About</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href={`${prefix}#faq`}>FAQ</a></li>
      <li><a href="https://wa.me/919259598769" target="_blank" rel="noopener">Contact</a></li>
      <li><a href="https://in.linkedin.com/in/mratulbhatt" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href="https://www.youtube.com/playlist?list=PL1p7vprQFvmus468rKCaHoQvHmaHopMyo" target="_blank" rel="noopener">YouTube</a></li>
    </ul>
  </div>
  <div class="footer-bottom">
    <p class="footer-copy">© 2026 Klickspell · Rudrapur, Uttarakhand, India</p>
    <p class="footer-copy">klickspell.com</p>
  </div>
</footer>
